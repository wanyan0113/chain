:AreaStrikeCapability rdf:type owl:NamedIndividual ,
                               :StrikeTargetQuantityCapability ;
                      rdfs:label "范围攻击能力"@zh .


###  http://example.org/killweb#GroundReconCapability
# 定义“GroundReconCapability（地面侦测能力）”规范能力个体，属于“ReconTargetTypeCapability（侦测目标类型能力）”类。
:GroundReconCapability rdf:type owl:NamedIndividual ,
                                :ReconTargetTypeCapability ;
                       :capabilityTargetType "ground" ;
                       rdfs:label "地面侦测能力"@zh .


###  http://example.org/killweb#GroundStrikeCapability
# 定义“GroundStrikeCapability（对地攻击能力）”规范能力个体，属于“StrikeTargetTypeCapability（攻击目标类型能力）”类。
:GroundStrikeCapability rdf:type owl:NamedIndividual ,
                                 :StrikeTargetTypeCapability ;
                        :capabilityTargetType "ground" ;
                        rdfs:label "对地攻击能力"@zh .


###  http://example.org/killweb#HighAltitudeStrikeCapability
# 定义“HighAltitudeStrikeCapability（高空攻击能力）”规范能力个体，属于“StrikeAltitudeCapability（攻击高度能力）”类。
:HighAltitudeStrikeCapability rdf:type owl:NamedIndividual ,
                                       :StrikeAltitudeCapability ;
                              rdfs:label "高空攻击能力"@zh .


###  http://example.org/killweb#InformationRelayCapability
# 定义“InformationRelayCapability（魔法信息中继能力）”规范能力个体，属于“CommunicationCapability（传讯能力）”类。
:InformationRelayCapability rdf:type owl:NamedIndividual ,
                                     :CommunicationCapability ;
                            rdfs:label "魔法信息中继能力"@zh .


###  http://example.org/killweb#LongRangeReconCapability
# 定义“LongRangeReconCapability（远程感知能力）”规范能力个体，属于“ReconRangeCapability（感知距离能力）”类。
:LongRangeReconCapability rdf:type owl:NamedIndividual ,
                                   :ReconRangeCapability ;
                          rdfs:label "远程感知能力"@zh .


###  http://example.org/killweb#LongRangeStrikeCapability
# 定义“LongRangeStrikeCapability（远程攻击能力）”规范能力个体，属于“StrikeRangeCapability（攻击距离能力）”类。
:LongRangeStrikeCapability rdf:type owl:NamedIndividual ,
