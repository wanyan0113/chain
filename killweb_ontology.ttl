@prefix : <http://example.org/killweb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/killweb#> .

<http://example.org/killweb> rdf:type owl:Ontology ;
                              rdfs:comment "西幻魔法背景，中文显示名称采用奥术网、法术链、法器等术语。"@zh ;
                              rdfs:label "奥术网络设计本体"@zh ;
                              rdfs:seeAlso <https://doi.org/10.12382/bgxb.2022.1077> ;
                              owl:versionInfo "0.7" ;
                              rdfs:comment "0.7：补充截图章节溯源、OODA 阶段标注、单位与语义说明，以及规则和公式目录。目录仅用于知识表示，不是可执行规则；具体实例的时序须显式填写。"@zh .

#    Object Properties

###  http://example.org/killweb#capabilitySupportsMission
# 定义“capabilitySupportsMission（支撑战斗任务）”关系，连接CombatCapability（法术能力）与CombatMission（战斗任务）。
:capabilitySupportsMission rdf:type owl:ObjectProperty ;
                           owl:inverseOf :requiresCapability ;
                           rdfs:domain :CombatCapability ;
                           rdfs:range :CombatMission ;
                           rdfs:label "支撑战斗任务"@zh .


###  http://example.org/killweb#chainRelation
# 定义“chainRelation（参与的法阵组合）”关系，连接KillChain（法术链）与ChainRelation（法阵组合关系）。
:chainRelation rdf:type owl:ObjectProperty ;
               owl:inverseOf :relatedChain ;
               rdfs:domain :KillChain ;
               rdfs:range :ChainRelation ;
               rdfs:comment "法术链指向法阵组合关系实例的反向链接，与 relatedChain 互逆。"@zh ;
               rdfs:label "参与的法阵组合"@zh .


###  http://example.org/killweb#chainTarget
# 定义“chainTarget（锁定目标）”关系，连接KillChain（法术链）与Target（敌方目标）。
:chainTarget rdf:type owl:ObjectProperty ;
             rdfs:domain :KillChain ;
             rdfs:range :Target ;
             rdfs:label "锁定目标"@zh .


###  http://example.org/killweb#commandToStrikeCommunication
# 定义“commandToStrikeCommunication（指挥-攻击传讯）”关系，连接CommandControlEquipment（指挥法器）与StrikeEquipment（攻击法器）。
:commandToStrikeCommunication rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :communicatesWith ;
                              rdfs:domain :CommandControlEquipment ;
                              rdfs:range :StrikeEquipment ;
                              rdfs:comment "对应论文图 3 中指挥法器与攻击法器之间的传讯关系。"@zh ;
                              rdfs:label "指挥-攻击传讯"@zh .


###  http://example.org/killweb#commands
# 定义“commands（统御法器）”关系，连接CommandControlEquipment（指挥法器）与WeaponEquipment（法器）。
:commands rdf:type owl:ObjectProperty ;
          rdfs:domain :CommandControlEquipment ;
          rdfs:range :WeaponEquipment ;
          rdfs:label "统御法器"@zh .


###  http://example.org/killweb#communicatesWith
# 定义“communicatesWith（魔法共鸣）”关系，连接WeaponEquipment（法器）与WeaponEquipment（法器）。
:communicatesWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  rdfs:domain :WeaponEquipment ;
                  rdfs:range :WeaponEquipment ;
                  rdfs:label "魔法共鸣"@zh .


###  http://example.org/killweb#constrainedBy
# 定义“constrainedBy（受元素态势约束）”关系，连接CombatCapability（法术能力）与BattlefieldSituation（元素战场态势）。
:constrainedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :situationConstrainsCapability ;
               rdfs:domain :CombatCapability ;
               rdfs:range :BattlefieldSituation ;
               rdfs:comment "图 1 的态势→法术关系；法术能力受当前元素战场态势约束。"@zh ;
               rdfs:label "受元素态势约束"@zh .


###  http://example.org/killweb#containsTarget
# 定义“containsTarget（态势包含目标）”关系，连接BattlefieldSituation（元素战场态势）与Target（敌方目标）。
:containsTarget rdf:type owl:ObjectProperty ;
                rdfs:domain :BattlefieldSituation ;
                rdfs:range :Target ;
                rdfs:label "态势包含目标"@zh .


###  http://example.org/killweb#detects
# 定义“detects（感知目标）”关系，连接ReconEquipment（侦测法器）与Target（敌方目标）。
:detects rdf:type owl:ObjectProperty ;
         rdfs:domain :ReconEquipment ;
         rdfs:range :Target ;
         rdfs:label "感知目标"@zh .


###  http://example.org/killweb#finishStartPrecedes
# 定义“finishStartPrecedes（前置施法完毕）”关系，连接CombatMission（战斗任务）与CombatMission（战斗任务）。
:finishStartPrecedes rdf:type owl:ObjectProperty ;
                     owl:inverseOf :startsAfterCompletionOf ;
                     rdf:type owl:IrreflexiveProperty ;
                     rdfs:domain :CombatMission ;
                     rdfs:range :CombatMission ;
                     rdfs:comment "对应论文图 5：前一环节完成后，后一环节开始。该属性只表达直接时序，不自动计算持续时间。"@zh ;
                     rdfs:label "前置施法完毕"@zh .


###  http://example.org/killweb#fromChain
# 定义“fromChain（起始法术链）”关系，连接ChainRelation（法阵组合关系）与KillChain（法术链）。
:fromChain rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :relatedChain ;
           rdfs:domain :ChainRelation ;
           rdfs:range :KillChain ;
           rdfs:comment "用于串联法阵和分支法阵，表示有向关系的起点。"@zh ;
           rdfs:label "起始法术链"@zh .


###  http://example.org/killweb#hasCapability
# 定义“hasCapability（具备法术）”关系，连接WeaponEquipment（法器）与CombatCapability（法术能力）。
:hasCapability rdf:type owl:ObjectProperty ;
               owl:inverseOf :realizedBy ;
               rdfs:domain :WeaponEquipment ;
               rdfs:range :CombatCapability ;
               rdfs:comment "定义域故意设为 WeaponEquipment：承载平台和挂载物都可以具备法术。若只想让功能单元具备法术，应另建 FunctionalEquipment 子类，而不是依赖注释。"@zh ;
               rdfs:label "具备法术"@zh .


###  http://example.org/killweb#hasChain
# 定义“hasChain（奥术网包含法术链）”关系，连接KillWeb（奥术网）与KillChain（法术链）。
:hasChain rdf:type owl:ObjectProperty ;
          rdfs:domain :KillWeb ;
          rdfs:range :KillChain ;
          rdfs:label "奥术网包含法术链"@zh .


###  http://example.org/killweb#hasChainNode
# 定义“hasChainNode（包含有序法阵节点）”关系，连接KillChain（法术链）与ChainNode（法术链节点）。
:hasChainNode rdf:type owl:ObjectProperty ;
              rdfs:domain :KillChain ;
              rdfs:range :ChainNode ;
              rdfs:comment "法术链成员关系的唯一入口；节点顺序由 nodeOrder 和 nextNode 表达。"@zh ;
              rdfs:label "包含有序法阵节点"@zh .


###  http://example.org/killweb#hasPayload
# 定义“hasPayload（挂载魔晶 / 搭载物）”关系，连接EquipmentPlatform（承载平台）与WeaponEquipment（法器）。
:hasPayload rdf:type owl:ObjectProperty ;
            owl:inverseOf :mountedOn ;
            rdfs:domain :EquipmentPlatform ;
            rdfs:range :WeaponEquipment ;
            rdfs:comment "扩展关系：mountedOn 的逆关系，仅用于可分离的物理挂载物；常驻指挥节点使用 hosts。"@zh ;
            rdfs:label "挂载魔晶 / 搭载物"@zh .


###  http://example.org/killweb#hasRelation
# 定义“hasRelation（包含法阵组合）”关系，连接KillWeb（奥术网）与ChainRelation（法阵组合关系）。
:hasRelation rdf:type owl:ObjectProperty ;
             owl:inverseOf :relationInWeb ;
             rdfs:domain :KillWeb ;
             rdfs:range :ChainRelation ;
             rdfs:label "包含法阵组合"@zh .


###  http://example.org/killweb#hasSituation
# 定义“hasSituation（任务所处环境）”关系，连接CombatMission（战斗任务）与BattlefieldSituation（元素战场态势）。
:hasSituation rdf:type owl:ObjectProperty ;
              rdfs:domain :CombatMission ;
              rdfs:range :BattlefieldSituation ;
              rdfs:comment "图 1 中战斗任务与元素战场态势共同决定所需法术的任务侧入口。"@zh ;
              rdfs:label "任务所处环境"@zh .


###  http://example.org/killweb#hasSubMission
# 定义“hasSubMission（包含子任务）”关系，连接CombatMission（战斗任务）与CombatMission（战斗任务）。
:hasSubMission rdf:type owl:ObjectProperty ;
               rdfs:domain :CombatMission ;
               rdfs:range :CombatMission ;
               rdfs:comment "扩展：战斗任务分解关系。"@zh ;
               rdfs:label "包含子任务"@zh .


###  http://example.org/killweb#hasTarget
# 定义“hasTarget（任务目标）”关系，连接CombatMission（战斗任务）与Target（敌方目标）。
:hasTarget rdf:type owl:ObjectProperty ;
           rdfs:domain :CombatMission ;
           rdfs:range :Target ;
           rdfs:label "任务目标"@zh .


###  http://example.org/killweb#hosts
# 定义“hosts（承载节点）”关系，连接EquipmentPlatform（承载平台）与WeaponEquipment（法器）。
:hosts rdf:type owl:ObjectProperty ;
       rdfs:domain :EquipmentPlatform ;
       rdfs:range :WeaponEquipment ;
       rdfs:comment "扩展关系：承载平台提供常驻或集成节点（如预警魔像上的联合指挥中枢）；不等同于可分离的物理挂载物。"@zh ;
       rdfs:label "承载节点"@zh .


###  http://example.org/killweb#judgmentToDecisionCommunication
# 定义“judgmentToDecisionCommunication（占卜-决断传讯）”关系，连接JudgmentEquipment（占卜法器）与DecisionEquipment（决断法器）。
:judgmentToDecisionCommunication rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :communicatesWith ;
                                 rdfs:domain :JudgmentEquipment ;
                                 rdfs:range :DecisionEquipment ;
                                 rdfs:comment "对应论文图 3 中占卜法器与决断法器之间的传讯关系。"@zh ;
                                 rdfs:label "占卜-决断传讯"@zh .


###  http://example.org/killweb#mountedOn
# 定义“mountedOn（附魔于 / 挂载于）”关系，连接WeaponEquipment（法器）与EquipmentPlatform（承载平台）。
:mountedOn rdf:type owl:ObjectProperty ;
           rdfs:domain :WeaponEquipment ;
           rdfs:range :EquipmentPlatform ;
           rdfs:comment "扩展关系：表示可分离的物理挂载关系，例如探知吊舱、魔晶弹挂架。标签中的“附魔于”仅为该物理挂载关系的背景化称呼，不另行表示赋予魔法效果的过程。"@zh ;
           rdfs:label "附魔于 / 挂载于"@zh .


###  http://example.org/killweb#nextNode
# 定义“nextNode（下一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。
:nextNode rdf:type owl:ObjectProperty ;
          owl:inverseOf :previousNode ;
          rdf:type owl:FunctionalProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :ChainNode ;
          rdfs:range :ChainNode ;
          rdfs:comment "单后继关系。OWL 不能保证后继属于同一条法术链、无环或与 nodeOrder 一致，这些需由 SHACL 或程序校验。"@zh ;
          rdfs:label "下一节点"@zh .


###  http://example.org/killweb#nodeEquipment
# 定义“nodeEquipment（节点法器）”关系，连接ChainNode（法术链节点）与WeaponEquipment（法器）。
:nodeEquipment rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainNode ;
               rdfs:range :WeaponEquipment ;
               rdfs:label "节点法器"@zh .


###  http://example.org/killweb#previousNode
# 定义“previousNode（上一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。
:previousNode rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainNode ;
              rdfs:range :ChainNode ;
              rdfs:label "上一节点"@zh .


###  http://example.org/killweb#realizedBy
# 定义“realizedBy（由法器释放）”关系，连接CombatCapability（法术能力）与WeaponEquipment（法器）。
:realizedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :CombatCapability ;
            rdfs:range :WeaponEquipment ;
            rdfs:label "由法器释放"@zh .


###  http://example.org/killweb#reconToCommandCommunication
# 定义“reconToCommandCommunication（侦测-指挥传讯）”关系，连接ReconEquipment（侦测法器）与CommandControlEquipment（指挥法器）。
:reconToCommandCommunication rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :communicatesWith ;
                             rdfs:domain :ReconEquipment ;
                             rdfs:range :CommandControlEquipment ;
                             rdfs:comment "对应论文图 3 中侦测法器与指挥法器之间的传讯关系。"@zh ;
                             rdfs:label "侦测-指挥传讯"@zh .


###  http://example.org/killweb#relatedChain
# 定义“relatedChain（关联法术链）”关系，连接ChainRelation（法阵组合关系）与KillChain（法术链）。
:relatedChain rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainRelation ;
              rdfs:range :KillChain ;
              rdfs:comment "法阵组合关系实例的参与法术链集合。并列法阵用它列出全部参与者。"@zh ;
              rdfs:label "关联法术链"@zh .


###  http://example.org/killweb#relationInWeb
# 定义“relationInWeb（所属奥术网）”关系，连接ChainRelation（法阵组合关系）与KillWeb（奥术网）。
:relationInWeb rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainRelation ;
               rdfs:range :KillWeb ;
               rdfs:label "所属奥术网"@zh .


###  http://example.org/killweb#requirementConstrainsCapability
# 定义“requirementConstrainsCapability（需求约束法术）”关系，连接OperationalRequirement（施法需求）与CombatCapability（法术能力）。
:requirementConstrainsCapability rdf:type owl:ObjectProperty ;
                                 rdfs:domain :OperationalRequirement ;
                                 rdfs:range :CombatCapability ;
                                 rdfs:comment "图 1 中施法需求参与决定所需法术。"@zh ;
                                 rdfs:label "需求约束法术"@zh .


###  http://example.org/killweb#requirementConstrainsEquipment
# 定义“requirementConstrainsEquipment（需求约束法器）”关系，连接OperationalRequirement（施法需求）与WeaponEquipment（法器）。
:requirementConstrainsEquipment rdf:type owl:ObjectProperty ;
                                rdfs:domain :OperationalRequirement ;
                                rdfs:range :WeaponEquipment ;
                                rdfs:comment "图 1 中施法需求参与决定所需法器；协同关系仍由第二章规则处理。"@zh ;
                                rdfs:label "需求约束法器"@zh .


###  http://example.org/killweb#requirementForMission
# 定义“requirementForMission（面向战斗任务）”关系，连接OperationalRequirement（施法需求）与CombatMission（战斗任务）。
:requirementForMission rdf:type owl:ObjectProperty ;
                       rdfs:domain :OperationalRequirement ;
                       rdfs:range :CombatMission ;
                       rdfs:comment "表 1 将施法需求定义为完成可能担负任务的基本要求；该属性把需求挂到战斗任务上。"@zh ;
                       rdfs:label "面向战斗任务"@zh .


###  http://example.org/killweb#requiresCapability
# 定义“requiresCapability（需要法术）”关系，连接CombatMission（战斗任务）与CombatCapability（法术能力）。
:requiresCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain :CombatMission ;
                    rdfs:range :CombatCapability ;
                    rdfs:label "需要法术"@zh .


###  http://example.org/killweb#satisfiesRequirement
# 定义“satisfiesRequirement（满足施法需求）”关系，连接KillWeb（奥术网）与OperationalRequirement（施法需求）。
:satisfiesRequirement rdf:type owl:ObjectProperty ;
                      rdfs:domain :KillWeb ;
                      rdfs:range :OperationalRequirement ;
                      rdfs:comment "扩展：只表达设计结果与施法需求的关联，不是自动判定满足。"@zh ;
                      rdfs:label "满足施法需求"@zh .


###  http://example.org/killweb#situationConstrainsCapability
# 定义“situationConstrainsCapability（态势约束法术）”关系，连接BattlefieldSituation（元素战场态势）与CombatCapability（法术能力）。
:situationConstrainsCapability rdf:type owl:ObjectProperty ;
                               rdfs:domain :BattlefieldSituation ;
                               rdfs:range :CombatCapability ;
                               rdfs:comment "图 1 的反向读法；与 constrainedBy 互逆。"@zh ;
                               rdfs:label "态势约束法术"@zh .


###  http://example.org/killweb#startsAfterCompletionOf
# 定义“startsAfterCompletionOf（在上一环节结束后启动）”关系，连接CombatMission（战斗任务）与CombatMission（战斗任务）。
:startsAfterCompletionOf rdf:type owl:ObjectProperty ;
                         rdfs:domain :CombatMission ;
                         rdfs:range :CombatMission ;
                         rdfs:label "在上一环节结束后启动"@zh .


###  http://example.org/killweb#supportsMission
# 定义“supportsMission（支撑战斗任务）”关系，连接KillWeb（奥术网）与CombatMission（战斗任务）。
:supportsMission rdf:type owl:ObjectProperty ;
                 rdfs:domain :KillWeb ;
                 rdfs:range :CombatMission ;
                 rdfs:label "支撑战斗任务"@zh .


###  http://example.org/killweb#toChain
# 定义“toChain（目标法术链）”关系，连接ChainRelation（法阵组合关系）与KillChain（法术链）。
:toChain rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :relatedChain ;
         rdfs:domain :ChainRelation ;
         rdfs:range :KillChain ;
         rdfs:comment "用于串联法阵和分支法阵，表示有向关系的终点。"@zh ;
         rdfs:label "目标法术链"@zh .


#    Data properties

###  http://example.org/killweb#altitudeFt
# 定义“altitudeFt（悬浮高度（英尺））”数据属性，记录WeaponEquipment（法器）的悬浮高度（英尺），值类型为 xsd:decimal。
:altitudeFt rdf:type owl:DatatypeProperty ;
            rdfs:domain :WeaponEquipment ;
            rdfs:range xsd:decimal ;
            rdfs:comment "沿用原版装备海拔的参照面和英尺单位；“悬浮高度”为背景化显示名称，不改为相对地面的离地高度，也不限定法器必须处于悬浮状态。"@zh ;
            rdfs:label "悬浮高度（英尺）"@zh .


###  http://example.org/killweb#azimuthCoverageDeg
# 定义“azimuthCoverageDeg（方位感知区（度））”数据属性，记录ReconEquipment（侦测法器）的方位感知区（度），值类型为 xsd:decimal。
:azimuthCoverageDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ReconEquipment ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "方位感知区（度）"@zh .


###  http://example.org/killweb#azimuthResolutionDeg
# 定义“azimuthResolutionDeg（方位角感知误差（度））”数据属性，记录ReconEquipment（侦测法器）的方位角感知误差（度），值类型为 xsd:decimal。
:azimuthResolutionDeg rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ReconEquipment ;
                      rdfs:range xsd:decimal ;
                      rdfs:label "方位角感知误差（度）"@zh .


###  http://example.org/killweb#capabilityDescription
# 定义“capabilityDescription（法术说明）”数据属性，记录CombatCapability（法术能力）的法术说明，值类型为 xsd:string。
:capabilityDescription rdf:type owl:DatatypeProperty ;
                       rdfs:domain :CombatCapability ;
                       rdfs:range xsd:string ;
                       rdfs:label "法术说明"@zh .


###  http://example.org/killweb#capabilityLevel
# 定义“capabilityLevel（法术等级）”数据属性，记录CombatCapability（法术能力）的法术等级，值类型为 xsd:string。
:capabilityLevel rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CombatCapability ;
                 rdfs:range xsd:string ;
                 rdfs:label "法术等级"@zh .


###  http://example.org/killweb#capabilityMaxAltitudeFt
# 定义“capabilityMaxAltitudeFt（法术最高作用高度）”数据属性，记录CombatCapability（法术能力）的法术最高作用高度，值类型为 xsd:decimal。
:capabilityMaxAltitudeFt rdf:type owl:DatatypeProperty ;
                         rdfs:domain :CombatCapability ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "法术最高作用高度"@zh .


###  http://example.org/killweb#capabilityMaxTargets
# 定义“capabilityMaxTargets（法术最大目标数）”数据属性，记录CombatCapability（法术能力）的法术最大目标数，值类型为 xsd:integer。
:capabilityMaxTargets rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CombatCapability ;
                      rdfs:range xsd:integer ;
                      rdfs:label "法术最大目标数"@zh .


###  http://example.org/killweb#capabilityMinAltitudeFt
# 定义“capabilityMinAltitudeFt（法术最低作用高度）”数据属性，记录CombatCapability（法术能力）的法术最低作用高度，值类型为 xsd:decimal。
:capabilityMinAltitudeFt rdf:type owl:DatatypeProperty ;
                         rdfs:domain :CombatCapability ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "法术最低作用高度"@zh .


