          rdfs:domain :ChainNode ;
          rdfs:range xsd:string ;
          rdfs:label "节点职能"@zh .


###  http://example.org/killweb#operationalStatus
# 定义“operationalStatus（法器状态）”数据属性，记录WeaponEquipment（法器）的法器状态，值类型为 xsd:string。
:operationalStatus rdf:type owl:DatatypeProperty ;
                   rdfs:domain :WeaponEquipment ;
                   rdfs:range xsd:string ;
                   rdfs:label "法器状态"@zh .


###  http://example.org/killweb#reconIntervalS
# 定义“reconIntervalS（侦测时间间隔（秒））”数据属性，记录ReconEquipment（侦测法器）的侦测时间间隔（秒），值类型为 xsd:decimal。
:reconIntervalS rdf:type owl:DatatypeProperty ;
                rdfs:domain :ReconEquipment ;
                rdfs:range xsd:decimal ;
                rdfs:label "侦测时间间隔（秒）"@zh .


###  http://example.org/killweb#reconTargetType
# 定义“reconTargetType（侦测目标类型）”数据属性，记录ReconEquipment（侦测法器）的侦测目标类型，值类型为 xsd:string。
:reconTargetType rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ReconEquipment ;
                 rdfs:range xsd:string ;
                 rdfs:label "侦测目标类型"@zh .


###  http://example.org/killweb#relationEndTime
# 定义“relationEndTime（法阵解除时间）”数据属性，记录ChainRelation（法阵组合关系）的法阵解除时间，值类型为 xsd:dateTime。
:relationEndTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ChainRelation ;
                 rdfs:range xsd:dateTime ;
                 rdfs:label "法阵解除时间"@zh .


###  http://example.org/killweb#relationStartTime
# 定义“relationStartTime（法阵生效时间）”数据属性，记录ChainRelation（法阵组合关系）的法阵生效时间，值类型为 xsd:dateTime。
:relationStartTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ChainRelation ;
                   rdfs:range xsd:dateTime ;
                   rdfs:label "法阵生效时间"@zh .


###  http://example.org/killweb#relayDelayMs
# 定义“relayDelayMs（中继延迟（毫秒））”数据属性，记录CommandControlEquipment（指挥法器）的中继延迟（毫秒），值类型为 xsd:decimal。
:relayDelayMs rdf:type owl:DatatypeProperty ;
              rdfs:domain :CommandControlEquipment ;
              rdfs:range xsd:decimal ;
              rdfs:label "中继延迟（毫秒）"@zh .


###  http://example.org/killweb#reloadTimeS
# 定义“reloadTimeS（魔力再充填耗时（秒））”数据属性，记录StrikeEquipment（攻击法器）的魔力再充填耗时（秒），值类型为 xsd:decimal。
:reloadTimeS rdf:type owl:DatatypeProperty ;
             rdfs:domain :StrikeEquipment ;
             rdfs:range xsd:decimal ;
             rdfs:label "魔力再充填耗时（秒）"@zh .


###  http://example.org/killweb#responseTimeS
# 定义“responseTimeS（吟唱响应耗时（秒））”数据属性，记录StrikeEquipment（攻击法器）的吟唱响应耗时（秒），值类型为 xsd:decimal。
:responseTimeS rdf:type owl:DatatypeProperty ;
               rdfs:domain :StrikeEquipment ;
               rdfs:range xsd:decimal ;
               rdfs:label "吟唱响应耗时（秒）"@zh .


###  http://example.org/killweb#salvoSize
# 定义“salvoSize（波次连发数量）”数据属性，记录StrikeEquipment（攻击法器）的波次连发数量，值类型为 xsd:integer。
:salvoSize rdf:type owl:DatatypeProperty ;
           rdfs:domain :StrikeEquipment ;
           rdfs:range xsd:integer ;
           rdfs:label "波次连发数量"@zh .


###  http://example.org/killweb#speedKn
# 定义“speedKn（法器速度（节））”数据属性，记录WeaponEquipment（法器）的法器速度（节），值类型为 xsd:decimal。
:speedKn rdf:type owl:DatatypeProperty ;
         rdfs:domain :WeaponEquipment ;
         rdfs:range xsd:decimal ;
         rdfs:label "法器速度（节）"@zh .


###  http://example.org/killweb#strikeTargetType
# 定义“strikeTargetType（攻击目标类型）”数据属性，记录StrikeEquipment（攻击法器）的攻击目标类型，值类型为 xsd:string。
:strikeTargetType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :StrikeEquipment ;
                  rdfs:range xsd:string ;
                  rdfs:label "攻击目标类型"@zh .


###  http://example.org/killweb#targetAltitudeFt
# 定义“targetAltitudeFt（目标高度（英尺））”数据属性，记录Target（敌方目标）的目标高度（英尺），值类型为 xsd:decimal。
:targetAltitudeFt rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Target ;
                  rdfs:range xsd:decimal ;
                  rdfs:label "目标高度（英尺）"@zh .


###  http://example.org/killweb#targetDistanceNm
# 定义“targetDistanceNm（目标距离（海里））”数据属性，记录CombatMission（战斗任务）的目标距离（海里），值类型为 xsd:decimal。
:targetDistanceNm rdf:type owl:DatatypeProperty ;
                  rdfs:domain :CombatMission ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "扩展：表 5 之外补充的目标距离字段。"@zh ;
                  rdfs:label "目标距离（海里）"@zh .


###  http://example.org/killweb#targetLatitudeDeg
# 定义“targetLatitudeDeg（目标纬度）”数据属性，记录Target（敌方目标）的目标纬度，值类型为 xsd:decimal。
:targetLatitudeDeg rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Target ;
                   rdfs:range xsd:decimal ;
                   rdfs:label "目标纬度"@zh .


###  http://example.org/killweb#targetLongitudeDeg
# 定义“targetLongitudeDeg（目标经度）”数据属性，记录Target（敌方目标）的目标经度，值类型为 xsd:decimal。
:targetLongitudeDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Target ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "目标经度"@zh .


###  http://example.org/killweb#targetSpeedKn
# 定义“targetSpeedKn（目标速度（节））”数据属性，记录Target（敌方目标）的目标速度（节），值类型为 xsd:decimal。
:targetSpeedKn rdf:type owl:DatatypeProperty ;
               rdfs:domain :Target ;
               rdfs:range xsd:decimal ;
               rdfs:label "目标速度（节）"@zh .


###  http://example.org/killweb#targetSurvivability
# 定义“targetSurvivability（目标魔法抗性）”数据属性，记录Target（敌方目标）的目标魔法抗性，值类型为 xsd:decimal。
:targetSurvivability rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Target ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "目标侧的抗毁指标，沿用原版 targetSurvivability 的数值尺度和计算口径；“目标魔法抗性”为背景化显示名称，不额外引入特定元素抗性或新的计算公式。"@zh ;
                     rdfs:label "目标魔法抗性"@zh .


###  http://example.org/killweb#targetType
# 定义“targetType（目标类型）”数据属性，记录Target（敌方目标）的目标类型，值类型为 xsd:string。
:targetType rdf:type owl:DatatypeProperty ;
            rdfs:domain :Target ;
            rdfs:range xsd:string ;
            rdfs:label "目标类型"@zh .


#    Classes

###  http://example.org/killweb#BattlefieldSituation
# 构建“BattlefieldSituation（元素战场态势）”类，定义该概念的相关信息和约束。
:BattlefieldSituation rdf:type owl:Class ;
                      rdfs:comment "元素战场中魔力分布及元素环境的当前状态和发展变化趋势。"@zh ;
                      rdfs:label "元素战场态势"@zh .


###  http://example.org/killweb#BranchRelation
# 构建“BranchRelation（分支法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:BranchRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "分支法阵"@zh .


###  http://example.org/killweb#ChainNode
# 构建“ChainNode（法术链节点）”类，定义该概念的相关信息和约束。
:ChainNode rdf:type owl:Class ;
           rdfs:comment "1.6 扩展：用于表达节点顺序、职能和法器关联；本文件中它是法术链结构的唯一权威表示。"@zh ;
           rdfs:label "法术链节点"@zh .


###  http://example.org/killweb#ChainRelation
# 构建“ChainRelation（法阵组合关系）”类，定义该概念的相关信息和约束。
:ChainRelation rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :relatedChain ;
                                 owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                 owl:onClass :KillChain
                               ] ;
               rdfs:comment "2.1.3 扩展：以具体关系实例表达并列、串联、分支等法阵组合。并列法阵用 relatedChain 列出参与者，有向法阵用 fromChain/toChain 表示方向；不再使用法术链到法术链的直接属性。"@zh ;
               rdfs:label "法阵组合关系"@zh .


###  http://example.org/killweb#CombatCapability
# 构建“CombatCapability（法术能力）”类，定义该概念的相关信息和约束。
:CombatCapability rdf:type owl:Class ;
                  rdfs:comment "法器执行战斗任务的本领，是法器体系的固有属性，与型号、法术参数等有关。"@zh ;
                  rdfs:label "法术能力"@zh .


###  http://example.org/killweb#CombatMission
# 构建“CombatMission（战斗任务）”类，定义该概念的相关信息和约束。
:CombatMission rdf:type owl:Class ;
               rdfs:comment "奥术网为实现战斗目标需要完成的各种任务的统称，包括探知、研判、决断、施法等。"@zh ;
               rdfs:label "战斗任务"@zh .


###  http://example.org/killweb#CommandCapability
# 构建“CommandCapability（统御能力）”类，归属于“CommandControlCapability（指挥能力）”类。
:CommandCapability rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlCapability ;
                   rdfs:label "统御能力"@zh .


###  http://example.org/killweb#CommandChainNode
# 构建“CommandChainNode（指挥链节点）”类，归属于“ChainNode（法术链节点）”类。
:CommandChainNode rdf:type owl:Class ;
                  rdfs:subClassOf :ChainNode ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :nodeEquipment ;
                                    owl:someValuesFrom :CommandControlEquipment
                                  ] ;
                  rdfs:label "指挥链节点"@zh .


###  http://example.org/killweb#CommandControlCapability
# 构建“CommandControlCapability（指挥能力）”类，归属于“CombatCapability（法术能力）”类。
:CommandControlCapability rdf:type owl:Class ;
                          rdfs:subClassOf :CombatCapability ;
                          rdfs:label "指挥能力"@zh .


###  http://example.org/killweb#CommandControlEquipment
# 构建“CommandControlEquipment（指挥法器）”类，归属于“WeaponEquipment（法器）”类。
:CommandControlEquipment rdf:type owl:Class ;
                         rdfs:subClassOf :WeaponEquipment ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasCapability ;
                                           owl:someValuesFrom :CommandControlCapability
                                         ] ;
                         rdfs:comment "各类指挥机构，是奥术网的核心，对一切魔法活动执行决断；包括联合指挥中枢、浮空艇编队指挥中枢等。"@zh ;
                         rdfs:label "指挥法器"@zh .


###  http://example.org/killweb#CommandControlMission
# 构建“CommandControlMission（指挥任务）”类，归属于“CombatMission（战斗任务）”类。
:CommandControlMission rdf:type owl:Class ;
                       rdfs:subClassOf :CombatMission ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :requiresCapability ;
                                         owl:someValuesFrom :CommandControlCapability
                                       ] ;
                       rdfs:label "指挥任务"@zh .


###  http://example.org/killweb#CommandControlPlatform
# 构建“CommandControlPlatform（指挥平台）”类，归属于“CommandControlEquipment（指挥法器）”类。
:CommandControlPlatform rdf:type owl:Class ;
                        rdfs:subClassOf :CommandControlEquipment ,
                                        :EquipmentPlatform ;
                        rdfs:comment "扩展子类：浮空艇编队指挥中枢等承载指挥节点的平台。论文表 2 把这类指挥机构也归入指挥法器。"@zh ;
                        rdfs:label "指挥平台"@zh .


###  http://example.org/killweb#CommunicationCapability
# 构建“CommunicationCapability（传讯能力）”类，归属于“CommandControlCapability（指挥能力）”类。
:CommunicationCapability rdf:type owl:Class ;
                         rdfs:subClassOf :CommandControlCapability ;
                         rdfs:label "传讯能力"@zh .


###  http://example.org/killweb#DecisionCapability
# 构建“DecisionCapability（决断能力）”类，归属于“CommandControlCapability（指挥能力）”类。
:DecisionCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CommandControlCapability ;
                    rdfs:label "决断能力"@zh .


###  http://example.org/killweb#DecisionEquipment
# 构建“DecisionEquipment（决断法器）”类，归属于“CommandControlEquipment（指挥法器）”类。
:DecisionEquipment rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlEquipment ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :DecisionCapability
                                   ] ;
                   rdfs:label "决断法器"@zh .


###  http://example.org/killweb#DecisionMission
# 构建“DecisionMission（决断任务（D 决断））”类，归属于“CommandControlMission（指挥任务）”类。
:DecisionMission rdf:type owl:Class ;
                 rdfs:subClassOf :CommandControlMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :DecisionCapability
                                 ] ;
                 rdfs:label "决断任务（D 决断）"@zh .


###  http://example.org/killweb#EquipmentPlatform
# 构建“EquipmentPlatform（承载平台）”类，归属于“WeaponEquipment（法器）”类。
:EquipmentPlatform rdf:type owl:Class ;
                   rdfs:subClassOf :WeaponEquipment ;
                   rdfs:comment "扩展类：承载感知装置、指挥节点或魔晶弹药的飞龙、浮空艇、魔导车、施法台等平台。"@zh ;
                   rdfs:label "承载平台"@zh .


###  http://example.org/killweb#EvaluationCapability
# 构建“EvaluationCapability（解析能力）”类，归属于“CommandControlCapability（指挥能力）”类。
:EvaluationCapability rdf:type owl:Class ;
                      rdfs:subClassOf :CommandControlCapability ;
                      rdfs:label "解析能力"@zh .


###  http://example.org/killweb#JudgmentCapability
# 构建“JudgmentCapability（占卜能力）”类，归属于“CommandControlCapability（指挥能力）”类。
:JudgmentCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CommandControlCapability ;
                    rdfs:label "占卜能力"@zh .


###  http://example.org/killweb#JudgmentEquipment
# 构建“JudgmentEquipment（占卜法器）”类，归属于“CommandControlEquipment（指挥法器）”类。
:JudgmentEquipment rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlEquipment ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :JudgmentCapability
                                   ] ;
                   rdfs:label "占卜法器"@zh .


###  http://example.org/killweb#JudgmentMission
# 构建“JudgmentMission（占卜任务（O2 研判））”类，归属于“CommandControlMission（指挥任务）”类。
:JudgmentMission rdf:type owl:Class ;
                 rdfs:subClassOf :CommandControlMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :JudgmentCapability
                                 ] ;
                 rdfs:label "占卜任务（O2 研判）"@zh .


###  http://example.org/killweb#KillChain
# 构建“KillChain（法术链）”类，定义该概念的相关信息和约束。
:KillChain rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :chainTarget ;
                             owl:someValuesFrom :Target
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :CommandChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :ReconChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :StrikeChainNode
                           ] ;
           rdfs:comment "1.6/2.x 扩展：由敌方目标、侦测、指挥、攻击节点构成的闭合施法链路。第 6 节的 someValuesFrom 公理只要求存在相应角色节点和目标，不校验节点顺序、连通性、闭环和资源冲突。"@zh ;
           rdfs:label "法术链"@zh .


###  http://example.org/killweb#KillWeb
# 构建“KillWeb（奥术网）”类，定义该概念的相关信息和约束。
:KillWeb rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasChain ;
                           owl:someValuesFrom :KillChain
                         ] ;
         rdfs:comment "1.6/2.x 扩展：多条法术链通过共享节点和法阵组合关系形成的分布式施法网络。"@zh ;
         rdfs:label "奥术网"@zh .


###  http://example.org/killweb#OperationalRequirement
# 构建“OperationalRequirement（施法需求）”类，定义该概念的相关信息和约束。
:OperationalRequirement rdf:type owl:Class ;
                        rdfs:comment "在一定的时期，为完成可能担负的战斗任务，对魔法力量建设的基本要求。暂时只建立需求与战斗任务、法术、法器的关系。"@zh ;
                        rdfs:label "施法需求"@zh .


###  http://example.org/killweb#ParallelRelation
# 构建“ParallelRelation（并列法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:ParallelRelation rdf:type owl:Class ;
                  rdfs:subClassOf :ChainRelation ;
                  rdfs:label "并列法阵"@zh .


###  http://example.org/killweb#ReconCapability
# 构建“ReconCapability（侦测能力）”类，归属于“CombatCapability（法术能力）”类。
:ReconCapability rdf:type owl:Class ;
                 rdfs:subClassOf :CombatCapability ;
                 rdfs:label "侦测能力"@zh .


###  http://example.org/killweb#ReconChainNode
# 构建“ReconChainNode（侦测链节点）”类，归属于“ChainNode（法术链节点）”类。
:ReconChainNode rdf:type owl:Class ;
                rdfs:subClassOf :ChainNode ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :nodeEquipment ;
                                  owl:someValuesFrom :ReconEquipment
                                ] ;
                rdfs:label "侦测链节点"@zh .


###  http://example.org/killweb#ReconEquipment
# 构建“ReconEquipment（侦测法器）”类，归属于“WeaponEquipment（法器）”类。
:ReconEquipment rdf:type owl:Class ;
                rdfs:subClassOf :WeaponEquipment ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasCapability ;
                                  owl:someValuesFrom :ReconCapability
                                ] ;
                rdfs:comment "侦测类单元平台，承担发现、搜集战斗空间信息参数并回传的任务；包括预警魔像、侦测魔像、探知法阵、星界探知镜等。感知挂载和侦测平台都归入此类。"@zh ;
                rdfs:label "侦测法器"@zh .


###  http://example.org/killweb#ReconMission
# 构建“ReconMission（侦测任务（O1 探知））”类，归属于“CombatMission（战斗任务）”类。
:ReconMission rdf:type owl:Class ;
              rdfs:subClassOf :CombatMission ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :requiresCapability ;
                                owl:someValuesFrom :ReconCapability
                              ] ;
              rdfs:label "侦测任务（O1 探知）"@zh .


###  http://example.org/killweb#ReconPlatform
# 构建“ReconPlatform（侦测平台）”类，归属于“EquipmentPlatform（承载平台）”类。
:ReconPlatform rdf:type owl:Class ;
               rdfs:subClassOf :EquipmentPlatform ,
                               :ReconEquipment ;
               rdfs:comment "扩展子类：预警魔像、侦测魔像、星界探知镜等承载侦测挂载的平台。论文表 2 把这类单元平台也归入侦测法器。"@zh ;
               rdfs:label "侦测平台"@zh .


###  http://example.org/killweb#ReconRangeCapability
# 构建“ReconRangeCapability（感知距离能力）”类，归属于“ReconCapability（侦测能力）”类。
:ReconRangeCapability rdf:type owl:Class ;
                      rdfs:subClassOf :ReconCapability ;
                      rdfs:label "感知距离能力"@zh .


###  http://example.org/killweb#ReconTargetTypeCapability
# 构建“ReconTargetTypeCapability（侦测目标类型能力）”类，归属于“ReconCapability（侦测能力）”类。
:ReconTargetTypeCapability rdf:type owl:Class ;
                           rdfs:subClassOf :ReconCapability ;
                           rdfs:label "侦测目标类型能力"@zh .


###  http://example.org/killweb#SerialRelation
# 构建“SerialRelation（串联法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:SerialRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "串联法阵"@zh .


###  http://example.org/killweb#StrikeAltitudeCapability
# 构建“StrikeAltitudeCapability（攻击高度能力）”类，归属于“StrikeCapability（攻击能力）”类。
:StrikeAltitudeCapability rdf:type owl:Class ;
                          rdfs:subClassOf :StrikeCapability ;
                          rdfs:label "攻击高度能力"@zh .


###  http://example.org/killweb#StrikeAmmunition
# 构建“StrikeAmmunition（魔晶弹药）”类，归属于“StrikeEquipment（攻击法器）”类。
:StrikeAmmunition rdf:type owl:Class ;
                  rdfs:subClassOf :StrikeEquipment ;
                  rdfs:comment "扩展类：魔晶弹、爆裂弹等一次性或可消耗的攻击挂载。魔晶弹药可以通过 mountedOn 关联承载平台，但本类不强制所有实例都已挂载。"@zh ;
                  rdfs:label "魔晶弹药"@zh .


###  http://example.org/killweb#StrikeCapability
# 构建“StrikeCapability（攻击能力）”类，归属于“CombatCapability（法术能力）”类。
:StrikeCapability rdf:type owl:Class ;
                  rdfs:subClassOf :CombatCapability ;
                  rdfs:label "攻击能力"@zh .


###  http://example.org/killweb#StrikeChainNode
# 构建“StrikeChainNode（攻击链节点）”类，归属于“ChainNode（法术链节点）”类。
:StrikeChainNode rdf:type owl:Class ;
                 rdfs:subClassOf :ChainNode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :nodeEquipment ;
                                   owl:someValuesFrom :StrikeEquipment
                                 ] ;
                 rdfs:comment "节点法器取攻击法器，既可以是释放平台，也可以是魔晶弹药。"@zh ;
                 rdfs:label "攻击链节点"@zh .


###  http://example.org/killweb#StrikeEquipment
# 构建“StrikeEquipment（攻击法器）”类，归属于“WeaponEquipment（法器）”类。
:StrikeEquipment rdf:type owl:Class ;
                 rdfs:subClassOf :WeaponEquipment ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasCapability ;
                                   owl:someValuesFrom :StrikeCapability
                                 ] ;
                 rdfs:comment "功能角色类：表示可执行杀伤和击毁任务的功能单元，在指挥节点的指令和侦测节点的信息传输下，对敌方目标进行干扰或攻击。既包括攻击平台，也包括魔晶弹药，不限定为承载平台。原版表 3 的打击属性以本类为定义域；StrikeAmmunition 作为子类继承相关属性的适用范围。"@zh ;
                 rdfs:label "攻击法器"@zh .


###  http://example.org/killweb#StrikeMission
# 构建“StrikeMission（攻击任务（A 施法））”类，归属于“CombatMission（战斗任务）”类。
:StrikeMission rdf:type owl:Class ;
               rdfs:subClassOf :CombatMission ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :requiresCapability ;
                                 owl:someValuesFrom :StrikeCapability
                               ] ;
               rdfs:label "攻击任务（A 施法）"@zh .


###  http://example.org/killweb#StrikePlatform
# 构建“StrikePlatform（攻击平台）”类，归属于“EquipmentPlatform（承载平台）”类。
:StrikePlatform rdf:type owl:Class ;
                rdfs:subClassOf :EquipmentPlatform ,
                                :StrikeEquipment ;
                rdfs:comment "扩展子类：魔导战机、防护法阵、浮空艇等可释放或投掷魔晶弹药的平台。平台归入攻击法器是论文的建模方式；魔晶弹药是消耗性挂载。"@zh ;
                rdfs:label "攻击平台"@zh .


###  http://example.org/killweb#StrikeRangeCapability
# 构建“StrikeRangeCapability（攻击距离能力）”类，归属于“StrikeCapability（攻击能力）”类。
:StrikeRangeCapability rdf:type owl:Class ;
                       rdfs:subClassOf :StrikeCapability ;
                       rdfs:label "攻击距离能力"@zh .


###  http://example.org/killweb#StrikeTargetQuantityCapability
# 构建“StrikeTargetQuantityCapability（攻击目标数量能力）”类，归属于“StrikeCapability（攻击能力）”类。
:StrikeTargetQuantityCapability rdf:type owl:Class ;
                                rdfs:subClassOf :StrikeCapability ;
                                rdfs:label "攻击目标数量能力"@zh .


###  http://example.org/killweb#StrikeTargetTypeCapability
# 构建“StrikeTargetTypeCapability（攻击目标类型能力）”类，归属于“StrikeCapability（攻击能力）”类。
:StrikeTargetTypeCapability rdf:type owl:Class ;
                            rdfs:subClassOf :StrikeCapability ;
                            rdfs:label "攻击目标类型能力"@zh .


###  http://example.org/killweb#Target
# 构建“Target（敌方目标）”类，定义该概念的相关信息和约束。
:Target rdf:type owl:Class ;
        rdfs:comment "1.6/2.x 扩展：战斗任务需要感知、跟踪、攻击或解析的敌方对象。"@zh ;
        rdfs:label "敌方目标"@zh .


###  http://example.org/killweb#WeaponEquipment
# 构建“WeaponEquipment（法器）”类，定义该概念的相关信息和约束。
:WeaponEquipment rdf:type owl:Class ;
                 rdfs:comment "为遂行一定的战斗任务、具有一定魔法功能的法器系统，是奥术网的最小组成功能要素。"@zh ;
                 rdfs:label "法器"@zh .


#    Individuals

###  http://example.org/killweb#AirReconCapability
# 定义“AirReconCapability（空中侦测能力）”规范能力个体，属于“ReconTargetTypeCapability（侦测目标类型能力）”类。
:AirReconCapability rdf:type owl:NamedIndividual ,
                             :ReconTargetTypeCapability ;
                    :capabilityTargetType "aircraft" ;
                    rdfs:label "空中侦测能力"@zh .


###  http://example.org/killweb#AirStrikeCapability
# 定义“AirStrikeCapability（对空攻击能力）”规范能力个体，属于“StrikeTargetTypeCapability（攻击目标类型能力）”类。
:AirStrikeCapability rdf:type owl:NamedIndividual ,
                              :StrikeTargetTypeCapability ;
                     :capabilityTargetType "aircraft" ;
                     rdfs:label "对空攻击能力"@zh .


