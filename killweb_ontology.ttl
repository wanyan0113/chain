@prefix : <http://example.org/killweb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/killweb#> .

<http://example.org/killweb> rdf:type owl:Ontology ;
                              rdfs:comment "依据论文《基于知识推理的杀伤网智能设计方法》1.1—1.5 节构建的核心本体；杀伤链/网、链节点、链间关系、平台/载荷、Target 等为 1.6/第二章扩展，第 7 节冒烟实例已禁用。"@zh ;
                              rdfs:label "杀伤网设计本体"@zh ;
                              rdfs:seeAlso <https://doi.org/10.12382/bgxb.2022.1077> ;
                              owl:versionInfo "0.6" .

#    Object Properties

###  http://example.org/killweb#capabilitySupportsMission
# 定义“capabilitySupportsMission（支撑任务）”关系，连接CombatCapability（作战能力）与CombatMission（作战任务）。
:capabilitySupportsMission rdf:type owl:ObjectProperty ;
                           owl:inverseOf :requiresCapability ;
                           rdfs:domain :CombatCapability ;
                           rdfs:range :CombatMission ;
                           rdfs:label "支撑任务"@zh .


###  http://example.org/killweb#chainRelation
# 定义“chainRelation（参与的链间关系）”关系，连接KillChain（杀伤链）与ChainRelation（链间协同关系）。
:chainRelation rdf:type owl:ObjectProperty ;
               owl:inverseOf :relatedChain ;
               rdfs:domain :KillChain ;
               rdfs:range :ChainRelation ;
               rdfs:comment "链指向关系实例的反向链接，与 relatedChain 互逆。"@zh ;
               rdfs:label "参与的链间关系"@zh .


###  http://example.org/killweb#chainTarget
# 定义“chainTarget（打击目标）”关系，连接KillChain（杀伤链）与Target（作战目标）。
:chainTarget rdf:type owl:ObjectProperty ;
             rdfs:domain :KillChain ;
             rdfs:range :Target ;
             rdfs:label "打击目标"@zh .


###  http://example.org/killweb#commandToStrikeCommunication
# 定义“commandToStrikeCommunication（指控-打击通信）”关系，连接CommandControlEquipment（指控装备）与StrikeEquipment（打击装备）。
:commandToStrikeCommunication rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :communicatesWith ;
                              rdfs:domain :CommandControlEquipment ;
                              rdfs:range :StrikeEquipment ;
                              rdfs:comment "对应论文图 3 中指控装备与打击装备之间的通信关系。"@zh ;
                              rdfs:label "指控-打击通信"@zh .


###  http://example.org/killweb#commands
# 定义“commands（指挥装备）”关系，连接CommandControlEquipment（指控装备）与WeaponEquipment（武器装备）。
:commands rdf:type owl:ObjectProperty ;
          rdfs:domain :CommandControlEquipment ;
          rdfs:range :WeaponEquipment ;
          rdfs:label "指挥装备"@zh .


###  http://example.org/killweb#communicatesWith
# 定义“communicatesWith（通信协同）”关系，连接WeaponEquipment（武器装备）与WeaponEquipment（武器装备）。
:communicatesWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  rdfs:domain :WeaponEquipment ;
                  rdfs:range :WeaponEquipment ;
                  rdfs:label "通信协同"@zh .


###  http://example.org/killweb#constrainedBy
# 定义“constrainedBy（受态势约束）”关系，连接CombatCapability（作战能力）与BattlefieldSituation（战场态势）。
:constrainedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :situationConstrainsCapability ;
               rdfs:domain :CombatCapability ;
               rdfs:range :BattlefieldSituation ;
               rdfs:comment "图 1 的态势→能力关系；能力受当前战场态势约束。"@zh ;
               rdfs:label "受态势约束"@zh .


###  http://example.org/killweb#containsTarget
# 定义“containsTarget（态势包含目标）”关系，连接BattlefieldSituation（战场态势）与Target（作战目标）。
:containsTarget rdf:type owl:ObjectProperty ;
                rdfs:domain :BattlefieldSituation ;
                rdfs:range :Target ;
                rdfs:label "态势包含目标"@zh .


###  http://example.org/killweb#detects
# 定义“detects（探测目标）”关系，连接ReconEquipment（侦察装备）与Target（作战目标）。
:detects rdf:type owl:ObjectProperty ;
         rdfs:domain :ReconEquipment ;
         rdfs:range :Target ;
         rdfs:label "探测目标"@zh .


###  http://example.org/killweb#finishStartPrecedes
# 定义“finishStartPrecedes（完成-开始前序）”关系，连接CombatMission（作战任务）与CombatMission（作战任务）。
:finishStartPrecedes rdf:type owl:ObjectProperty ;
                     owl:inverseOf :startsAfterCompletionOf ;
                     rdf:type owl:IrreflexiveProperty ;
                     rdfs:domain :CombatMission ;
                     rdfs:range :CombatMission ;
                     rdfs:comment "对应论文图 5：前一任务完成后，后一任务开始。该属性只表达直接时序，不自动计算持续时间。"@zh ;
                     rdfs:label "完成-开始前序"@zh .


###  http://example.org/killweb#fromChain
# 定义“fromChain（起始链）”关系，连接ChainRelation（链间协同关系）与KillChain（杀伤链）。
:fromChain rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :relatedChain ;
           rdfs:domain :ChainRelation ;
           rdfs:range :KillChain ;
           rdfs:comment "用于串行关系和分支关系，表示有向关系的起点。"@zh ;
           rdfs:label "起始链"@zh .


###  http://example.org/killweb#hasCapability
# 定义“hasCapability（具备能力）”关系，连接WeaponEquipment（武器装备）与CombatCapability（作战能力）。
:hasCapability rdf:type owl:ObjectProperty ;
               owl:inverseOf :realizedBy ;
               rdfs:domain :WeaponEquipment ;
               rdfs:range :CombatCapability ;
               rdfs:comment "定义域故意设为 WeaponEquipment：平台和载荷都可以具备能力。若只想让功能单元具备能力，应另建 FunctionalEquipment 子类，而不是依赖注释。"@zh ;
               rdfs:label "具备能力"@zh .


###  http://example.org/killweb#hasChain
# 定义“hasChain（杀伤网包含链）”关系，连接KillWeb（杀伤网）与KillChain（杀伤链）。
:hasChain rdf:type owl:ObjectProperty ;
          rdfs:domain :KillWeb ;
          rdfs:range :KillChain ;
          rdfs:label "杀伤网包含链"@zh .


###  http://example.org/killweb#hasChainNode
# 定义“hasChainNode（包含有序节点）”关系，连接KillChain（杀伤链）与ChainNode（杀伤链节点）。
:hasChainNode rdf:type owl:ObjectProperty ;
              rdfs:domain :KillChain ;
              rdfs:range :ChainNode ;
              rdfs:comment "杀伤链成员关系的唯一入口；节点顺序由 nodeOrder 和 nextNode 表达。"@zh ;
              rdfs:label "包含有序节点"@zh .


###  http://example.org/killweb#hasPayload
# 定义“hasPayload（搭载载荷）”关系，连接EquipmentPlatform（装备平台）与WeaponEquipment（武器装备）。
:hasPayload rdf:type owl:ObjectProperty ;
            owl:inverseOf :mountedOn ;
            rdfs:domain :EquipmentPlatform ;
            rdfs:range :WeaponEquipment ;
            rdfs:comment "扩展关系：mountedOn 的逆关系，仅用于可分离物理载荷；常驻指控节点使用 hosts。"@zh ;
            rdfs:label "搭载载荷"@zh .


###  http://example.org/killweb#hasRelation
# 定义“hasRelation（包含链间关系）”关系，连接KillWeb（杀伤网）与ChainRelation（链间协同关系）。
:hasRelation rdf:type owl:ObjectProperty ;
             owl:inverseOf :relationInWeb ;
             rdfs:domain :KillWeb ;
             rdfs:range :ChainRelation ;
             rdfs:label "包含链间关系"@zh .


###  http://example.org/killweb#hasSituation
# 定义“hasSituation（任务所处态势）”关系，连接CombatMission（作战任务）与BattlefieldSituation（战场态势）。
:hasSituation rdf:type owl:ObjectProperty ;
              rdfs:domain :CombatMission ;
              rdfs:range :BattlefieldSituation ;
              rdfs:comment "图 1 中作战任务与战场态势共同决定所需能力的任务侧入口。"@zh ;
              rdfs:label "任务所处态势"@zh .


###  http://example.org/killweb#hasSubMission
# 定义“hasSubMission（包含子任务）”关系，连接CombatMission（作战任务）与CombatMission（作战任务）。
:hasSubMission rdf:type owl:ObjectProperty ;
               rdfs:domain :CombatMission ;
               rdfs:range :CombatMission ;
               rdfs:comment "扩展：任务分解关系。"@zh ;
               rdfs:label "包含子任务"@zh .


###  http://example.org/killweb#hasTarget
# 定义“hasTarget（任务目标）”关系，连接CombatMission（作战任务）与Target（作战目标）。
:hasTarget rdf:type owl:ObjectProperty ;
           rdfs:domain :CombatMission ;
           rdfs:range :Target ;
           rdfs:label "任务目标"@zh .


###  http://example.org/killweb#hosts
# 定义“hosts（搭载节点）”关系，连接EquipmentPlatform（装备平台）与WeaponEquipment（武器装备）。
:hosts rdf:type owl:ObjectProperty ;
       rdfs:domain :EquipmentPlatform ;
       rdfs:range :WeaponEquipment ;
       rdfs:comment "扩展关系：平台提供常驻或集成节点（如预警机上的联合指挥中心）；不等同于可分离物理载荷。"@zh ;
       rdfs:label "搭载节点"@zh .


###  http://example.org/killweb#judgmentToDecisionCommunication
# 定义“judgmentToDecisionCommunication（判断-决策通信）”关系，连接JudgmentEquipment（判断装备）与DecisionEquipment（决策装备）。
:judgmentToDecisionCommunication rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :communicatesWith ;
                                 rdfs:domain :JudgmentEquipment ;
                                 rdfs:range :DecisionEquipment ;
                                 rdfs:comment "对应论文图 3 中判断装备与决策装备之间的通信关系。"@zh ;
                                 rdfs:label "判断-决策通信"@zh .


###  http://example.org/killweb#mountedOn
# 定义“mountedOn（挂载于）”关系，连接WeaponEquipment（武器装备）与EquipmentPlatform（装备平台）。
:mountedOn rdf:type owl:ObjectProperty ;
           rdfs:domain :WeaponEquipment ;
           rdfs:range :EquipmentPlatform ;
           rdfs:comment "扩展关系：表示可分离的物理挂载关系，例如雷达吊舱、导弹挂架。"@zh ;
           rdfs:label "挂载于"@zh .


###  http://example.org/killweb#nextNode
# 定义“nextNode（后继节点）”关系，连接ChainNode（杀伤链节点）与ChainNode（杀伤链节点）。
:nextNode rdf:type owl:ObjectProperty ;
          owl:inverseOf :previousNode ;
          rdf:type owl:FunctionalProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :ChainNode ;
          rdfs:range :ChainNode ;
          rdfs:comment "单后继关系。OWL 不能保证后继属于同一条链、无环或与 nodeOrder 一致，这些需由 SHACL 或程序校验。"@zh ;
          rdfs:label "后继节点"@zh .


###  http://example.org/killweb#nodeEquipment
# 定义“nodeEquipment（节点装备）”关系，连接ChainNode（杀伤链节点）与WeaponEquipment（武器装备）。
:nodeEquipment rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainNode ;
               rdfs:range :WeaponEquipment ;
               rdfs:label "节点装备"@zh .


###  http://example.org/killweb#previousNode
# 定义“previousNode（前驱节点）”关系，连接ChainNode（杀伤链节点）与ChainNode（杀伤链节点）。
:previousNode rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainNode ;
              rdfs:range :ChainNode ;
              rdfs:label "前驱节点"@zh .


###  http://example.org/killweb#realizedBy
# 定义“realizedBy（由装备实现）”关系，连接CombatCapability（作战能力）与WeaponEquipment（武器装备）。
:realizedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :CombatCapability ;
            rdfs:range :WeaponEquipment ;
            rdfs:label "由装备实现"@zh .


###  http://example.org/killweb#reconToCommandCommunication
# 定义“reconToCommandCommunication（侦察-指控通信）”关系，连接ReconEquipment（侦察装备）与CommandControlEquipment（指控装备）。
:reconToCommandCommunication rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :communicatesWith ;
                             rdfs:domain :ReconEquipment ;
                             rdfs:range :CommandControlEquipment ;
                             rdfs:comment "对应论文图 3 中侦察装备与指控装备之间的通信关系。"@zh ;
                             rdfs:label "侦察-指控通信"@zh .


###  http://example.org/killweb#relatedChain
# 定义“relatedChain（关联杀伤链）”关系，连接ChainRelation（链间协同关系）与KillChain（杀伤链）。
:relatedChain rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainRelation ;
              rdfs:range :KillChain ;
              rdfs:comment "关系实例的参与链集合。并行关系用它列出全部参与者。"@zh ;
              rdfs:label "关联杀伤链"@zh .


###  http://example.org/killweb#relationInWeb
# 定义“relationInWeb（所属杀伤网）”关系，连接ChainRelation（链间协同关系）与KillWeb（杀伤网）。
:relationInWeb rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainRelation ;
               rdfs:range :KillWeb ;
               rdfs:label "所属杀伤网"@zh .


###  http://example.org/killweb#requirementConstrainsCapability
# 定义“requirementConstrainsCapability（需求约束能力）”关系，连接OperationalRequirement（作战需求）与CombatCapability（作战能力）。
:requirementConstrainsCapability rdf:type owl:ObjectProperty ;
                                 rdfs:domain :OperationalRequirement ;
                                 rdfs:range :CombatCapability ;
                                 rdfs:comment "图 1 中作战需求参与决定所需能力。"@zh ;
                                 rdfs:label "需求约束能力"@zh .


###  http://example.org/killweb#requirementConstrainsEquipment
# 定义“requirementConstrainsEquipment（需求约束装备）”关系，连接OperationalRequirement（作战需求）与WeaponEquipment（武器装备）。
:requirementConstrainsEquipment rdf:type owl:ObjectProperty ;
                                rdfs:domain :OperationalRequirement ;
                                rdfs:range :WeaponEquipment ;
                                rdfs:comment "图 1 中作战需求参与决定所需武器装备；协同关系仍由第二章规则处理。"@zh ;
                                rdfs:label "需求约束装备"@zh .


###  http://example.org/killweb#requirementForMission
# 定义“requirementForMission（面向作战任务）”关系，连接OperationalRequirement（作战需求）与CombatMission（作战任务）。
:requirementForMission rdf:type owl:ObjectProperty ;
                       rdfs:domain :OperationalRequirement ;
                       rdfs:range :CombatMission ;
                       rdfs:comment "表 1 将作战需求定义为完成可能担负任务的基本要求；该属性把需求挂到任务上。"@zh ;
                       rdfs:label "面向作战任务"@zh .


###  http://example.org/killweb#requiresCapability
# 定义“requiresCapability（需要能力）”关系，连接CombatMission（作战任务）与CombatCapability（作战能力）。
:requiresCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain :CombatMission ;
                    rdfs:range :CombatCapability ;
                    rdfs:label "需要能力"@zh .


###  http://example.org/killweb#satisfiesRequirement
# 定义“satisfiesRequirement（满足作战需求）”关系，连接KillWeb（杀伤网）与OperationalRequirement（作战需求）。
:satisfiesRequirement rdf:type owl:ObjectProperty ;
                      rdfs:domain :KillWeb ;
                      rdfs:range :OperationalRequirement ;
                      rdfs:comment "扩展：只表达设计结果与需求的关联，不是自动判定满足。"@zh ;
                      rdfs:label "满足作战需求"@zh .


###  http://example.org/killweb#situationConstrainsCapability
# 定义“situationConstrainsCapability（态势约束能力）”关系，连接BattlefieldSituation（战场态势）与CombatCapability（作战能力）。
:situationConstrainsCapability rdf:type owl:ObjectProperty ;
                               rdfs:domain :BattlefieldSituation ;
                               rdfs:range :CombatCapability ;
                               rdfs:comment "图 1 的反向读法；与 constrainedBy 互逆。"@zh ;
                               rdfs:label "态势约束能力"@zh .


###  http://example.org/killweb#startsAfterCompletionOf
# 定义“startsAfterCompletionOf（在前序任务完成后开始）”关系，连接CombatMission（作战任务）与CombatMission（作战任务）。
:startsAfterCompletionOf rdf:type owl:ObjectProperty ;
                         rdfs:domain :CombatMission ;
                         rdfs:range :CombatMission ;
                         rdfs:label "在前序任务完成后开始"@zh .


###  http://example.org/killweb#supportsMission
# 定义“supportsMission（支撑任务）”关系，连接KillWeb（杀伤网）与CombatMission（作战任务）。
:supportsMission rdf:type owl:ObjectProperty ;
                 rdfs:domain :KillWeb ;
                 rdfs:range :CombatMission ;
                 rdfs:label "支撑任务"@zh .


###  http://example.org/killweb#toChain
# 定义“toChain（目标链）”关系，连接ChainRelation（链间协同关系）与KillChain（杀伤链）。
:toChain rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :relatedChain ;
         rdfs:domain :ChainRelation ;
         rdfs:range :KillChain ;
         rdfs:comment "用于串行关系和分支关系，表示有向关系的终点。"@zh ;
         rdfs:label "目标链"@zh .


#    Data properties

###  http://example.org/killweb#altitudeFt
# 定义“altitudeFt（装备海拔（英尺））”数据属性，记录WeaponEquipment（武器装备）的装备海拔（英尺），值类型为 xsd:decimal。
:altitudeFt rdf:type owl:DatatypeProperty ;
            rdfs:domain :WeaponEquipment ;
            rdfs:range xsd:decimal ;
            rdfs:label "装备海拔（英尺）"@zh .


###  http://example.org/killweb#azimuthCoverageDeg
# 定义“azimuthCoverageDeg（方位覆盖区（度））”数据属性，记录ReconEquipment（侦察装备）的方位覆盖区（度），值类型为 xsd:decimal。
:azimuthCoverageDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ReconEquipment ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "方位覆盖区（度）"@zh .


###  http://example.org/killweb#azimuthResolutionDeg
# 定义“azimuthResolutionDeg（方位角分辨误差（度））”数据属性，记录ReconEquipment（侦察装备）的方位角分辨误差（度），值类型为 xsd:decimal。
:azimuthResolutionDeg rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ReconEquipment ;
                      rdfs:range xsd:decimal ;
                      rdfs:label "方位角分辨误差（度）"@zh .


###  http://example.org/killweb#capabilityDescription
# 定义“capabilityDescription（能力说明）”数据属性，记录CombatCapability（作战能力）的能力说明，值类型为 xsd:string。
:capabilityDescription rdf:type owl:DatatypeProperty ;
                       rdfs:domain :CombatCapability ;
                       rdfs:range xsd:string ;
                       rdfs:label "能力说明"@zh .


###  http://example.org/killweb#capabilityLevel
# 定义“capabilityLevel（能力等级）”数据属性，记录CombatCapability（作战能力）的能力等级，值类型为 xsd:string。
:capabilityLevel rdf:type owl:DatatypeProperty ;
                 rdfs:domain :CombatCapability ;
                 rdfs:range xsd:string ;
                 rdfs:label "能力等级"@zh .


###  http://example.org/killweb#capabilityMaxAltitudeFt
# 定义“capabilityMaxAltitudeFt（能力最大作用高度（英尺））”数据属性，记录CombatCapability（作战能力）的能力最大作用高度（英尺），值类型为 xsd:decimal。
:capabilityMaxAltitudeFt rdf:type owl:DatatypeProperty ;
                         rdfs:domain :CombatCapability ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "能力最大作用高度（英尺）"@zh .


###  http://example.org/killweb#capabilityMaxTargets
# 定义“capabilityMaxTargets（能力最大目标数）”数据属性，记录CombatCapability（作战能力）的能力最大目标数，值类型为 xsd:integer。
:capabilityMaxTargets rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CombatCapability ;
                      rdfs:range xsd:integer ;
                      rdfs:label "能力最大目标数"@zh .


###  http://example.org/killweb#capabilityMinAltitudeFt
# 定义“capabilityMinAltitudeFt（能力最小作用高度（英尺））”数据属性，记录CombatCapability（作战能力）的能力最小作用高度（英尺），值类型为 xsd:decimal。
:capabilityMinAltitudeFt rdf:type owl:DatatypeProperty ;
                         rdfs:domain :CombatCapability ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "能力最小作用高度（英尺）"@zh .


###  http://example.org/killweb#capabilityPrecision
# 定义“capabilityPrecision（能力精度（0-1））”数据属性，记录CombatCapability（作战能力）的能力精度（0-1），值类型为 xsd:decimal。
:capabilityPrecision rdf:type owl:DatatypeProperty ;
                     rdfs:domain :CombatCapability ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "能力精度（0-1）"@zh .


###  http://example.org/killweb#capabilityRangeNm
