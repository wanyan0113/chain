# 定义“operationalStatus（装备状态）”数据属性，记录WeaponEquipment（武器装备）的装备状态，值类型为 xsd:string。
:operationalStatus rdf:type owl:DatatypeProperty ;
                   rdfs:domain :WeaponEquipment ;
                   rdfs:range xsd:string ;
                   rdfs:label "装备状态"@zh .


###  http://example.org/killweb#reconIntervalS
# 定义“reconIntervalS（侦察时间间隔（秒））”数据属性，记录ReconEquipment（侦察装备）的侦察时间间隔（秒），值类型为 xsd:decimal。
:reconIntervalS rdf:type owl:DatatypeProperty ;
                rdfs:domain :ReconEquipment ;
                rdfs:range xsd:decimal ;
                rdfs:label "侦察时间间隔（秒）"@zh .


###  http://example.org/killweb#reconTargetType
# 定义“reconTargetType（侦察目标类型）”数据属性，记录ReconEquipment（侦察装备）的侦察目标类型，值类型为 xsd:string。
:reconTargetType rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ReconEquipment ;
                 rdfs:range xsd:string ;
                 rdfs:label "侦察目标类型"@zh .


###  http://example.org/killweb#relationEndTime
# 定义“relationEndTime（关系结束时间）”数据属性，记录ChainRelation（链间协同关系）的关系结束时间，值类型为 xsd:dateTime。
:relationEndTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ChainRelation ;
                 rdfs:range xsd:dateTime ;
                 rdfs:label "关系结束时间"@zh .


###  http://example.org/killweb#relationStartTime
# 定义“relationStartTime（关系开始时间）”数据属性，记录ChainRelation（链间协同关系）的关系开始时间，值类型为 xsd:dateTime。
:relationStartTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ChainRelation ;
                   rdfs:range xsd:dateTime ;
                   rdfs:label "关系开始时间"@zh .


###  http://example.org/killweb#relayDelayMs
# 定义“relayDelayMs（中继延迟（毫秒））”数据属性，记录CommandControlEquipment（指控装备）的中继延迟（毫秒），值类型为 xsd:decimal。
:relayDelayMs rdf:type owl:DatatypeProperty ;
              rdfs:domain :CommandControlEquipment ;
              rdfs:range xsd:decimal ;
              rdfs:label "中继延迟（毫秒）"@zh .


###  http://example.org/killweb#reloadTimeS
# 定义“reloadTimeS（再装填耗时（秒））”数据属性，记录StrikeEquipment（打击装备）的再装填耗时（秒），值类型为 xsd:decimal。
:reloadTimeS rdf:type owl:DatatypeProperty ;
             rdfs:domain :StrikeEquipment ;
             rdfs:range xsd:decimal ;
             rdfs:label "再装填耗时（秒）"@zh .


###  http://example.org/killweb#responseTimeS
# 定义“responseTimeS（响应耗时（秒））”数据属性，记录StrikeEquipment（打击装备）的响应耗时（秒），值类型为 xsd:decimal。
:responseTimeS rdf:type owl:DatatypeProperty ;
               rdfs:domain :StrikeEquipment ;
               rdfs:range xsd:decimal ;
               rdfs:label "响应耗时（秒）"@zh .


###  http://example.org/killweb#salvoSize
# 定义“salvoSize（波次打击数量）”数据属性，记录StrikeEquipment（打击装备）的波次打击数量，值类型为 xsd:integer。
:salvoSize rdf:type owl:DatatypeProperty ;
           rdfs:domain :StrikeEquipment ;
           rdfs:range xsd:integer ;
           rdfs:label "波次打击数量"@zh .


###  http://example.org/killweb#speedKn
# 定义“speedKn（装备速度（节））”数据属性，记录WeaponEquipment（武器装备）的装备速度（节），值类型为 xsd:decimal。
:speedKn rdf:type owl:DatatypeProperty ;
         rdfs:domain :WeaponEquipment ;
         rdfs:range xsd:decimal ;
         rdfs:label "装备速度（节）"@zh .


###  http://example.org/killweb#strikeTargetType
# 定义“strikeTargetType（打击目标类型）”数据属性，记录StrikeEquipment（打击装备）的打击目标类型，值类型为 xsd:string。
:strikeTargetType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :StrikeEquipment ;
                  rdfs:range xsd:string ;
                  rdfs:label "打击目标类型"@zh .


###  http://example.org/killweb#targetAltitudeFt
# 定义“targetAltitudeFt（目标高度（英尺））”数据属性，记录Target（作战目标）的目标高度（英尺），值类型为 xsd:decimal。
:targetAltitudeFt rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Target ;
                  rdfs:range xsd:decimal ;
                  rdfs:label "目标高度（英尺）"@zh .


###  http://example.org/killweb#targetDistanceNm
# 定义“targetDistanceNm（目标距离（海里））”数据属性，记录CombatMission（作战任务）的目标距离（海里），值类型为 xsd:decimal。
:targetDistanceNm rdf:type owl:DatatypeProperty ;
                  rdfs:domain :CombatMission ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "扩展：表 5 之外补充的目标距离字段。"@zh ;
                  rdfs:label "目标距离（海里）"@zh .


###  http://example.org/killweb#targetLatitudeDeg
# 定义“targetLatitudeDeg（目标纬度）”数据属性，记录Target（作战目标）的目标纬度，值类型为 xsd:decimal。
:targetLatitudeDeg rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Target ;
                   rdfs:range xsd:decimal ;
                   rdfs:label "目标纬度"@zh .


###  http://example.org/killweb#targetLongitudeDeg
# 定义“targetLongitudeDeg（目标经度）”数据属性，记录Target（作战目标）的目标经度，值类型为 xsd:decimal。
:targetLongitudeDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Target ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "目标经度"@zh .


###  http://example.org/killweb#targetSpeedKn
# 定义“targetSpeedKn（目标速度（节））”数据属性，记录Target（作战目标）的目标速度（节），值类型为 xsd:decimal。
:targetSpeedKn rdf:type owl:DatatypeProperty ;
               rdfs:domain :Target ;
               rdfs:range xsd:decimal ;
               rdfs:label "目标速度（节）"@zh .


###  http://example.org/killweb#targetSurvivability
# 定义“targetSurvivability（目标抗毁能力）”数据属性，记录Target（作战目标）的目标抗毁能力，值类型为 xsd:decimal。
:targetSurvivability rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Target ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "目标抗毁能力"@zh .


###  http://example.org/killweb#targetType
# 定义“targetType（目标类型）”数据属性，记录Target（作战目标）的目标类型，值类型为 xsd:string。
:targetType rdf:type owl:DatatypeProperty ;
            rdfs:domain :Target ;
            rdfs:range xsd:string ;
            rdfs:label "目标类型"@zh .


#    Classes

###  http://example.org/killweb#BattlefieldSituation
# 构建“BattlefieldSituation（战场态势）”类，定义该概念的相关信息和约束。
:BattlefieldSituation rdf:type owl:Class ;
                      rdfs:comment "战场中兵力分布及战场环境的当前状态和发展变化趋势。"@zh ;
                      rdfs:label "战场态势"@zh .


###  http://example.org/killweb#BranchRelation
# 构建“BranchRelation（分支关系）”类，归属于“ChainRelation（链间协同关系）”类。
:BranchRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "分支关系"@zh .


###  http://example.org/killweb#ChainNode
# 构建“ChainNode（杀伤链节点）”类，定义该概念的相关信息和约束。
:ChainNode rdf:type owl:Class ;
           rdfs:comment "1.6 扩展：用于表达节点顺序、角色和装备关联；本文件中它是杀伤链结构的唯一权威表示。"@zh ;
           rdfs:label "杀伤链节点"@zh .


###  http://example.org/killweb#ChainRelation
# 构建“ChainRelation（链间协同关系）”类，定义该概念的相关信息和约束。
:ChainRelation rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :relatedChain ;
                                 owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                 owl:onClass :KillChain
                               ] ;
               rdfs:comment "2.1.3 扩展：以具体关系实例表达并行、串行、分支等链间关系。并行关系用 relatedChain 列出参与者，有向关系用 fromChain/toChain 表示方向；不再使用链到链的直接属性。"@zh ;
               rdfs:label "链间协同关系"@zh .


###  http://example.org/killweb#CombatCapability
# 构建“CombatCapability（作战能力）”类，定义该概念的相关信息和约束。
:CombatCapability rdf:type owl:Class ;
                  rdfs:comment "武器装备执行作战任务的本领，是武器装备体系的固有属性，与型号、战技指标等有关。"@zh ;
                  rdfs:label "作战能力"@zh .


###  http://example.org/killweb#CombatMission
# 构建“CombatMission（作战任务）”类，定义该概念的相关信息和约束。
:CombatMission rdf:type owl:Class ;
               rdfs:comment "杀伤网为实现作战目标需要完成的各种任务的统称，包括观察、判断、决策、行动等。"@zh ;
               rdfs:label "作战任务"@zh .


###  http://example.org/killweb#CommandCapability
# 构建“CommandCapability（指挥能力）”类，归属于“CommandControlCapability（指控能力）”类。
:CommandCapability rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlCapability ;
                   rdfs:label "指挥能力"@zh .


###  http://example.org/killweb#CommandChainNode
# 构建“CommandChainNode（指控链节点）”类，归属于“ChainNode（杀伤链节点）”类。
:CommandChainNode rdf:type owl:Class ;
                  rdfs:subClassOf :ChainNode ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :nodeEquipment ;
                                    owl:someValuesFrom :CommandControlEquipment
                                  ] ;
                  rdfs:label "指控链节点"@zh .


###  http://example.org/killweb#CommandControlCapability
# 构建“CommandControlCapability（指控能力）”类，归属于“CombatCapability（作战能力）”类。
:CommandControlCapability rdf:type owl:Class ;
                          rdfs:subClassOf :CombatCapability ;
                          rdfs:label "指控能力"@zh .


###  http://example.org/killweb#CommandControlEquipment
# 构建“CommandControlEquipment（指控装备）”类，归属于“WeaponEquipment（武器装备）”类。
:CommandControlEquipment rdf:type owl:Class ;
                         rdfs:subClassOf :WeaponEquipment ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasCapability ;
                                           owl:someValuesFrom :CommandControlCapability
                                         ] ;
                         rdfs:comment "各类指控机构，是杀伤网的核心，对军事活动执行决策；包括联合作战指控中心、舰艇编队指控中心等。"@zh ;
                         rdfs:label "指控装备"@zh .


###  http://example.org/killweb#CommandControlMission
# 构建“CommandControlMission（指控任务）”类，归属于“CombatMission（作战任务）”类。
:CommandControlMission rdf:type owl:Class ;
                       rdfs:subClassOf :CombatMission ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :finishStartPrecedes ;
                                         owl:someValuesFrom :StrikeMission
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :requiresCapability ;
                                         owl:someValuesFrom :CommandControlCapability
                                       ] ;
                       rdfs:label "指控任务"@zh .


###  http://example.org/killweb#CommandControlPlatform
# 构建“CommandControlPlatform（指控平台）”类，归属于“CommandControlEquipment（指控装备）”类。
:CommandControlPlatform rdf:type owl:Class ;
                        rdfs:subClassOf :CommandControlEquipment ,
                                        :EquipmentPlatform ;
                        rdfs:comment "扩展子类：舰艇编队指控中心等承载指控节点的平台。论文表 2 把这类指控机构也归入指控装备。"@zh ;
                        rdfs:label "指控平台"@zh .


###  http://example.org/killweb#CommunicationCapability
# 构建“CommunicationCapability（通信能力）”类，归属于“CommandControlCapability（指控能力）”类。
:CommunicationCapability rdf:type owl:Class ;
                         rdfs:subClassOf :CommandControlCapability ;
                         rdfs:label "通信能力"@zh .


###  http://example.org/killweb#DecisionCapability
# 构建“DecisionCapability（决策能力）”类，归属于“CommandControlCapability（指控能力）”类。
:DecisionCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CommandControlCapability ;
                    rdfs:label "决策能力"@zh .


###  http://example.org/killweb#DecisionEquipment
# 构建“DecisionEquipment（决策装备）”类，归属于“CommandControlEquipment（指控装备）”类。
:DecisionEquipment rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlEquipment ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :DecisionCapability
                                   ] ;
                   rdfs:label "决策装备"@zh .


###  http://example.org/killweb#DecisionMission
# 构建“DecisionMission（决策任务（D 决策））”类，归属于“CommandControlMission（指控任务）”类。
:DecisionMission rdf:type owl:Class ;
                 rdfs:subClassOf :CommandControlMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :finishStartPrecedes ;
                                   owl:someValuesFrom :StrikeMission
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :DecisionCapability
                                 ] ;
                 rdfs:label "决策任务（D 决策）"@zh .


###  http://example.org/killweb#EquipmentPlatform
# 构建“EquipmentPlatform（装备平台）”类，归属于“WeaponEquipment（武器装备）”类。
:EquipmentPlatform rdf:type owl:Class ;
                   rdfs:subClassOf :WeaponEquipment ;
                   rdfs:comment "扩展类：承载传感器、指控节点或弹药的飞机、舰艇、车辆、发射架等平台。"@zh ;
                   rdfs:label "装备平台"@zh .


###  http://example.org/killweb#EvaluationCapability
# 构建“EvaluationCapability（评估能力）”类，归属于“CommandControlCapability（指控能力）”类。
:EvaluationCapability rdf:type owl:Class ;
                      rdfs:subClassOf :CommandControlCapability ;
                      rdfs:label "评估能力"@zh .


###  http://example.org/killweb#JudgmentCapability
# 构建“JudgmentCapability（判断能力）”类，归属于“CommandControlCapability（指控能力）”类。
:JudgmentCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CommandControlCapability ;
                    rdfs:label "判断能力"@zh .


###  http://example.org/killweb#JudgmentEquipment
# 构建“JudgmentEquipment（判断装备）”类，归属于“CommandControlEquipment（指控装备）”类。
:JudgmentEquipment rdf:type owl:Class ;
                   rdfs:subClassOf :CommandControlEquipment ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :JudgmentCapability
                                   ] ;
                   rdfs:label "判断装备"@zh .


###  http://example.org/killweb#JudgmentMission
# 构建“JudgmentMission（判断任务（O2 判断））”类，归属于“CommandControlMission（指控任务）”类。
:JudgmentMission rdf:type owl:Class ;
                 rdfs:subClassOf :CommandControlMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :finishStartPrecedes ;
                                   owl:someValuesFrom :DecisionMission
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :JudgmentCapability
                                 ] ;
                 rdfs:label "判断任务（O2 判断）"@zh .


###  http://example.org/killweb#KillChain
# 构建“KillChain（杀伤链）”类，定义该概念的相关信息和约束。
:KillChain rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :chainTarget ;
                             owl:someValuesFrom :Target
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :CommandChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :ReconChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :StrikeChainNode
                           ] ;
           rdfs:comment "1.6/2.x 扩展：由作战目标、侦察、指控、打击节点构成的闭合打击链路。第 6 节的 someValuesFrom 公理只要求存在相应角色节点和目标，不校验节点顺序、连通性、闭环和资源冲突。"@zh ;
           rdfs:label "杀伤链"@zh .


###  http://example.org/killweb#KillWeb
# 构建“KillWeb（杀伤网）”类，定义该概念的相关信息和约束。
:KillWeb rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasChain ;
                           owl:someValuesFrom :KillChain
                         ] ;
         rdfs:comment "1.6/2.x 扩展：多条杀伤链通过共享节点和协同关系形成的分布式作战网络。"@zh ;
         rdfs:label "杀伤网"@zh .


###  http://example.org/killweb#OperationalRequirement
# 构建“OperationalRequirement（作战需求）”类，定义该概念的相关信息和约束。
:OperationalRequirement rdf:type owl:Class ;
                        rdfs:comment "在一定的时期，为完成可能担负的作战任务，对武装力量建设的基本要求。暂时只建立需求与任务、能力、装备的关系。"@zh ;
                        rdfs:label "作战需求"@zh .


###  http://example.org/killweb#ParallelRelation
# 构建“ParallelRelation（并行关系）”类，归属于“ChainRelation（链间协同关系）”类。
:ParallelRelation rdf:type owl:Class ;
                  rdfs:subClassOf :ChainRelation ;
                  rdfs:label "并行关系"@zh .


###  http://example.org/killweb#ReconCapability
# 构建“ReconCapability（侦察能力）”类，归属于“CombatCapability（作战能力）”类。
:ReconCapability rdf:type owl:Class ;
                 rdfs:subClassOf :CombatCapability ;
                 rdfs:label "侦察能力"@zh .


###  http://example.org/killweb#ReconChainNode
# 构建“ReconChainNode（侦察链节点）”类，归属于“ChainNode（杀伤链节点）”类。
:ReconChainNode rdf:type owl:Class ;
                rdfs:subClassOf :ChainNode ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :nodeEquipment ;
                                  owl:someValuesFrom :ReconEquipment
                                ] ;
                rdfs:label "侦察链节点"@zh .


###  http://example.org/killweb#ReconEquipment
# 构建“ReconEquipment（侦察装备）”类，归属于“WeaponEquipment（武器装备）”类。
:ReconEquipment rdf:type owl:Class ;
                rdfs:subClassOf :WeaponEquipment ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasCapability ;
                                  owl:someValuesFrom :ReconCapability
                                ] ;
                rdfs:comment "侦察监视类单元平台，承担发现、搜集作战空间信息并回传的任务；包括预警机、侦察机、防空雷达、侦察卫星等。传感器载荷和侦察平台都归入此类。"@zh ;
                rdfs:label "侦察装备"@zh .


###  http://example.org/killweb#ReconMission
# 构建“ReconMission（侦察任务（O1 观察））”类，归属于“CombatMission（作战任务）”类。
:ReconMission rdf:type owl:Class ;
              rdfs:subClassOf :CombatMission ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :finishStartPrecedes ;
                                owl:someValuesFrom :CommandControlMission
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :finishStartPrecedes ;
                                owl:someValuesFrom :JudgmentMission
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :requiresCapability ;
                                owl:someValuesFrom :ReconCapability
                              ] ;
              rdfs:label "侦察任务（O1 观察）"@zh .


###  http://example.org/killweb#ReconPlatform
# 构建“ReconPlatform（侦察平台）”类，归属于“EquipmentPlatform（装备平台）”类。
:ReconPlatform rdf:type owl:Class ;
               rdfs:subClassOf :EquipmentPlatform ,
                               :ReconEquipment ;
               rdfs:comment "扩展子类：预警机、侦察机、侦察卫星等承载侦察载荷的平台。论文表 2 把这类单元平台也归入侦察装备。"@zh ;
               rdfs:label "侦察平台"@zh .


###  http://example.org/killweb#ReconRangeCapability
# 构建“ReconRangeCapability（侦察距离能力）”类，归属于“ReconCapability（侦察能力）”类。
:ReconRangeCapability rdf:type owl:Class ;
                      rdfs:subClassOf :ReconCapability ;
                      rdfs:label "侦察距离能力"@zh .


###  http://example.org/killweb#ReconTargetTypeCapability
# 构建“ReconTargetTypeCapability（侦察目标类型能力）”类，归属于“ReconCapability（侦察能力）”类。
:ReconTargetTypeCapability rdf:type owl:Class ;
                           rdfs:subClassOf :ReconCapability ;
                           rdfs:label "侦察目标类型能力"@zh .


###  http://example.org/killweb#SerialRelation
# 构建“SerialRelation（串行关系）”类，归属于“ChainRelation（链间协同关系）”类。
:SerialRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "串行关系"@zh .


###  http://example.org/killweb#StrikeAltitudeCapability
# 构建“StrikeAltitudeCapability（打击高度能力）”类，归属于“StrikeCapability（打击能力）”类。
:StrikeAltitudeCapability rdf:type owl:Class ;
                          rdfs:subClassOf :StrikeCapability ;
                          rdfs:label "打击高度能力"@zh .


###  http://example.org/killweb#StrikeAmmunition
# 构建“StrikeAmmunition（打击弹药）”类，归属于“StrikeEquipment（打击装备）”类。
:StrikeAmmunition rdf:type owl:Class ;
                  rdfs:subClassOf :StrikeEquipment ;
                  rdfs:comment "扩展类：导弹、炸弹等一次性或可消耗的打击载荷。弹药可以通过 mountedOn 关联平台，但本类不强制所有实例都已挂载。"@zh ;
                  rdfs:label "打击弹药"@zh .


###  http://example.org/killweb#StrikeCapability
# 构建“StrikeCapability（打击能力）”类，归属于“CombatCapability（作战能力）”类。
:StrikeCapability rdf:type owl:Class ;
                  rdfs:subClassOf :CombatCapability ;
                  rdfs:label "打击能力"@zh .


###  http://example.org/killweb#StrikeChainNode
# 构建“StrikeChainNode（打击链节点）”类，归属于“ChainNode（杀伤链节点）”类。
:StrikeChainNode rdf:type owl:Class ;
                 rdfs:subClassOf :ChainNode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :nodeEquipment ;
                                   owl:someValuesFrom :StrikeEquipment
                                 ] ;
                 rdfs:comment "节点装备取打击装备，既可以是发射平台，也可以是弹药。"@zh ;
                 rdfs:label "打击链节点"@zh .


###  http://example.org/killweb#StrikeEquipment
# 构建“StrikeEquipment（打击装备）”类，归属于“WeaponEquipment（武器装备）”类。
:StrikeEquipment rdf:type owl:Class ;
                 rdfs:subClassOf :WeaponEquipment ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasCapability ;
                                   owl:someValuesFrom :StrikeCapability
                                 ] ;
                 rdfs:comment "功能角色类：既包括打击平台，也包括打击弹药。论文表 3 的打击属性定义域为本类；StrikeAmmunition 作为其子类继承这些属性。"@zh ;
                 rdfs:label "打击装备"@zh .


###  http://example.org/killweb#StrikeMission
# 构建“StrikeMission（打击任务（A 行动））”类，归属于“CombatMission（作战任务）”类。
:StrikeMission rdf:type owl:Class ;
               rdfs:subClassOf :CombatMission ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :requiresCapability ;
                                 owl:someValuesFrom :StrikeCapability
                               ] ;
               rdfs:label "打击任务（A 行动）"@zh .


###  http://example.org/killweb#StrikePlatform
# 构建“StrikePlatform（打击平台）”类，归属于“EquipmentPlatform（装备平台）”类。
:StrikePlatform rdf:type owl:Class ;
                rdfs:subClassOf :EquipmentPlatform ,
                                :StrikeEquipment ;
                rdfs:comment "扩展子类：战斗机、防空系统、舰艇等可发射或投放打击弹药的平台。平台归入打击装备是论文的建模方式；弹药是消耗性载荷。"@zh ;
                rdfs:label "打击平台"@zh .


