{
  "task_rules": [],
  "artifact_rules": [
    {
      "id": "insight-range",
      "role": "insight",
      "capability": "http://example.org/arcaneweb#AirInsightCapability",
      "when": [
        {
          "field": "artifact.max_range",
          "op": "ge",
          "ref": "context.target_distance"
        },
        {
          "field": "artifact.ontology_capabilities",
          "op": "contains",
          "value": "http://example.org/arcaneweb#AirInsightCapability"
        }
      ],
      "source_refs": [
        "虚构链网技术配置；能力名称使用主本体规范词项，不据此证明资源实际具备该能力"
      ],
      "blocking_issue_ids": []
    },
    {
      "id": "coordination-supported",
      "role": "coordination",
      "capability": "http://example.org/arcaneweb#RapidResponseCoordinationCapability",
      "when": [
        {
          "field": "artifact.ontology_capabilities",
          "op": "contains",
          "value": "http://example.org/arcaneweb#RapidResponseCoordinationCapability"
        }
      ],
      "source_refs": [
        "虚构链网技术配置；能力名称使用主本体规范词项，不据此证明资源实际具备该能力"
