    {
      "id": "near-artifact",
      "role": "manifestation",
      "capability": "http://example.org/arcaneweb#ShortRangeManifestationCapability",
      "when": [
        {
          "field": "artifact.min_range",
          "op": "lt",
          "ref": "context.target_distance"
        },
        {
          "field": "artifact.max_range",
          "op": "gt",
          "ref": "context.target_distance"
        },
        {
          "field": "artifact.ontology_capabilities",
          "op": "contains",
          "value": "http://example.org/arcaneweb#ShortRangeManifestationCapability"
        }
      ],
      "source_refs": [
        "虚构链网技术配置；能力名称使用主本体规范词项，不据此证明资源实际具备该能力"
