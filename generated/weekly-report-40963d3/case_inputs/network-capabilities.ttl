@prefix kw: <http://example.org/arcaneweb#> .
@prefix n: <urn:network-demo:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
n:ontology a owl:Ontology ; rdfs:comment "人工应用示例的显式知识，非原文逐项程序设计"@zh .
n:Orb a owl:Class ; rdfs:subClassOf n:SupportedTarget ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:Target [ a owl:Restriction ; owl:onProperty kw:targetType ; owl:hasValue "幽光法球"^^xsd:string ] ) ] .
n:Spirit a owl:Class ; rdfs:subClassOf n:SupportedTarget ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:Target [ a owl:Restriction ; owl:onProperty kw:targetType ; owl:hasValue "飞行灵体"^^xsd:string ] ) ] .
n:SupportedTarget a owl:Class .
n:Mission a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:ArcaneMission [ a owl:Restriction ; owl:onProperty kw:hasTarget ; owl:someValuesFrom n:SupportedTarget ] ) ] ; rdfs:subClassOf
 [ a owl:Restriction ; owl:onProperty kw:requiresCapability ; owl:hasValue kw:AirInsightCapability ],
 [ a owl:Restriction ; owl:onProperty kw:requiresCapability ; owl:hasValue kw:RapidResponseCoordinationCapability ],
 [ a owl:Restriction ; owl:onProperty kw:requiresCapability ; owl:hasValue kw:AirManifestationCapability ] .
n:InsightUnit a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:InsightArtifact [ a owl:Restriction ; owl:onProperty kw:hasCapability ; owl:hasValue kw:AirInsightCapability ] ) ] .
n:CoordinationUnit a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:CoordinationArtifact [ a owl:Restriction ; owl:onProperty kw:hasCapability ; owl:hasValue kw:RapidResponseCoordinationCapability ] ) ] .
n:EffectUnit a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( kw:ManifestationArtifact [ a owl:Restriction ; owl:onProperty kw:hasCapability ; owl:hasValue kw:AirManifestationCapability ] ) ] .
