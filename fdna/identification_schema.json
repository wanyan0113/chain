{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "id", "basis", "data_kind", "case_sha256", "structure_sha256", "focus_receivers", "evidence", "interactions"],
  "properties": {
    "format_version": {"const": "1.0"}, "id": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"},
    "data_kind": {"enum": ["method_check", "source_annotation", "observations"]},
    "case_sha256": {"$ref": "#/$defs/hash"}, "structure_sha256": {"$ref": "#/$defs/hash"},
    "focus_receivers": {"$ref": "#/$defs/ids"},
    "evidence": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "locator", "basis", "source_refs"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["interaction", "effect"]},
        "locator": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}, "source_refs": {"$ref": "#/$defs/ids"}}
    }},
    "interactions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "context", "feeder_activity", "receiver_activity", "feeder", "receiver", "interaction_evidence", "effect", "effect_evidence", "review", "review_basis"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "context": {"$ref": "#/$defs/text"},
        "feeder_activity": {"$ref": "#/$defs/text"}, "receiver_activity": {"$ref": "#/$defs/text"},
        "feeder": {"$ref": "#/$defs/text"}, "receiver": {"$ref": "#/$defs/text"},
        "interaction_evidence": {"$ref": "#/$defs/ids"},
        "effect": {"enum": ["supported", "not_obvious", "unknown"]},
        "effect_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "review": {"enum": ["include", "exclude", "pending"]}, "review_basis": {"$ref": "#/$defs/text"}
      }
    }}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
