{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": ["number", "null"], "minimum": 0},
    "scalar": {"type": ["number", "string", "null"]},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["value", "unit"],
      "properties": {"value": {"$ref": "#/$defs/scalar"}, "unit": {"$ref": "#/$defs/text"}}},
    "variable": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "category", "target_kind", "targets", "unit", "basis", "source_refs"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"},
        "category": {"enum": ["method", "performance", "environment"]},
        "target_kind": {"enum": ["subject", "target", "capability"]},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "unit": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "basis": {"$ref": "#/$defs/text"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["name", "value", "unit"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "value": {"$ref": "#/$defs/scalar"}, "unit": {"$ref": "#/$defs/text"}}},
    "event": {"type": "object", "additionalProperties": false,
      "required": ["id", "activity", "capability", "subject", "start", "end", "time_unit", "outcome", "facts", "source_locator"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "activity": {"$ref": "#/$defs/text"},
        "capability": {"$ref": "#/$defs/text"}, "subject": {"$ref": "#/$defs/text"},
        "start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}, "time_unit": {"$ref": "#/$defs/text"},
        "outcome": {"enum": ["completed", "incomplete", "unknown"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "source_locator": {"$ref": "#/$defs/text"}}},
    "closure": {"type": "object", "additionalProperties": false,
      "required": ["id", "attempt", "task", "target", "status", "start", "end", "events", "source_locator"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "attempt": {"$ref": "#/$defs/text"},
        "task": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"},
        "status": {"enum": ["closed", "incomplete", "unknown"]},
        "start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "source_locator": {"$ref": "#/$defs/text"}}},
    "plan": {"type": "object", "additionalProperties": false,
      "required": ["format_version", "id", "basis", "data_kind", "case_sha256", "structure_sha256", "variables"],
      "properties": {"format_version": {"const": "1.0"}, "id": {"$ref": "#/$defs/text"},
        "basis": {"$ref": "#/$defs/text"}, "data_kind": {"enum": ["source_configuration", "method_check"]},
        "case_sha256": {"$ref": "#/$defs/hash"}, "structure_sha256": {"$ref": "#/$defs/hash"},
        "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}}}},
    "batch": {"type": "object", "additionalProperties": false,
      "required": ["format_version", "id", "data_kind", "reference", "plan_sha256", "time_unit", "runs"],
      "properties": {"format_version": {"const": "1.0"}, "id": {"$ref": "#/$defs/text"},
        "data_kind": {"enum": ["method_check", "user_supplied_records"]}, "reference": {"$ref": "#/$defs/text"},
        "plan_sha256": {"$ref": "#/$defs/hash"}, "time_unit": {"$ref": "#/$defs/text"},
        "runs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["id", "assignments", "closures", "source_locator"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "assignments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/assignment"}},
            "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}, "source_locator": {"$ref": "#/$defs/text"}}}}}}
  },
  "oneOf": [{"$ref": "#/$defs/plan"}, {"$ref": "#/$defs/batch"}]
}
