{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format_version", "case_id", "case_sha256", "basis", "source_locators", "policy", "system", "tasks", "activities", "functions", "function_dependencies"],
  "properties": {
    "format_version": {"const": "1.0"}, "case_id": {"$ref": "#/$defs/text"},
    "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "basis": {"$ref": "#/$defs/text"},
    "source_locators": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["source", "id", "label"], "properties": {"source": {"$ref": "#/$defs/text"},
        "id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}}}},
    "policy": {"type": "object", "additionalProperties": false,
      "required": ["activity_partition", "partition_confirmed", "group_timing", "function_identity", "dependency_parameters"],
      "properties": {"activity_partition": {"const": "outer_members_as_activity_slots"},
        "partition_confirmed": {"const": false}, "group_timing": {"const": "unspecified"},
        "function_identity": {"const": "constructed_from_rule6_bijection"}, "dependency_parameters": {"const": "not_transferred"}}},
    "system": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "represents", "chains", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "represents": {"const": "SoS"},
        "chains": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/derived"}}},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "chain", "target", "activity_order", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "chain": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"}, "activity_order": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/derived"}}}},
    "activities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "task", "type", "capability_group", "performers", "functions", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "task": {"$ref": "#/$defs/text"},
        "type": {"enum": ["R", "D", "E", null]}, "capability_group": {"$ref": "#/$defs/group"},
        "performers": {"$ref": "#/$defs/ids"}, "functions": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/interpretation"}}}},
    "functions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "label", "subject", "capability", "type", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "subject": {"$ref": "#/$defs/text"},
        "capability": {"$ref": "#/$defs/text"}, "type": {"enum": ["S", "D", "F"]}, "evidence": {"$ref": "#/$defs/derived"}}}},
    "function_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "feeder", "receiver", "capability_feeder", "capability_receiver", "interaction_mechanism", "parameters", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "feeder": {"$ref": "#/$defs/text"}, "receiver": {"$ref": "#/$defs/text"},
        "capability_feeder": {"$ref": "#/$defs/text"}, "capability_receiver": {"$ref": "#/$defs/text"},
        "interaction_mechanism": {"type": "null"}, "parameters": {"type": "null"}, "evidence": {"$ref": "#/$defs/derived"}}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "group": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/group"}]}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "source_refs", "basis"],
      "properties": {"kind": {"enum": ["derived", "interpretation"]}, "source_refs": {"$ref": "#/$defs/ids"}, "basis": {"$ref": "#/$defs/text"}}},
    "derived": {"allOf": [{"$ref": "#/$defs/evidence"}, {"properties": {"kind": {"const": "derived"}}}]},
    "interpretation": {"allOf": [{"$ref": "#/$defs/evidence"}, {"properties": {"kind": {"const": "interpretation"}}}]}
  }
}
