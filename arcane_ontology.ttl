#    0.7 文献对照与说明目录
# 以下 AnnotationProperty 用于描述术语，不参与 domain/range 或业务关系推理。

:sourceSection a owl:AnnotationProperty ;
    rdfs:label "参考章节"@zh ;
    rdfs:comment "用户提供的截图中的章节或表号；属于来源定位，不表示逐字转录。"@zh .
:correspondsToPhase a owl:AnnotationProperty ;
    rdfs:label "对应 OODA 阶段"@zh ;
    rdfs:comment "类或术语的阶段标注；不是实例执行顺序，也不自动传播到实例。"@zh .
:unitSymbol a owl:AnnotationProperty ;
    rdfs:label "单位符号"@zh ;
    rdfs:comment "描述数据属性的单位；不执行单位换算。1 表示无量纲。"@zh .
:semanticNote a owl:AnnotationProperty ;
    rdfs:label "建模口径说明"@zh .
:formulaText a owl:AnnotationProperty ;
    rdfs:label "公式文本"@zh ;
    rdfs:comment "来源中的数学表达式的文本记录；不是 SWRL、SPARQL 或可执行代码。"@zh .

:OODAPhase a owl:Class ;
    rdfs:label "OODA 阶段"@zh ;
    :sourceSection "第一部分 OODA 扩展说明" ;
    rdfs:comment "用于文献阶段对照的词表。阶段循环与一次任务执行的依赖图分开表达。"@zh .
:ObservePhase a owl:NamedIndividual, :OODAPhase ;
    rdfs:label "O1 探知（Observe）"@zh .
:OrientPhase a owl:NamedIndividual, :OODAPhase ;
    rdfs:label "O2 研判（Orient）"@zh .
:DecidePhase a owl:NamedIndividual, :OODAPhase ;
    rdfs:label "D 决断（Decide）"@zh .
:ActPhase a owl:NamedIndividual, :OODAPhase ;
    rdfs:label "A 施法（Act）"@zh .

:ArcaneMission :sourceSection "1.1 表 1；1.4 表 5" .
:ArcaneCapability :sourceSection "1.1 表 1；1.3 表 4" .
:Artifact :sourceSection "1.1 表 1；1.2 表 2、表 3" ;
    :semanticNote "灵视探知、协调、具现是功能角色，可由同一实体兼任，不设为两两互斥；平台/挂载物是另一分类维度。"@zh .
:ElementalFieldSituation :sourceSection "1.1 表 1" ;
    :semanticNote "目前只表达态势与任务、能力和目标的关联，未提供元素种类、魔力场或环境数值模型。"@zh .
:InvocationRequirement :sourceSection "1.1 表 1" ;
    :semanticNote "需求关系的存在不代表已通过满足性判定；截图未定义结构化阈值字段，本轮不自行编造阈值。"@zh .

:InsightArtifact :sourceSection "1.2 表 2、表 3" ; :correspondsToPhase :ObservePhase .
:JudgmentArtifact :sourceSection "1.2 OODA 细分" ; :correspondsToPhase :OrientPhase ;
    rdfs:altLabel "研判法器"@zh .
:DecisionArtifact :sourceSection "1.2 OODA 细分" ; :correspondsToPhase :DecidePhase .
:ManifestationArtifact :sourceSection "1.2 表 2、表 3" ; :correspondsToPhase :ActPhase .
:CoordinationArtifact :sourceSection "1.2 表 2、表 3" ;
    :semanticNote "协调层覆盖研判和决断两个阶段；父类本身不绑定单一阶段。"@zh .

:InsightCapability :sourceSection "1.3 表 4" ; :correspondsToPhase :ObservePhase .
:JudgmentCapability :sourceSection "1.3 OODA 细分" ; :correspondsToPhase :OrientPhase ;
    rdfs:altLabel "研判能力"@zh .
:DecisionCapability :sourceSection "1.3 OODA 细分" ; :correspondsToPhase :DecidePhase .
:ManifestationCapability :sourceSection "1.3 表 4" ; :correspondsToPhase :ActPhase .
:CoordinationCapability :sourceSection "1.3 表 4" .
:CommunicationCapability :sourceSection "1.3 表 4" .
:OrchestrationCapability :sourceSection "1.3 表 4" .
:EvaluationCapability :sourceSection "1.3 表 4" ;
    :semanticNote "解析能力按表 4 保留在协调能力下。与 JudgmentCapability 相关，但截图未给出等价或包含公理，故不自动合并。"@zh .

:InsightMission :sourceSection "1.4" ; :correspondsToPhase :ObservePhase .
:JudgmentMission :sourceSection "1.4" ; :correspondsToPhase :OrientPhase ;
    rdfs:altLabel "研判任务"@zh .
:DecisionMission :sourceSection "1.4" ; :correspondsToPhase :DecidePhase .
:ManifestationMission :sourceSection "1.4" ; :correspondsToPhase :ActPhase .
:CoordinationMission :sourceSection "1.4" ;
    :semanticNote "0.7 将具体任务的后继关系从类的存在性限制中移出。类型表示任务职责，不强制每个任务都有后续具现任务。"@zh .
:finishStartPrecedes :sourceSection "1.4 时序表达（项目扩展属性）" ;
    :semanticNote "用于具体任务实例的完成—开始依赖。OODA 阶段循环不等于 nextNode 或依赖图必须成环；截图中引用的图 5 图形本轮未提供。"@zh .

:hasCapability :sourceSection "1.1；2.1.1" ;
    :semanticNote "表示法器具有某项能力，不自动推导其数值性能满足某个任务。"@zh .
:requiresCapability :sourceSection "1.1；2.1.1" ;
    :semanticNote "表示任务所需能力；声明该关系与由规则计算该关系是两个步骤。"@zh .
:ChainNode :sourceSection "项目扩展：链内参与节点" ;
    :semanticNote "同一法器参与不同链时，应分别建立节点，再通过 nodeArtifact 指向同一法器；避免共享节点导致顺序混淆。"@zh .
:SpellChain :sourceSection "2.1 步骤 2（项目结构化扩展）" .
:ArcaneWeb :sourceSection "2.1 步骤 3（项目结构化扩展）" .
:ChainRelation :sourceSection "2.1.3（项目结构化扩展）" .
:ArtifactPlatform :sourceSection "项目扩展：承载平台" .
:CrystalVessel :sourceSection "项目扩展：可消耗挂载物" .

# 单位采用现有 IRI 的单位约定，不因魔法化显示名称而改变。
:latitudeDeg :unitSymbol "deg" .
:longitudeDeg :unitSymbol "deg" .
:altitudeFt :unitSymbol "ft" .
:speedKn :unitSymbol "kn" .
:detectionRangeNm :unitSymbol "nmi" .
:distanceResolutionM :unitSymbol "m" .
:azimuthCoverageDeg :unitSymbol "deg" .
:elevationCoverageDeg :unitSymbol "deg" .
:azimuthResolutionDeg :unitSymbol "deg" .
:elevationResolutionDeg :unitSymbol "deg" .
:insightIntervalS :unitSymbol "s" ;
    :semanticNote "采样或灵视探知间隔不自动等于式（4）的阶段总耗时。"@zh .
:evaluationTimeS :unitSymbol "s" .
:evaluationAreaKm2 :unitSymbol "km2" .
:communicationBandwidthMbps :unitSymbol "Mbps" .
:communicationPowerW :unitSymbol "W" .
:relayDelayMs :unitSymbol "ms" .
:responseTimeS :unitSymbol "s" ;
    :semanticNote "响应时间是单项参数，不自动等于式（4）的完整施法阶段耗时。"@zh .
:manaRechargeTimeS :unitSymbol "s" .
:minRangeNm :unitSymbol "nmi" .
:maxRangeNm :unitSymbol "nmi" .
:disturbanceRadiusM :unitSymbol "m" .
:flightSpeedKn :unitSymbol "kn" .
:climbSpeedKn :unitSymbol "kn" .
:maxTargetSpeedKn :unitSymbol "kn" .
:flightAltitudeFt :unitSymbol "ft" .
:minActivationAltitudeFt :unitSymbol "ft" .
:maxActivationAltitudeFt :unitSymbol "ft" .
:minTargetAltitudeFt :unitSymbol "ft" .
:maxTargetAltitudeFt :unitSymbol "ft" .
:maxCommDistanceNm :unitSymbol "nmi" .
:missionTargetAltitudeFt :unitSymbol "ft" .
:missionTargetSpeedKn :unitSymbol "kn" .
:missionTargetLatitudeDeg :unitSymbol "deg" .
:missionTargetLongitudeDeg :unitSymbol "deg" .
:targetAltitudeFt :unitSymbol "ft" .
:targetSpeedKn :unitSymbol "kn" .
:targetLatitudeDeg :unitSymbol "deg" .
:targetLongitudeDeg :unitSymbol "deg" .
:targetDistanceNm :unitSymbol "nmi" .
:detectionPrecision :unitSymbol "1" ;
    :semanticNote "项目扩展的 0—1 汇总指标；表 3 的距离/角度误差不能未经定义就直接转换为此指标。标注本身不约束数值范围。"@zh .
:attunementProbability :unitSymbol "1" ;
    :semanticNote "灵性锁定概率与式（5）的阶段精度不是已声明的同一指标。"@zh .
:disturbanceRate :unitSymbol "1" .
:cost :semanticNote "使用成本。表 3 在具现法器行列出附魔造价，本项目将成本提升到法器父类以统一描述。币种和计价基准须由实例数据明确，不能默认是采购价。"@zh .
:missionTargetType :semanticNote "来源类别编码与显示名称分开；背景化显示名不自动改变来源类别编码。"@zh .
:missionTime :semanticNote "任务时间使用 xsd:dateTime；它是时间点，不是持续时间。"@zh .
:nodeOrder :semanticNote "序号为整数不代表唯一、从 1 开始或连续；这些是实例数据校验要求。"@zh .

# 规则描述目录：只记录来源、类别和语义，不产生候选法器或链网。
:DesignRuleDescription a owl:Class ; rdfs:label "设计规则说明"@zh .
:TaskCapabilityRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;
    rdfs:label "任务—能力映射规则说明"@zh ; :sourceSection "2.1.1；式（1）" ;
    rdfs:comment "描述任务属性条件与所需能力之间的条件关系；条件阈值未在截图中完整给出。"@zh .
:CapabilityArtifactRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;
    rdfs:label "能力—法器映射规则说明"@zh ; :sourceSection "2.1.1；式（2）" ;
    rdfs:comment "描述能力需求与法器属性条件的映射；本目录不进行法器筛选。"@zh .
:ArtifactCooperationRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;
    rdfs:label "法器协同规则说明"@zh ; :sourceSection "2.1.2；式（3）" ;
    rdfs:comment "描述协同条件的合取；成对条件成立不自动证明整条链有序、连通或不存在资源冲突。"@zh .
:ChainCooperationRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;
    rdfs:label "法术链协同规则说明"@zh ; :sourceSection "2.1.3" ;
    rdfs:comment "来源描述并行、串行、分支和资源共享。本体中的关系实例只记录组合，不自动验证容量、占用时间或消耗性资源约束。"@zh .

# 数学式文本目录：编号沿用截图；不给未出现的时间/精度分项补造定义。
:FormulaDescription a owl:Class ; rdfs:label "公式说明"@zh .
:Formula01 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（1）条件—能力表达"@zh ; :sourceSection "2.1.1；式（1）" ;
    :formulaText "(t_i^1 AND t_i^2 AND ... AND t_i^n) -> c_i" ;
    :semanticNote "按截图合取含义记录。截图中的交集符号用于条件同时成立；并非完整的一阶逻辑或可执行 OWL 规则语法。"@zh .
:Formula02 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（2）条件—资源表达"@zh ; :sourceSection "2.1.1；式（2）" ;
    :formulaText "(c_i^1 AND c_i^2 AND ... AND c_i^n) -> w_i" .
:Formula03 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（3）协同条件表达"@zh ; :sourceSection "2.1.2；式（3）" ;
    :formulaText "(w_ij^1 AND w_ij^2 AND ... AND w_ij^n) -> l_k" ;
    :semanticNote "截图写法省略了整条链的参与者量化和全局条件；不能把任意一对资源满足条件等同于链构造完成。"@zh .
:Formula04 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（4）总时间"@zh ; :sourceSection "评估指标；式（4）" ;
    :formulaText "T = T_o + T_d + T_a" ;
    :semanticNote "三个阶段耗时相加；来源暂不考虑传讯类法器。只在阶段不重叠且计量口径一致时按该式解释。"@zh .
:Formula05 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（5）总精度"@zh ; :sourceSection "评估指标；式（5）" ;
    :formulaText "A = A_o * A_d * A_a" ;
    :semanticNote "来源采用阶段精度乘积。阶段指标的标度、获取方式和合成适用性须另行定义，不能自动解释为经过验证的联合概率。"@zh .
:Formula06 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（6）总成本"@zh ; :sourceSection "评估指标；式（6）" ;
    :formulaText "C = C_o + C_d + C_a" ;
    :semanticNote "按一致币种和使用成本口径求和；多条链共享资源时，截图没有给出网络级成本去重规则。"@zh .
:Formula07 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（7）时间归一化"@zh ; :sourceSection "评估指标；式（7）" ;
    :formulaText "T_prime = 1 - (T - min(T)) / (max(T) - min(T))" .
:Formula08 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（8）精度归一化"@zh ; :sourceSection "评估指标；式（8）" ;
    :formulaText "A_prime = (A - min(A)) / (max(A) - min(A))" .
:Formula09 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（9）成本归一化"@zh ; :sourceSection "评估指标；式（9）" ;
    :formulaText "C_prime = 1 - (C - min(C)) / (max(C) - min(C))" .
:Formula10 a owl:NamedIndividual, :FormulaDescription ;
    rdfs:label "式（10）加权评分"@zh ; :sourceSection "评估指标；式（10）" ;
    :formulaText "P = w_1 * T_prime + w_2 * A_prime + w_3 * C_prime" ;
    :semanticNote "来源要求每个权重属于 [0,1] 且权重和为 1；三个归一化值须使用同一比较集合。截图未规定 max=min 时的处理，本体不自行设定得分。"@zh .

