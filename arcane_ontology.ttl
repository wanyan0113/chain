               rdfs:label "吟唱耗时（秒）"@zh .


###  http://example.org/arcaneweb#multiCastCount
# 定义“multiCastCount（多重施法连发数）”数据属性，记录ManifestationArtifact（具现法器）的多重施法连发数，值类型为 xsd:integer。
:multiCastCount rdf:type owl:DatatypeProperty ;
           rdfs:domain :ManifestationArtifact ;
           rdfs:range xsd:integer ;
           rdfs:label "多重施法连发数"@zh .


###  http://example.org/arcaneweb#speedKn
# 定义“speedKn（飞行极速（迅捷度））”数据属性，记录Artifact（法器）的飞行极速（迅捷度），值类型为 xsd:decimal。
:speedKn rdf:type owl:DatatypeProperty ;
         rdfs:domain :Artifact ;
         rdfs:range xsd:decimal ;
         rdfs:label "飞行极速（迅捷度）"@zh .


###  http://example.org/arcaneweb#manifestationTargetType
# 定义“manifestationTargetType（具现目标类型）”数据属性，记录ManifestationArtifact（具现法器）的具现目标类型，值类型为 xsd:string。
:manifestationTargetType rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ManifestationArtifact ;
                  rdfs:range xsd:string ;
                  rdfs:label "具现目标类型"@zh .


###  http://example.org/arcaneweb#targetAltitudeFt
# 定义“targetAltitudeFt（目标高度（尺））”数据属性，记录Target（交互目标）的目标高度（尺），值类型为 xsd:decimal。
:targetAltitudeFt rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Target ;
                  rdfs:range xsd:decimal ;
                  rdfs:label "目标高度（尺）"@zh .


###  http://example.org/arcaneweb#targetDistanceNm
# 定义“targetDistanceNm（目标距离（里））”数据属性，记录ArcaneMission（行动任务）的目标距离（里），值类型为 xsd:decimal。
:targetDistanceNm rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ArcaneMission ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "扩展：表 5 之外补充的目标距离字段。"@zh ;
                  rdfs:label "目标距离（里）"@zh .


###  http://example.org/arcaneweb#targetLatitudeDeg
# 定义“targetLatitudeDeg（目标星象坐标（纬））”数据属性，记录Target（交互目标）的目标星象坐标（纬），值类型为 xsd:decimal。
:targetLatitudeDeg rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Target ;
                   rdfs:range xsd:decimal ;
                   rdfs:label "目标星象坐标（纬）"@zh .


###  http://example.org/arcaneweb#targetLongitudeDeg
# 定义“targetLongitudeDeg（目标星象坐标（经））”数据属性，记录Target（交互目标）的目标星象坐标（经），值类型为 xsd:decimal。
:targetLongitudeDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Target ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "目标星象坐标（经）"@zh .


###  http://example.org/arcaneweb#targetSpeedKn
# 定义“targetSpeedKn（目标速度（迅捷度））”数据属性，记录Target（交互目标）的目标速度（迅捷度），值类型为 xsd:decimal。
:targetSpeedKn rdf:type owl:DatatypeProperty ;
               rdfs:domain :Target ;
               rdfs:range xsd:decimal ;
               rdfs:label "目标速度（迅捷度）"@zh .


###  http://example.org/arcaneweb#targetImpedanceThreshold
# 定义“targetImpedanceThreshold（目标阻抗阈值）”数据属性，记录Target（交互目标）的目标阻抗阈值，值类型为 xsd:decimal。
:targetImpedanceThreshold rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Target ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "目标侧的阻抗指标，沿用原版 targetImpedanceThreshold 的数值尺度和计算口径；“目标阻抗阈值”为背景化显示名称，不额外引入特定元素抗性或新的计算公式。"@zh ;
                     rdfs:label "目标阻抗阈值"@zh .


###  http://example.org/arcaneweb#targetType
# 定义“targetType（目标类型）”数据属性，记录Target（交互目标）的目标类型，值类型为 xsd:string。
:targetType rdf:type owl:DatatypeProperty ;
            rdfs:domain :Target ;
            rdfs:range xsd:string ;
            rdfs:label "目标类型"@zh .


#    Classes

###  http://example.org/arcaneweb#ElementalFieldSituation
# 构建“ElementalFieldSituation（元素场域态势）”类，定义该概念的相关信息和约束。
:ElementalFieldSituation rdf:type owl:Class ;
                      rdfs:comment "元素场域中魔力分布及元素环境的当前状态和发展变化趋势。"@zh ;
                      rdfs:label "元素场域态势"@zh .


###  http://example.org/arcaneweb#BranchRelation
# 构建“BranchRelation（分支法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:BranchRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "分支法阵"@zh .


###  http://example.org/arcaneweb#ChainNode
# 构建“ChainNode（法术链节点）”类，定义该概念的相关信息和约束。
:ChainNode rdf:type owl:Class ;
           rdfs:comment "1.6 扩展：用于表达节点顺序、职能和法器关联；本文件中它是法术链结构的唯一权威表示。"@zh ;
           rdfs:label "法术链节点"@zh .


###  http://example.org/arcaneweb#ChainRelation
# 构建“ChainRelation（法阵组合关系）”类，定义该概念的相关信息和约束。
:ChainRelation rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :relatedChain ;
                                 owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                 owl:onClass :SpellChain
                               ] ;
               rdfs:comment "2.1.3 扩展：以具体关系实例表达并列、串联、分支等法阵组合。并列法阵用 relatedChain 列出参与者，有向法阵用 fromChain/toChain 表示方向；不再使用法术链到法术链的直接属性。"@zh ;
               rdfs:label "法阵组合关系"@zh .


###  http://example.org/arcaneweb#ArcaneCapability
# 构建“ArcaneCapability（法术能力）”类，定义该概念的相关信息和约束。
:ArcaneCapability rdf:type owl:Class ;
                  rdfs:comment "法器执行行动任务的本领，是法器体系的固有属性，与型号、法术参数等有关。"@zh ;
                  rdfs:label "法术能力"@zh .


###  http://example.org/arcaneweb#ArcaneMission
# 构建“ArcaneMission（行动任务）”类，定义该概念的相关信息和约束。
:ArcaneMission rdf:type owl:Class ;
               rdfs:comment "奥术网为实现行动目标需要完成的各种任务的统称，包括探知、研判、决断、施法等。"@zh ;
               rdfs:label "行动任务"@zh .


###  http://example.org/arcaneweb#OrchestrationCapability
# 构建“OrchestrationCapability（统筹能力）”类，归属于“CoordinationCapability（协调能力）”类。
:OrchestrationCapability rdf:type owl:Class ;
                   rdfs:subClassOf :CoordinationCapability ;
                   rdfs:label "统筹能力"@zh .


###  http://example.org/arcaneweb#CoordinationChainNode
# 构建“CoordinationChainNode（协调链节点）”类，归属于“ChainNode（法术链节点）”类。
:CoordinationChainNode rdf:type owl:Class ;
                  rdfs:subClassOf :ChainNode ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :nodeArtifact ;
                                    owl:someValuesFrom :CoordinationArtifact
                                  ] ;
                  rdfs:label "协调链节点"@zh .


###  http://example.org/arcaneweb#CoordinationCapability
# 构建“CoordinationCapability（协调能力）”类，归属于“ArcaneCapability（法术能力）”类。
:CoordinationCapability rdf:type owl:Class ;
                          rdfs:subClassOf :ArcaneCapability ;
                          rdfs:label "协调能力"@zh .


###  http://example.org/arcaneweb#CoordinationArtifact
# 构建“CoordinationArtifact（协调法器）”类，归属于“Artifact（法器）”类。
:CoordinationArtifact rdf:type owl:Class ;
                         rdfs:subClassOf :Artifact ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasCapability ;
                                           owl:someValuesFrom :CoordinationCapability
                                         ] ;
                         rdfs:comment "各类协调机构，是奥术网的核心，对一切魔法活动执行决断；包括联合统筹中枢、浮空艇群组协调中枢等。"@zh ;
                         rdfs:label "协调法器"@zh .


###  http://example.org/arcaneweb#CoordinationMission
# 构建“CoordinationMission（协调任务）”类，归属于“ArcaneMission（行动任务）”类。
:CoordinationMission rdf:type owl:Class ;
                       rdfs:subClassOf :ArcaneMission ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :requiresCapability ;
                                         owl:someValuesFrom :CoordinationCapability
                                       ] ;
                       rdfs:label "协调任务"@zh .


###  http://example.org/arcaneweb#CoordinationPlatform
# 构建“CoordinationPlatform（协调平台）”类，归属于“CoordinationArtifact（协调法器）”类。
:CoordinationPlatform rdf:type owl:Class ;
                        rdfs:subClassOf :CoordinationArtifact ,
                                        :ArtifactPlatform ;
                        rdfs:comment "扩展子类：浮空艇群组协调中枢等承载协调节点的平台。论文表 2 把这类协调机构也归入协调法器。"@zh ;
                        rdfs:label "协调平台"@zh .


###  http://example.org/arcaneweb#CommunicationCapability
# 构建“CommunicationCapability（传讯能力）”类，归属于“CoordinationCapability（协调能力）”类。
:CommunicationCapability rdf:type owl:Class ;
                         rdfs:subClassOf :CoordinationCapability ;
                         rdfs:label "传讯能力"@zh .


###  http://example.org/arcaneweb#DecisionCapability
# 构建“DecisionCapability（决断能力）”类，归属于“CoordinationCapability（协调能力）”类。
:DecisionCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CoordinationCapability ;
                    rdfs:label "决断能力"@zh .


###  http://example.org/arcaneweb#DecisionArtifact
# 构建“DecisionArtifact（决断法器）”类，归属于“CoordinationArtifact（协调法器）”类。
:DecisionArtifact rdf:type owl:Class ;
                   rdfs:subClassOf :CoordinationArtifact ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :DecisionCapability
                                   ] ;
                   rdfs:label "决断法器"@zh .


###  http://example.org/arcaneweb#DecisionMission
# 构建“DecisionMission（决断任务（D 决断））”类，归属于“CoordinationMission（协调任务）”类。
:DecisionMission rdf:type owl:Class ;
                 rdfs:subClassOf :CoordinationMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :DecisionCapability
                                 ] ;
                 rdfs:label "决断任务（D 决断）"@zh .


###  http://example.org/arcaneweb#ArtifactPlatform
# 构建“ArtifactPlatform（承载平台）”类，归属于“Artifact（法器）”类。
:ArtifactPlatform rdf:type owl:Class ;
                   rdfs:subClassOf :Artifact ;
                   rdfs:comment "扩展类：承载感知装置、协调节点或魔晶载体的云翼灵兽、浮空艇、符文载具、施法台等平台。"@zh ;
                   rdfs:label "承载平台"@zh .


###  http://example.org/arcaneweb#EvaluationCapability
# 构建“EvaluationCapability（解析能力）”类，归属于“CoordinationCapability（协调能力）”类。
:EvaluationCapability rdf:type owl:Class ;
                      rdfs:subClassOf :CoordinationCapability ;
                      rdfs:label "解析能力"@zh .


###  http://example.org/arcaneweb#JudgmentCapability
# 构建“JudgmentCapability（占卜能力）”类，归属于“CoordinationCapability（协调能力）”类。
:JudgmentCapability rdf:type owl:Class ;
                    rdfs:subClassOf :CoordinationCapability ;
                    rdfs:label "占卜能力"@zh .


###  http://example.org/arcaneweb#JudgmentArtifact
# 构建“JudgmentArtifact（占卜法器）”类，归属于“CoordinationArtifact（协调法器）”类。
:JudgmentArtifact rdf:type owl:Class ;
                   rdfs:subClassOf :CoordinationArtifact ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasCapability ;
                                     owl:someValuesFrom :JudgmentCapability
                                   ] ;
                   rdfs:label "占卜法器"@zh .


###  http://example.org/arcaneweb#JudgmentMission
# 构建“JudgmentMission（占卜任务（O2 研判））”类，归属于“CoordinationMission（协调任务）”类。
:JudgmentMission rdf:type owl:Class ;
                 rdfs:subClassOf :CoordinationMission ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :requiresCapability ;
                                   owl:someValuesFrom :JudgmentCapability
                                 ] ;
                 rdfs:label "占卜任务（O2 研判）"@zh .


###  http://example.org/arcaneweb#SpellChain
# 构建“SpellChain（法术链）”类，定义该概念的相关信息和约束。
:SpellChain rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :chainTarget ;
                             owl:someValuesFrom :Target
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :CoordinationChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :InsightChainNode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasChainNode ;
                             owl:someValuesFrom :ManifestationChainNode
                           ] ;
           rdfs:comment "1.6/2.x 扩展：由交互目标、灵视探知、协调、具现节点构成的闭合施法链路。第 6 节的 someValuesFrom 公理只要求存在相应角色节点和目标，不校验节点顺序、连通性、闭环和资源冲突。"@zh ;
           rdfs:label "法术链"@zh .


###  http://example.org/arcaneweb#ArcaneWeb
# 构建“ArcaneWeb（奥术网）”类，定义该概念的相关信息和约束。
:ArcaneWeb rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasChain ;
                           owl:someValuesFrom :SpellChain
                         ] ;
         rdfs:comment "1.6/2.x 扩展：多条法术链通过共享节点和法阵组合关系形成的分布式施法网络。"@zh ;
         rdfs:label "奥术网"@zh .


###  http://example.org/arcaneweb#InvocationRequirement
# 构建“InvocationRequirement（施法需求）”类，定义该概念的相关信息和约束。
:InvocationRequirement rdf:type owl:Class ;
                        rdfs:comment "在一定的时期，为完成可能担负的行动任务，对魔法力量建设的基本要求。暂时只建立需求与行动任务、法术、法器的关系。"@zh ;
                        rdfs:label "施法需求"@zh .


###  http://example.org/arcaneweb#ParallelRelation
# 构建“ParallelRelation（并列法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:ParallelRelation rdf:type owl:Class ;
                  rdfs:subClassOf :ChainRelation ;
                  rdfs:label "并列法阵"@zh .


###  http://example.org/arcaneweb#InsightCapability
# 构建“InsightCapability（灵视探知能力）”类，归属于“ArcaneCapability（法术能力）”类。
:InsightCapability rdf:type owl:Class ;
                 rdfs:subClassOf :ArcaneCapability ;
                 rdfs:label "灵视探知能力"@zh .


###  http://example.org/arcaneweb#InsightChainNode
# 构建“InsightChainNode（灵视探知链节点）”类，归属于“ChainNode（法术链节点）”类。
:InsightChainNode rdf:type owl:Class ;
                rdfs:subClassOf :ChainNode ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :nodeArtifact ;
                                  owl:someValuesFrom :InsightArtifact
                                ] ;
                rdfs:label "灵视探知链节点"@zh .


###  http://example.org/arcaneweb#InsightArtifact
# 构建“InsightArtifact（灵视探知法器）”类，归属于“Artifact（法器）”类。
:InsightArtifact rdf:type owl:Class ;
                rdfs:subClassOf :Artifact ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasCapability ;
                                  owl:someValuesFrom :InsightCapability
                                ] ;
                rdfs:comment "灵视探知类单元平台，承担发现、搜集共鸣空间信息参数并回传的任务；包括感知魔像、探知魔像、探知法阵、星界探知镜等。感知挂载和灵视探知平台都归入此类。"@zh ;
                rdfs:label "灵视探知法器"@zh .


###  http://example.org/arcaneweb#InsightMission
# 构建“InsightMission（灵视探知任务（O1 探知））”类，归属于“ArcaneMission（行动任务）”类。
:InsightMission rdf:type owl:Class ;
              rdfs:subClassOf :ArcaneMission ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :requiresCapability ;
                                owl:someValuesFrom :InsightCapability
                              ] ;
              rdfs:label "灵视探知任务（O1 探知）"@zh .


###  http://example.org/arcaneweb#InsightPlatform
# 构建“InsightPlatform（灵视探知平台）”类，归属于“ArtifactPlatform（承载平台）”类。
:InsightPlatform rdf:type owl:Class ;
               rdfs:subClassOf :ArtifactPlatform ,
                               :InsightArtifact ;
               rdfs:comment "扩展子类：感知魔像、探知魔像、星界探知镜等承载灵视探知挂载的平台。论文表 2 把这类单元平台也归入灵视探知法器。"@zh ;
               rdfs:label "灵视探知平台"@zh .


###  http://example.org/arcaneweb#InsightRangeCapability
# 构建“InsightRangeCapability（感知距离能力）”类，归属于“InsightCapability（灵视探知能力）”类。
:InsightRangeCapability rdf:type owl:Class ;
                      rdfs:subClassOf :InsightCapability ;
                      rdfs:label "感知距离能力"@zh .


###  http://example.org/arcaneweb#InsightTargetTypeCapability
# 构建“InsightTargetTypeCapability（灵视探知目标类型能力）”类，归属于“InsightCapability（灵视探知能力）”类。
:InsightTargetTypeCapability rdf:type owl:Class ;
                           rdfs:subClassOf :InsightCapability ;
                           rdfs:label "灵视探知目标类型能力"@zh .


###  http://example.org/arcaneweb#SerialRelation
# 构建“SerialRelation（串联法阵）”类，归属于“ChainRelation（法阵组合关系）”类。
:SerialRelation rdf:type owl:Class ;
                rdfs:subClassOf :ChainRelation ;
                rdfs:label "串联法阵"@zh .


###  http://example.org/arcaneweb#ManifestationAltitudeCapability
# 构建“ManifestationAltitudeCapability（具现高度能力）”类，归属于“ManifestationCapability（具现能力）”类。
:ManifestationAltitudeCapability rdf:type owl:Class ;
                          rdfs:subClassOf :ManifestationCapability ;
                          rdfs:label "具现高度能力"@zh .


###  http://example.org/arcaneweb#CrystalVessel
# 构建“CrystalVessel（魔晶载体）”类，归属于“ManifestationArtifact（具现法器）”类。
:CrystalVessel rdf:type owl:Class ;
                  rdfs:subClassOf :ManifestationArtifact ;
                  rdfs:comment "扩展类：魔晶载体、辉光载体等一次性或可消耗的具现挂载。魔晶载体可以通过 mountedOn 关联承载平台，但本类不强制所有实例都已挂载。"@zh ;
                  rdfs:label "魔晶载体"@zh .


###  http://example.org/arcaneweb#ManifestationCapability
# 构建“ManifestationCapability（具现能力）”类，归属于“ArcaneCapability（法术能力）”类。
:ManifestationCapability rdf:type owl:Class ;
                  rdfs:subClassOf :ArcaneCapability ;
                  rdfs:label "具现能力"@zh .


###  http://example.org/arcaneweb#ManifestationChainNode
# 构建“ManifestationChainNode（具现链节点）”类，归属于“ChainNode（法术链节点）”类。
:ManifestationChainNode rdf:type owl:Class ;
                 rdfs:subClassOf :ChainNode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :nodeArtifact ;
                                   owl:someValuesFrom :ManifestationArtifact
                                 ] ;
                 rdfs:comment "节点法器取具现法器，既可以是释放平台，也可以是魔晶载体。"@zh ;
                 rdfs:label "具现链节点"@zh .


###  http://example.org/arcaneweb#ManifestationArtifact
# 构建“ManifestationArtifact（具现法器）”类，归属于“Artifact（法器）”类。
:ManifestationArtifact rdf:type owl:Class ;
                 rdfs:subClassOf :Artifact ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasCapability ;
                                   owl:someValuesFrom :ManifestationCapability
                                 ] ;
                 rdfs:comment "功能角色类：表示可执行魔法抵消和魔力消解任务的功能单元，在协调节点的协调安排和灵视探知节点的信息传输下，对交互目标进行扰动或具现。既包括具现平台，也包括魔晶载体，不限定为承载平台。原版表 3 的具现属性以本类为定义域；CrystalVessel 作为子类继承相关属性的适用范围。"@zh ;
                 rdfs:label "具现法器"@zh .


###  http://example.org/arcaneweb#ManifestationMission
# 构建“ManifestationMission（具现任务（A 施法））”类，归属于“ArcaneMission（行动任务）”类。
:ManifestationMission rdf:type owl:Class ;
               rdfs:subClassOf :ArcaneMission ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :requiresCapability ;
                                 owl:someValuesFrom :ManifestationCapability
                               ] ;
               rdfs:label "具现任务（A 施法）"@zh .


###  http://example.org/arcaneweb#ManifestationPlatform
# 构建“ManifestationPlatform（具现平台）”类，归属于“ArtifactPlatform（承载平台）”类。
:ManifestationPlatform rdf:type owl:Class ;
                rdfs:subClassOf :ArtifactPlatform ,
                                :ManifestationArtifact ;
                rdfs:comment "扩展子类：御风灵舟、守护法阵、浮空艇等可释放或投掷魔晶载体的平台。平台归入具现法器是论文的建模方式；魔晶载体是消耗性挂载。"@zh ;
                rdfs:label "具现平台"@zh .


###  http://example.org/arcaneweb#ManifestationRangeCapability
# 构建“ManifestationRangeCapability（具现距离能力）”类，归属于“ManifestationCapability（具现能力）”类。
:ManifestationRangeCapability rdf:type owl:Class ;
                       rdfs:subClassOf :ManifestationCapability ;
                       rdfs:label "具现距离能力"@zh .


###  http://example.org/arcaneweb#ManifestationTargetQuantityCapability
# 构建“ManifestationTargetQuantityCapability（具现目标数量能力）”类，归属于“ManifestationCapability（具现能力）”类。
:ManifestationTargetQuantityCapability rdf:type owl:Class ;
                                rdfs:subClassOf :ManifestationCapability ;
                                rdfs:label "具现目标数量能力"@zh .


###  http://example.org/arcaneweb#ManifestationTargetTypeCapability
# 构建“ManifestationTargetTypeCapability（具现目标类型能力）”类，归属于“ManifestationCapability（具现能力）”类。
:ManifestationTargetTypeCapability rdf:type owl:Class ;
                            rdfs:subClassOf :ManifestationCapability ;
                            rdfs:label "具现目标类型能力"@zh .


###  http://example.org/arcaneweb#Target
# 构建“Target（交互目标）”类，定义该概念的相关信息和约束。
:Target rdf:type owl:Class ;
        rdfs:comment "1.6/2.x 扩展：行动任务需要感知、跟踪、具现或解析的对方对象。"@zh ;
        rdfs:label "交互目标"@zh .


###  http://example.org/arcaneweb#Artifact
# 构建“Artifact（法器）”类，定义该概念的相关信息和约束。
:Artifact rdf:type owl:Class ;
                 rdfs:comment "为遂行一定的行动任务、具有一定魔法功能的法器系统，是奥术网的最小组成功能要素。"@zh ;
                 rdfs:label "法器"@zh .


#    Individuals

###  http://example.org/arcaneweb#AirInsightCapability
# 定义“AirInsightCapability（空中灵视探知能力）”规范能力个体，属于“InsightTargetTypeCapability（灵视探知目标类型能力）”类。
:AirInsightCapability rdf:type owl:NamedIndividual ,
                             :InsightTargetTypeCapability ;
                    rdfs:label "空中灵视探知能力"@zh .


###  http://example.org/arcaneweb#AirManifestationCapability
