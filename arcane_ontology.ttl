@prefix : <http://example.org/arcaneweb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/arcaneweb#> .

<http://example.org/arcaneweb> rdf:type owl:Ontology ;
                              rdfs:comment "西幻魔法背景，中文显示名称采用奥术网、法术链、法器等术语。"@zh ;
                              rdfs:label "奥术网络设计本体"@zh ;
                              owl:versionInfo "0.8.1" ;
                              rdfs:comment "0.8：撤下自设示例，删除未在本批文章表格中单独定义的十个通用能力字段；保留文章概念、分类、属性、结构与公式说明。未新增实例、游戏机制或执行规则。"@zh .

#    Object Properties

###  http://example.org/arcaneweb#capabilitySupportsMission
# 定义“capabilitySupportsMission（支撑行动任务）”关系，连接ArcaneCapability（法术能力）与ArcaneMission（行动任务）。
:capabilitySupportsMission rdf:type owl:ObjectProperty ;
                           owl:inverseOf :requiresCapability ;
                           rdfs:domain :ArcaneCapability ;
                           rdfs:range :ArcaneMission ;
                           rdfs:label "支撑行动任务"@zh .


###  http://example.org/arcaneweb#chainRelation
# 定义“chainRelation（参与的法阵组合）”关系，连接SpellChain（法术链）与ChainRelation（法阵组合关系）。
:chainRelation rdf:type owl:ObjectProperty ;
               owl:inverseOf :relatedChain ;
               rdfs:domain :SpellChain ;
               rdfs:range :ChainRelation ;
               rdfs:comment "法术链指向法阵组合关系实例的反向链接，与 relatedChain 互逆。"@zh ;
               rdfs:label "参与的法阵组合"@zh .


###  http://example.org/arcaneweb#chainTarget
# 定义“chainTarget（锁定目标）”关系，连接SpellChain（法术链）与Target（交互目标）。
:chainTarget rdf:type owl:ObjectProperty ;
             rdfs:domain :SpellChain ;
             rdfs:range :Target ;
             rdfs:label "锁定目标"@zh .


###  http://example.org/arcaneweb#coordinationToManifestationCommunication
# 定义“coordinationToManifestationCommunication（协调-具现传讯）”关系，连接CoordinationArtifact（协调法器）与ManifestationArtifact（具现法器）。
:coordinationToManifestationCommunication rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :communicatesWith ;
                              rdfs:domain :CoordinationArtifact ;
                              rdfs:range :ManifestationArtifact ;
                              rdfs:comment "对应论文图 3 中协调法器与具现法器之间的传讯关系。"@zh ;
                              rdfs:label "协调-具现传讯"@zh .


###  http://example.org/arcaneweb#orchestrates
# 定义“orchestrates（统筹法器）”关系，连接CoordinationArtifact（协调法器）与Artifact（法器）。
:orchestrates rdf:type owl:ObjectProperty ;
          rdfs:domain :CoordinationArtifact ;
          rdfs:range :Artifact ;
          rdfs:label "统筹法器"@zh .


###  http://example.org/arcaneweb#communicatesWith
# 定义“communicatesWith（魔法共鸣）”关系，连接Artifact（法器）与Artifact（法器）。
:communicatesWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  rdfs:domain :Artifact ;
                  rdfs:range :Artifact ;
                  rdfs:label "魔法共鸣"@zh .


###  http://example.org/arcaneweb#constrainedBy
# 定义“constrainedBy（受元素态势约束）”关系，连接ArcaneCapability（法术能力）与ElementalFieldSituation（元素场域态势）。
:constrainedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :situationConstrainsCapability ;
               rdfs:domain :ArcaneCapability ;
               rdfs:range :ElementalFieldSituation ;
               rdfs:comment "图 1 的态势→法术关系；法术能力受当前元素场域态势约束。"@zh ;
               rdfs:label "受元素态势约束"@zh .


###  http://example.org/arcaneweb#containsTarget
# 定义“containsTarget（态势包含目标）”关系，连接ElementalFieldSituation（元素场域态势）与Target（交互目标）。
:containsTarget rdf:type owl:ObjectProperty ;
                rdfs:domain :ElementalFieldSituation ;
                rdfs:range :Target ;
                rdfs:label "态势包含目标"@zh .


###  http://example.org/arcaneweb#detects
# 定义“detects（感知目标）”关系，连接InsightArtifact（灵视探知法器）与Target（交互目标）。
:detects rdf:type owl:ObjectProperty ;
         rdfs:domain :InsightArtifact ;
         rdfs:range :Target ;
         rdfs:label "感知目标"@zh .


###  http://example.org/arcaneweb#finishStartPrecedes
# 定义“finishStartPrecedes（前置施法完毕）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。
:finishStartPrecedes rdf:type owl:ObjectProperty ;
                     owl:inverseOf :startsAfterCompletionOf ;
                     rdf:type owl:IrreflexiveProperty ;
                     rdfs:domain :ArcaneMission ;
                     rdfs:range :ArcaneMission ;
                     rdfs:comment "对应论文图 5：前一环节完成后，后一环节开始。该属性只表达直接时序，不自动计算持续时间。"@zh ;
                     rdfs:label "前置施法完毕"@zh .


###  http://example.org/arcaneweb#fromChain
# 定义“fromChain（起始法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。
:fromChain rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :relatedChain ;
           rdfs:domain :ChainRelation ;
           rdfs:range :SpellChain ;
           rdfs:comment "用于串联法阵和分支法阵，表示有向关系的起点。"@zh ;
           rdfs:label "起始法术链"@zh .


###  http://example.org/arcaneweb#hasCapability
# 定义“hasCapability（具备法术）”关系，连接Artifact（法器）与ArcaneCapability（法术能力）。
:hasCapability rdf:type owl:ObjectProperty ;
               owl:inverseOf :realizedBy ;
               rdfs:domain :Artifact ;
               rdfs:range :ArcaneCapability ;
               rdfs:comment "定义域故意设为 Artifact：承载平台和挂载物都可以具备法术。若只想让功能单元具备法术，应另建 FunctionalArtifact 子类，而不是依赖注释。"@zh ;
               rdfs:label "具备法术"@zh .


###  http://example.org/arcaneweb#hasChain
# 定义“hasChain（奥术网包含法术链）”关系，连接ArcaneWeb（奥术网）与SpellChain（法术链）。
:hasChain rdf:type owl:ObjectProperty ;
          rdfs:domain :ArcaneWeb ;
          rdfs:range :SpellChain ;
          rdfs:label "奥术网包含法术链"@zh .


###  http://example.org/arcaneweb#hasChainNode
# 定义“hasChainNode（包含有序法阵节点）”关系，连接SpellChain（法术链）与ChainNode（法术链节点）。
:hasChainNode rdf:type owl:ObjectProperty ;
              rdfs:domain :SpellChain ;
              rdfs:range :ChainNode ;
              rdfs:comment "法术链成员关系的唯一入口；节点顺序由 nodeOrder 和 nextNode 表达。"@zh ;
              rdfs:label "包含有序法阵节点"@zh .


###  http://example.org/arcaneweb#hasPayload
# 定义“hasPayload（挂载魔晶 / 搭载物）”关系，连接ArtifactPlatform（承载平台）与Artifact（法器）。
:hasPayload rdf:type owl:ObjectProperty ;
            owl:inverseOf :mountedOn ;
            rdfs:domain :ArtifactPlatform ;
            rdfs:range :Artifact ;
            rdfs:comment "扩展关系：mountedOn 的逆关系，仅用于可分离的物理挂载物；常驻协调节点使用 hosts。"@zh ;
            rdfs:label "挂载魔晶 / 搭载物"@zh .


###  http://example.org/arcaneweb#hasRelation
# 定义“hasRelation（包含法阵组合）”关系，连接ArcaneWeb（奥术网）与ChainRelation（法阵组合关系）。
:hasRelation rdf:type owl:ObjectProperty ;
             owl:inverseOf :relationInWeb ;
             rdfs:domain :ArcaneWeb ;
             rdfs:range :ChainRelation ;
             rdfs:label "包含法阵组合"@zh .


###  http://example.org/arcaneweb#hasSituation
# 定义“hasSituation（任务所处环境）”关系，连接ArcaneMission（行动任务）与ElementalFieldSituation（元素场域态势）。
:hasSituation rdf:type owl:ObjectProperty ;
              rdfs:domain :ArcaneMission ;
              rdfs:range :ElementalFieldSituation ;
              rdfs:comment "图 1 中行动任务与元素场域态势共同决定所需法术的任务侧入口。"@zh ;
              rdfs:label "任务所处环境"@zh .


###  http://example.org/arcaneweb#hasSubMission
# 定义“hasSubMission（包含子任务）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。
:hasSubMission rdf:type owl:ObjectProperty ;
               rdfs:domain :ArcaneMission ;
               rdfs:range :ArcaneMission ;
               rdfs:comment "扩展：行动任务分解关系。"@zh ;
               rdfs:label "包含子任务"@zh .


###  http://example.org/arcaneweb#hasTarget
# 定义“hasTarget（任务目标）”关系，连接ArcaneMission（行动任务）与Target（交互目标）。
:hasTarget rdf:type owl:ObjectProperty ;
           rdfs:domain :ArcaneMission ;
           rdfs:range :Target ;
           rdfs:label "任务目标"@zh .


###  http://example.org/arcaneweb#hosts
# 定义“hosts（承载节点）”关系，连接ArtifactPlatform（承载平台）与Artifact（法器）。
:hosts rdf:type owl:ObjectProperty ;
       rdfs:domain :ArtifactPlatform ;
       rdfs:range :Artifact ;
       rdfs:comment "扩展关系：承载平台提供常驻或集成节点（如灵视探知魔像上的联合统筹中枢）；不等同于可分离的物理挂载物。"@zh ;
       rdfs:label "承载节点"@zh .


###  http://example.org/arcaneweb#judgmentToDecisionCommunication
# 定义“judgmentToDecisionCommunication（占卜-决断传讯）”关系，连接JudgmentArtifact（占卜法器）与DecisionArtifact（决断法器）。
:judgmentToDecisionCommunication rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :communicatesWith ;
                                 rdfs:domain :JudgmentArtifact ;
                                 rdfs:range :DecisionArtifact ;
                                 rdfs:comment "对应论文图 3 中占卜法器与决断法器之间的传讯关系。"@zh ;
                                 rdfs:label "占卜-决断传讯"@zh .


###  http://example.org/arcaneweb#mountedOn
# 定义“mountedOn（附魔于 / 挂载于）”关系，连接Artifact（法器）与ArtifactPlatform（承载平台）。
:mountedOn rdf:type owl:ObjectProperty ;
           rdfs:domain :Artifact ;
           rdfs:range :ArtifactPlatform ;
           rdfs:comment "扩展关系：表示可分离的物理挂载关系，例如探知挂件、魔晶载体支架。标签中的“附魔于”仅为该物理挂载关系的背景化称呼，不另行表示赋予魔法效果的过程。"@zh ;
           rdfs:label "附魔于 / 挂载于"@zh .


###  http://example.org/arcaneweb#nextNode
# 定义“nextNode（下一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。
:nextNode rdf:type owl:ObjectProperty ;
          owl:inverseOf :previousNode ;
          rdf:type owl:FunctionalProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :ChainNode ;
          rdfs:range :ChainNode ;
          rdfs:comment "单后继关系。OWL 不能保证后继属于同一条法术链、无环或与 nodeOrder 一致，这些需由 SHACL 或程序校验。"@zh ;
          rdfs:label "下一节点"@zh .


###  http://example.org/arcaneweb#nodeArtifact
# 定义“nodeArtifact（节点法器）”关系，连接ChainNode（法术链节点）与Artifact（法器）。
:nodeArtifact rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainNode ;
               rdfs:range :Artifact ;
               rdfs:label "节点法器"@zh .


###  http://example.org/arcaneweb#previousNode
# 定义“previousNode（上一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。
:previousNode rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainNode ;
              rdfs:range :ChainNode ;
              rdfs:label "上一节点"@zh .


###  http://example.org/arcaneweb#realizedBy
# 定义“realizedBy（由法器释放）”关系，连接ArcaneCapability（法术能力）与Artifact（法器）。
:realizedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :ArcaneCapability ;
            rdfs:range :Artifact ;
            rdfs:label "由法器释放"@zh .


###  http://example.org/arcaneweb#insightToCoordinationCommunication
# 定义“insightToCoordinationCommunication（灵视探知-协调传讯）”关系，连接InsightArtifact（灵视探知法器）与CoordinationArtifact（协调法器）。
:insightToCoordinationCommunication rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :communicatesWith ;
                             rdfs:domain :InsightArtifact ;
                             rdfs:range :CoordinationArtifact ;
                             rdfs:comment "对应论文图 3 中灵视探知法器与协调法器之间的传讯关系。"@zh ;
                             rdfs:label "灵视探知-协调传讯"@zh .


###  http://example.org/arcaneweb#relatedChain
# 定义“relatedChain（关联法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。
:relatedChain rdf:type owl:ObjectProperty ;
              rdfs:domain :ChainRelation ;
              rdfs:range :SpellChain ;
              rdfs:comment "法阵组合关系实例的参与法术链集合。并列法阵用它列出全部参与者。"@zh ;
              rdfs:label "关联法术链"@zh .


###  http://example.org/arcaneweb#relationInWeb
# 定义“relationInWeb（所属奥术网）”关系，连接ChainRelation（法阵组合关系）与ArcaneWeb（奥术网）。
:relationInWeb rdf:type owl:ObjectProperty ;
               rdfs:domain :ChainRelation ;
               rdfs:range :ArcaneWeb ;
               rdfs:label "所属奥术网"@zh .


###  http://example.org/arcaneweb#requirementConstrainsCapability
# 定义“requirementConstrainsCapability（需求约束法术）”关系，连接InvocationRequirement（施法需求）与ArcaneCapability（法术能力）。
:requirementConstrainsCapability rdf:type owl:ObjectProperty ;
                                 rdfs:domain :InvocationRequirement ;
                                 rdfs:range :ArcaneCapability ;
                                 rdfs:comment "图 1 中施法需求参与决定所需法术。"@zh ;
                                 rdfs:label "需求约束法术"@zh .


###  http://example.org/arcaneweb#requirementConstrainsArtifact
# 定义“requirementConstrainsArtifact（需求约束法器）”关系，连接InvocationRequirement（施法需求）与Artifact（法器）。
:requirementConstrainsArtifact rdf:type owl:ObjectProperty ;
                                rdfs:domain :InvocationRequirement ;
                                rdfs:range :Artifact ;
                                rdfs:comment "图 1 中施法需求参与决定所需法器；协同关系仍由第二章规则处理。"@zh ;
                                rdfs:label "需求约束法器"@zh .


###  http://example.org/arcaneweb#requirementForMission
# 定义“requirementForMission（面向行动任务）”关系，连接InvocationRequirement（施法需求）与ArcaneMission（行动任务）。
:requirementForMission rdf:type owl:ObjectProperty ;
                       rdfs:domain :InvocationRequirement ;
                       rdfs:range :ArcaneMission ;
                       rdfs:comment "表 1 将施法需求定义为完成可能担负任务的基本要求；该属性把需求挂到行动任务上。"@zh ;
                       rdfs:label "面向行动任务"@zh .


###  http://example.org/arcaneweb#requiresCapability
# 定义“requiresCapability（需要法术）”关系，连接ArcaneMission（行动任务）与ArcaneCapability（法术能力）。
:requiresCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain :ArcaneMission ;
                    rdfs:range :ArcaneCapability ;
                    rdfs:label "需要法术"@zh .


###  http://example.org/arcaneweb#satisfiesRequirement
# 定义“satisfiesRequirement（满足施法需求）”关系，连接ArcaneWeb（奥术网）与InvocationRequirement（施法需求）。
:satisfiesRequirement rdf:type owl:ObjectProperty ;
                      rdfs:domain :ArcaneWeb ;
                      rdfs:range :InvocationRequirement ;
                      rdfs:comment "扩展：只表达设计结果与施法需求的关联，不是自动判定满足。"@zh ;
                      rdfs:label "满足施法需求"@zh .


###  http://example.org/arcaneweb#situationConstrainsCapability
# 定义“situationConstrainsCapability（态势约束法术）”关系，连接ElementalFieldSituation（元素场域态势）与ArcaneCapability（法术能力）。
:situationConstrainsCapability rdf:type owl:ObjectProperty ;
                               rdfs:domain :ElementalFieldSituation ;
                               rdfs:range :ArcaneCapability ;
                               rdfs:comment "图 1 的反向读法；与 constrainedBy 互逆。"@zh ;
                               rdfs:label "态势约束法术"@zh .


###  http://example.org/arcaneweb#startsAfterCompletionOf
# 定义“startsAfterCompletionOf（在上一环节结束后启动）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。
:startsAfterCompletionOf rdf:type owl:ObjectProperty ;
                         rdfs:domain :ArcaneMission ;
                         rdfs:range :ArcaneMission ;
                         rdfs:label "在上一环节结束后启动"@zh .


###  http://example.org/arcaneweb#supportsMission
# 定义“supportsMission（支撑行动任务）”关系，连接ArcaneWeb（奥术网）与ArcaneMission（行动任务）。
:supportsMission rdf:type owl:ObjectProperty ;
                 rdfs:domain :ArcaneWeb ;
                 rdfs:range :ArcaneMission ;
                 rdfs:label "支撑行动任务"@zh .


###  http://example.org/arcaneweb#toChain
# 定义“toChain（目标法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。
:toChain rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :relatedChain ;
         rdfs:domain :ChainRelation ;
         rdfs:range :SpellChain ;
         rdfs:comment "用于串联法阵和分支法阵，表示有向关系的终点。"@zh ;
         rdfs:label "目标法术链"@zh .


#    Data properties

###  http://example.org/arcaneweb#altitudeFt
# 定义“altitudeFt（浮空势位（尺））”数据属性，记录Artifact（法器）的浮空势位（尺），值类型为 xsd:decimal。
:altitudeFt rdf:type owl:DatatypeProperty ;
            rdfs:domain :Artifact ;
            rdfs:range xsd:decimal ;
            rdfs:comment "沿用原版法器海拔的参照面和英尺单位；“浮空势位”为背景化显示名称，不改为相对地面的离地高度，也不限定法器必须处于悬浮状态。"@zh ;
            rdfs:label "浮空势位（尺）"@zh .


###  http://example.org/arcaneweb#azimuthCoverageDeg
# 定义“azimuthCoverageDeg（方位感知区（度））”数据属性，记录InsightArtifact（灵视探知法器）的方位感知区（度），值类型为 xsd:decimal。
:azimuthCoverageDeg rdf:type owl:DatatypeProperty ;
                    rdfs:domain :InsightArtifact ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "方位感知区（度）"@zh .


###  http://example.org/arcaneweb#azimuthResolutionDeg
# 定义“azimuthResolutionDeg（方位角感知误差（度））”数据属性，记录InsightArtifact（灵视探知法器）的方位角感知误差（度），值类型为 xsd:decimal。
:azimuthResolutionDeg rdf:type owl:DatatypeProperty ;
                      rdfs:domain :InsightArtifact ;
                      rdfs:range xsd:decimal ;
                      rdfs:label "方位角感知误差（度）"@zh .


###  http://example.org/arcaneweb#chainId
# 定义“chainId（法术链编号）”数据属性，记录SpellChain（法术链）的法术链编号，值类型为 xsd:string。
:chainId rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :SpellChain ;
         rdfs:range xsd:string ;
         rdfs:label "法术链编号"@zh .


###  http://example.org/arcaneweb#climbSpeedKn
# 定义“climbSpeedKn（升空速度（迅捷度））”数据属性，记录ManifestationArtifact（具现法器）的升空速度（迅捷度），值类型为 xsd:decimal。
:climbSpeedKn rdf:type owl:DatatypeProperty ;
              rdfs:domain :ManifestationArtifact ;
              rdfs:range xsd:decimal ;
              rdfs:label "升空速度（迅捷度）"@zh .


###  http://example.org/arcaneweb#communicationBandwidthMbps
# 定义“communicationBandwidthMbps（传音频段（Mbps））”数据属性，记录CoordinationArtifact（协调法器）的传音频段（Mbps），值类型为 xsd:decimal。
:communicationBandwidthMbps rdf:type owl:DatatypeProperty ;
                            rdfs:domain :CoordinationArtifact ;
                            rdfs:range xsd:decimal ;
                            rdfs:label "传音频段（Mbps）"@zh .


###  http://example.org/arcaneweb#communicationPowerW
# 定义“communicationPowerW（传讯功率（瓦））”数据属性，记录CoordinationArtifact（协调法器）的传讯功率（瓦），值类型为 xsd:decimal。
:communicationPowerW rdf:type owl:DatatypeProperty ;
                     rdfs:domain :CoordinationArtifact ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "传讯功率（瓦）"@zh .


###  http://example.org/arcaneweb#cost
# 定义“cost（附魔造价（使用成本））”数据属性，记录Artifact（法器）的附魔造价（使用成本），值类型为 xsd:decimal。
:cost rdf:type owl:DatatypeProperty ;
      rdfs:domain :Artifact ;
