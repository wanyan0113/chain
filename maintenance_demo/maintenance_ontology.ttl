@prefix : <https://example.org/maintenance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/maintenance> a owl:Ontology ;
    rdfs:label "设备故障诊断与维修协作本体"@zh ;
    owl:versionInfo "0.1" ;
    rdfs:comment "独立的非武器教学模型；实例均为虚构。规则另用 SPARQL CONSTRUCT 执行。"@zh .

# 五个核心类：任务、能力、资源、设备状态、维修要求。
:MaintenanceTask a owl:Class ; rdfs:label "维修任务"@zh .
:Capability a owl:Class ; rdfs:label "服务能力"@zh .
:Resource a owl:Class ; rdfs:label "服务资源"@zh .
:EquipmentState a owl:Class ; rdfs:label "设备状态"@zh .
:MaintenanceRequirement a owl:Class ; rdfs:label "维修要求"@zh .

# OODA 活动分类；资源与活动分别建模。
:ObservationTask a owl:Class ; rdfs:subClassOf :MaintenanceTask ; rdfs:label "观察任务"@zh .
:DiagnosisTask a owl:Class ; rdfs:subClassOf :MaintenanceTask ; rdfs:label "判断任务"@zh .
:PlanningTask a owl:Class ; rdfs:subClassOf :MaintenanceTask ; rdfs:label "决策任务"@zh .
:RepairTask a owl:Class ; rdfs:subClassOf :MaintenanceTask ; rdfs:label "行动任务"@zh .
:InspectionTask a owl:Class ; rdfs:subClassOf :ObservationTask ; rdfs:label "复检任务"@zh .
:Sensor a owl:Class ; rdfs:subClassOf :Resource ; rdfs:label "传感器"@zh .
:DiagnosticSoftware a owl:Class ; rdfs:subClassOf :Resource ; rdfs:label "诊断软件"@zh .
:Planner a owl:Class ; rdfs:subClassOf :Resource ; rdfs:label "维修调度员"@zh .
:Technician a owl:Class ; rdfs:subClassOf :Resource ; rdfs:label "维修人员"@zh .

# 任务需要能力，资源提供能力；互逆关系仅表达逻辑方向。
:requiresCapability a owl:ObjectProperty ; rdfs:label "需要能力"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :Capability .
:providesCapability a owl:ObjectProperty ; rdfs:label "提供能力"@zh ;
    rdfs:domain :Resource ; rdfs:range :Capability ; owl:inverseOf :providedBy .
:providedBy a owl:ObjectProperty ; rdfs:label "能力由资源提供"@zh ;
    rdfs:domain :Capability ; rdfs:range :Resource .
:hasState a owl:ObjectProperty ; rdfs:label "关联设备状态"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :EquipmentState .
:hasRequirement a owl:ObjectProperty ; rdfs:label "具有维修要求"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :MaintenanceRequirement .
:dependsOn a owl:ObjectProperty ; rdfs:label "依赖前置任务"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :MaintenanceTask ; owl:inverseOf :enables .
:enables a owl:ObjectProperty ; rdfs:label "支持后续任务"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :MaintenanceTask .
:candidateResource a owl:ObjectProperty ; rdfs:label "候选服务资源"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :Resource .

# 数值使用分钟；当前仅作标注，不声称已经实现排程或效能评估。
:durationMinutes a owl:DatatypeProperty ; rdfs:label "活动耗时（分钟）"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range xsd:decimal .
:deadlineMinutes a owl:DatatypeProperty ; rdfs:label "期限（分钟）"@zh ;
    rdfs:domain :MaintenanceRequirement ; rdfs:range xsd:decimal .
:available a owl:DatatypeProperty ; rdfs:label "当前可用"@zh ;
    rdfs:domain :Resource ; rdfs:range xsd:boolean .

# 存在限制表达必要条件，不负责检查数据是否漏填。
:MaintenanceTask rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty :requiresCapability ; owl:someValuesFrom :Capability ] .

# 虚构的能力词项；此处采用个体表达能力类别，匹配规则按同一能力 IRI 连接。
:detect a owl:NamedIndividual, :Capability ; rdfs:label "异常检测能力"@zh .
:diagnose a owl:NamedIndividual, :Capability ; rdfs:label "故障诊断能力"@zh .
:plan a owl:NamedIndividual, :Capability ; rdfs:label "维修规划能力"@zh .
:repair a owl:NamedIndividual, :Capability ; rdfs:label "设备维修能力"@zh .

# 资源实例；备用人员明确标记为不可用，用于检查规则的筛选条件。
:sensor01 a owl:NamedIndividual, :Sensor ; rdfs:label "振动传感器01"@zh ;
    :providesCapability :detect ; :available true .
:software01 a owl:NamedIndividual, :DiagnosticSoftware ; rdfs:label "诊断软件01"@zh ;
    :providesCapability :diagnose ; :available true .
:planner01 a owl:NamedIndividual, :Planner ; rdfs:label "调度员01"@zh ;
    :providesCapability :plan ; :available true .
:technician01 a owl:NamedIndividual, :Technician ; rdfs:label "维修人员01"@zh ;
    :providesCapability :repair ; :available true .
:technician02 a owl:NamedIndividual, :Technician ; rdfs:label "不可用的备用人员02"@zh ;
    :providesCapability :repair ; :available false .

# 泵站案例：观察→判断→决策→行动→复检；依赖箭头指向前置任务。
:abnormalVibration a owl:NamedIndividual, :EquipmentState ; rdfs:label "泵站振动异常"@zh .
:requirement01 a owl:NamedIndividual, :MaintenanceRequirement ;
    rdfs:label "三十分钟内完成维修与复检"@zh ; :deadlineMinutes 30.0 .
:observe01 a owl:NamedIndividual, :ObservationTask ; rdfs:label "检测泵站异常"@zh ;
    :requiresCapability :detect ; :hasState :abnormalVibration ; :durationMinutes 2.0 .
:diagnose01 a owl:NamedIndividual, :DiagnosisTask ; rdfs:label "分析故障原因"@zh ;
    :requiresCapability :diagnose ; :dependsOn :observe01 ; :durationMinutes 3.0 .
:plan01 a owl:NamedIndividual, :PlanningTask ; rdfs:label "制定维修计划"@zh ;
    :requiresCapability :plan ; :dependsOn :diagnose01 ; :durationMinutes 2.0 .
:repair01 a owl:NamedIndividual, :RepairTask ; rdfs:label "执行泵站维修"@zh ;
    :requiresCapability :repair ; :dependsOn :plan01 ; :durationMinutes 15.0 .
:inspect01 a owl:NamedIndividual, :InspectionTask ; rdfs:label "检测维修后状态"@zh ;
    :requiresCapability :detect ; :dependsOn :repair01 ; :durationMinutes 3.0 ;
    :hasRequirement :requirement01 .
