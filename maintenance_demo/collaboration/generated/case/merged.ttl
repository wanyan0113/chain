@prefix : <https://example.org/maintenance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AllCapabilitiesAvailableRule a owl:NamedIndividual,
        :MappingRule ;
    rdfs:label "单个可用资源覆盖全部需求且响应不超限"@zh .

:afterWorkflow a owl:ObjectProperty ;
    rdfs:label "依赖前置流程请求"@zh ;
    rdfs:domain :WorkflowRequest ;
    rdfs:range :WorkflowRequest .

:assetKind a owl:DatatypeProperty ;
    rdfs:label "设备种类"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:string .

:assignedResource a owl:ObjectProperty ;
    rdfs:label "本次选择的资源"@zh ;
    rdfs:domain :Execution ;
    rdfs:range :Resource .

:available a owl:DatatypeProperty ;
    rdfs:label "当前可用"@zh ;
    rdfs:domain :Resource ;
    rdfs:range xsd:boolean .

:canHandoffTo a owl:ObjectProperty ;
    rdfs:label "可交接给（规则结果）"@zh ;
    rdfs:domain :Resource ;
    rdfs:range :Resource .

:candidateResource a owl:ObjectProperty ;
    rdfs:label "候选资源（规则结果）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range :Resource .

:capacity a owl:DatatypeProperty ;
    rdfs:label "同时服务容量"@zh ;
    rdfs:domain :Resource ;
    rdfs:range xsd:positiveInteger .

:dependsOn a owl:ObjectProperty ;
    rdfs:label "依赖前置任务"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range :MaintenanceTask .

:durationMinutes a owl:DatatypeProperty ;
    rdfs:label "计划持续时间（分钟）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:decimal .

:endMinutes a owl:DatatypeProperty ;
    rdfs:label "参与结束（分钟）"@zh ;
    rdfs:domain :Execution ;
    rdfs:range xsd:decimal .

:executionOrder a owl:DatatypeProperty ;
    rdfs:label "参与顺序"@zh ;
    rdfs:domain :Execution ;
    rdfs:range xsd:positiveInteger .

:executionTask a owl:ObjectProperty ;
    rdfs:label "参与记录对应任务"@zh ;
    rdfs:domain :Execution ;
    rdfs:range :MaintenanceTask .

:fromWorkflow a owl:ObjectProperty ;
    rdfs:label "起始流程"@zh ;
    rdfs:domain :WorkflowRelation ;
    rdfs:range :Workflow .

<https://example.org/maintenance#generated/network> a :WorkflowNetwork ;
    rdfs:label "维修协作网络"@zh ;
    :hasWorkflow <https://example.org/maintenance#generated/workflow/32a96e87f16b56fc>,
        <https://example.org/maintenance#generated/workflow/4358a022bd404d7a>,
        <https://example.org/maintenance#generated/workflow/86761c3bd331b62c> ;
    :hasWorkflowRelation <https://example.org/maintenance#generated/relation/3b4ceeb794a21bd2>,
        <https://example.org/maintenance#generated/relation/a9dbd8e5324f210e>,
        <https://example.org/maintenance#generated/relation/d690f52bf09bea7a>,
        <https://example.org/maintenance#generated/relation/e87524335fe62436> .

:handoffAuthorized a owl:ObjectProperty ;
    rdfs:label "允许交接给"@zh ;
    rdfs:domain :Resource ;
    rdfs:range :Resource .

:hasExecution a owl:ObjectProperty ;
    rdfs:label "流程包含参与记录"@zh ;
    rdfs:domain :Workflow ;
    rdfs:range :Execution .

:hasTask a owl:ObjectProperty ;
    rdfs:label "请求包含任务"@zh ;
    rdfs:domain :WorkflowRequest ;
    rdfs:range :MaintenanceTask .

:hasWorkflow a owl:ObjectProperty ;
    rdfs:label "网络包含流程"@zh ;
    rdfs:domain :WorkflowNetwork ;
    rdfs:range :Workflow .

:hasWorkflowRelation a owl:ObjectProperty ;
    rdfs:label "网络包含组合关系"@zh ;
    rdfs:domain :WorkflowNetwork ;
    rdfs:range :WorkflowRelation .

:inputFormat a owl:DatatypeProperty ;
    rdfs:label "接受报告格式"@zh ;
    rdfs:domain :Resource ;
    rdfs:range xsd:string .

:matchedTaskRule a owl:ObjectProperty ;
    rdfs:label "命中的任务规则"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range :MappingRule .

:maxWaitMinutes a owl:DatatypeProperty ;
    rdfs:label "可接受响应上限（分钟）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:decimal .

:nextExecution a owl:ObjectProperty ;
    rdfs:label "下一参与记录"@zh ;
    rdfs:domain :Execution ;
    rdfs:range :Execution .

:outputFormat a owl:DatatypeProperty ;
    rdfs:label "输出报告格式"@zh ;
    rdfs:domain :Resource ;
    rdfs:range xsd:string .

:plannedStartMinutes a owl:DatatypeProperty ;
    rdfs:label "计划开始（相对分钟）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:decimal .

:providesCapability a owl:ObjectProperty ;
    rdfs:label "提供能力"@zh ;
    rdfs:domain :Resource ;
    rdfs:range :Capability .

:relatedWorkflow a owl:ObjectProperty ;
    rdfs:label "参与流程"@zh ;
    rdfs:domain :WorkflowRelation ;
    rdfs:range :Workflow .

:requiresCapability a owl:ObjectProperty ;
    rdfs:label "需要能力（规则结果）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range :Capability .

:requiresRecord a owl:DatatypeProperty ;
    rdfs:label "是否要求记录"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:boolean .

:reservedSupply a owl:ObjectProperty ;
    rdfs:label "计划领用耗材"@zh ;
    rdfs:domain :Execution ;
    rdfs:range :Supply .

:responseMinutes a owl:DatatypeProperty ;
    rdfs:label "资源响应时间（分钟）"@zh ;
    rdfs:domain :Resource ;
    rdfs:range xsd:decimal .

:sourceRequest a owl:ObjectProperty ;
    rdfs:label "对应流程请求"@zh ;
    rdfs:domain :Workflow ;
    rdfs:range :WorkflowRequest .

:startMinutes a owl:DatatypeProperty ;
    rdfs:label "参与开始（分钟）"@zh ;
    rdfs:domain :Execution ;
    rdfs:range xsd:decimal .

:stockCount a owl:DatatypeProperty ;
    rdfs:label "可领用份数"@zh ;
    rdfs:domain :Supply ;
    rdfs:range xsd:nonNegativeInteger .

:taskKind a owl:DatatypeProperty ;
    rdfs:label "任务种类"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range xsd:string .

:toWorkflow a owl:ObjectProperty ;
    rdfs:label "后续流程"@zh ;
    rdfs:domain :WorkflowRelation ;
    rdfs:range :Workflow .

:usesSupply a owl:ObjectProperty ;
    rdfs:label "任务领用耗材（每条关系一份）"@zh ;
    rdfs:domain :MaintenanceTask ;
    rdfs:range :Supply .

<https://example.org/maintenance/collaboration> a owl:Ontology ;
    rdfs:label "维修流程协同验证"@zh ;
    rdfs:comment "独立非武器例子：验证预先声明的任务、依赖和时间窗口，选择一个可行资源组合，不搜索任务顺序或最优排程。"@zh ;
    owl:versionInfo "1.0" .

<https://example.org/maintenance/mapping> a owl:Ontology ;
    rdfs:label "维修两级映射演示"@zh ;
    rdfs:comment "独立的非武器规则验证；复用维修命名空间，与旧示例分别加载。"@zh ;
    owl:versionInfo "1.0" .

:BranchRelation a owl:Class ;
    rdfs:label "依赖分支"@zh ;
    rdfs:subClassOf :WorkflowRelation .

:ParallelRelation a owl:Class ;
    rdfs:label "时间并行"@zh ;
    rdfs:subClassOf :WorkflowRelation .

:RepairPumpRule a owl:NamedIndividual,
        :MappingRule ;
    rdfs:label "泵站维修需要维修能力"@zh .

<https://example.org/maintenance#generated/execution/a5a85e886643c2a9> a :Execution ;
    :assignedResource :serviceTeam ;
    :endMinutes 6.0 ;
    :executionOrder "1"^^xsd:positiveInteger ;
    :executionTask :repairAction ;
    :startMinutes 3.0 .

<https://example.org/maintenance#generated/execution/c6ac2598489bc936> a :Execution ;
    :assignedResource :recordingSensor ;
    :endMinutes 2.0 ;
    :executionOrder "1"^^xsd:positiveInteger ;
    :executionTask :recordCheck ;
    :nextExecution <https://example.org/maintenance#generated/execution/f72b34316cb86590> ;
    :reservedSupply :diagnosticStrip ;
    :startMinutes 0.0 .

<https://example.org/maintenance#generated/execution/c89e3de1f3578bbc> a :Execution ;
    :assignedResource :recordingSensor ;
    :endMinutes 5.0 ;
    :executionOrder "1"^^xsd:positiveInteger ;
    :executionTask :monitorCheck ;
    :startMinutes 3.0 .

<https://example.org/maintenance#generated/relation/3b4ceeb794a21bd2> a :BranchRelation ;
    :fromWorkflow <https://example.org/maintenance#generated/workflow/4358a022bd404d7a> ;
    :relatedWorkflow <https://example.org/maintenance#generated/workflow/32a96e87f16b56fc>,
        <https://example.org/maintenance#generated/workflow/4358a022bd404d7a>,
        <https://example.org/maintenance#generated/workflow/86761c3bd331b62c> .

<https://example.org/maintenance#generated/relation/a9dbd8e5324f210e> a :SequentialRelation ;
    :fromWorkflow <https://example.org/maintenance#generated/workflow/4358a022bd404d7a> ;
    :relatedWorkflow <https://example.org/maintenance#generated/workflow/4358a022bd404d7a>,
        <https://example.org/maintenance#generated/workflow/86761c3bd331b62c> ;
    :toWorkflow <https://example.org/maintenance#generated/workflow/86761c3bd331b62c> .

<https://example.org/maintenance#generated/relation/d690f52bf09bea7a> a :SequentialRelation ;
    :fromWorkflow <https://example.org/maintenance#generated/workflow/4358a022bd404d7a> ;
    :relatedWorkflow <https://example.org/maintenance#generated/workflow/32a96e87f16b56fc>,
        <https://example.org/maintenance#generated/workflow/4358a022bd404d7a> ;
    :toWorkflow <https://example.org/maintenance#generated/workflow/32a96e87f16b56fc> .

<https://example.org/maintenance#generated/relation/e87524335fe62436> a :ParallelRelation ;
    :relatedWorkflow <https://example.org/maintenance#generated/workflow/32a96e87f16b56fc>,
        <https://example.org/maintenance#generated/workflow/86761c3bd331b62c> .

:monitorRequest a :WorkflowRequest ;
    rdfs:label "监测流程"@zh ;
    :afterWorkflow :inspectionRequest ;
    :hasTask :monitorCheck .

:repairRequest a :WorkflowRequest ;
    rdfs:label "维修流程"@zh ;
    :afterWorkflow :inspectionRequest ;
    :hasTask :repairAction .

:RecordPumpRule a owl:NamedIndividual,
        :MappingRule ;
    rdfs:label "需要留档的泵站检测需要记录能力"@zh .

:Sensor a owl:Class ;
    rdfs:label "传感器"@zh ;
    rdfs:subClassOf :Resource .

:SequentialRelation a owl:Class ;
    rdfs:label "依赖串联"@zh ;
    rdfs:subClassOf :WorkflowRelation .

:confirmCheck a :PumpTask ;
    rdfs:label "确认检测结果"@zh ;
    :assetKind "pump" ;
    :candidateResource :basicSensor ;
    :dependsOn :recordCheck ;
    :durationMinutes 1.0 ;
    :matchedTaskRule :InspectPumpRule ;
    :maxWaitMinutes 1.0 ;
    :plannedStartMinutes 2.0 ;
    :requiresCapability :detect ;
    :requiresRecord false ;
    :taskKind "inspect" .

:diagnosticStrip a :Supply ;
    rdfs:label "一次性检测试纸"@zh ;
    :stockCount "1"^^xsd:nonNegativeInteger .

<https://example.org/maintenance#generated/execution/f72b34316cb86590> a :Execution ;
    :assignedResource :basicSensor ;
    :endMinutes 3.0 ;
    :executionOrder "2"^^xsd:positiveInteger ;
    :executionTask :confirmCheck ;
    :startMinutes 2.0 .

:monitorCheck a :PumpTask ;
    rdfs:label "并行监测并留档"@zh ;
    :assetKind "pump" ;
    :candidateResource :recordingSensor ;
    :durationMinutes 2.0 ;
    :matchedTaskRule :InspectPumpRule,
        :RecordPumpRule ;
    :maxWaitMinutes 5.0 ;
    :plannedStartMinutes 3.0 ;
    :requiresCapability :detect,
        :record ;
    :requiresRecord true ;
    :taskKind "inspect" .

:repair a owl:NamedIndividual,
        :Capability ;
    rdfs:label "维修能力"@zh .

:repairAction a :PumpTask ;
    rdfs:label "维修作业"@zh ;
    :assetKind "pump" ;
    :candidateResource :serviceTeam ;
    :durationMinutes 3.0 ;
    :matchedTaskRule :RepairPumpRule ;
    :maxWaitMinutes 5.0 ;
    :plannedStartMinutes 3.0 ;
    :requiresCapability :repair ;
    :requiresRecord false ;
    :taskKind "repair" .

:InspectPumpRule a owl:NamedIndividual,
        :MappingRule ;
    rdfs:label "泵站检测需要检测能力"@zh .

:WorkflowNetwork a owl:Class ;
    rdfs:label "流程协作网络"@zh .

:inspectionRequest a :WorkflowRequest ;
    rdfs:label "检测流程"@zh ;
    :hasTask :confirmCheck,
        :recordCheck .

:record a owl:NamedIndividual,
        :Capability ;
    rdfs:label "记录能力"@zh .

:recordCheck a :PumpTask ;
    rdfs:label "检测并留档"@zh ;
    :assetKind "pump" ;
    :candidateResource :recordingSensor ;
    :durationMinutes 2.0 ;
    :matchedTaskRule :InspectPumpRule,
        :RecordPumpRule ;
    :maxWaitMinutes 5.0 ;
    :plannedStartMinutes 0.0 ;
    :requiresCapability :detect,
        :record ;
    :requiresRecord true ;
    :taskKind "inspect" ;
    :usesSupply :diagnosticStrip .

:PumpTask a owl:Class ;
    rdfs:label "泵站任务"@zh ;
    rdfs:subClassOf :MaintenanceTask .

:Supply a owl:Class ;
    rdfs:label "维修耗材"@zh .

:basicSensor a :Sensor ;
    rdfs:label "基础检测仪"@zh ;
    :available true ;
    :canHandoffTo :recordingSensor,
        :serviceTeam ;
    :capacity "1"^^xsd:positiveInteger ;
    :handoffAuthorized :recordingSensor,
        :serviceTeam ;
    :inputFormat "maintenance-json" ;
    :outputFormat "maintenance-json" ;
    :providesCapability :detect ;
    :responseMinutes 0.5 .

:serviceTeam a :Resource ;
    rdfs:label "维修服务组"@zh ;
    :available true ;
    :capacity "1"^^xsd:positiveInteger ;
    :inputFormat "maintenance-json" ;
    :outputFormat "maintenance-json" ;
    :providesCapability :repair ;
    :responseMinutes 3.0 .

:Capability a owl:Class ;
    rdfs:label "服务能力"@zh .

:MappingRule a owl:Class ;
    rdfs:label "演示映射规则"@zh .

:detect a owl:NamedIndividual,
        :Capability ;
    rdfs:label "检测能力"@zh .

<https://example.org/maintenance#generated/workflow/32a96e87f16b56fc> a :Workflow ;
    rdfs:label "维修流程"@zh ;
    :hasExecution <https://example.org/maintenance#generated/execution/a5a85e886643c2a9> ;
    :sourceRequest :repairRequest .

<https://example.org/maintenance#generated/workflow/86761c3bd331b62c> a :Workflow ;
    rdfs:label "监测流程"@zh ;
    :hasExecution <https://example.org/maintenance#generated/execution/c89e3de1f3578bbc> ;
    :sourceRequest :monitorRequest .

:recordingSensor a :Sensor ;
    rdfs:label "带记录功能的检测仪"@zh ;
    :available true ;
    :canHandoffTo :basicSensor ;
    :capacity "1"^^xsd:positiveInteger ;
    :handoffAuthorized :basicSensor ;
    :inputFormat "maintenance-json" ;
    :outputFormat "maintenance-json" ;
    :providesCapability :detect,
        :record ;
    :responseMinutes 2.0 .

:WorkflowRelation a owl:Class ;
    rdfs:label "流程组合关系"@zh .

:WorkflowRequest a owl:Class ;
    rdfs:label "流程请求"@zh .

<https://example.org/maintenance#generated/workflow/4358a022bd404d7a> a :Workflow ;
    rdfs:label "检测流程"@zh ;
    :hasExecution <https://example.org/maintenance#generated/execution/c6ac2598489bc936>,
        <https://example.org/maintenance#generated/execution/f72b34316cb86590> ;
    :sourceRequest :inspectionRequest .

:Workflow a owl:Class ;
    rdfs:label "已验证流程"@zh .

:Execution a owl:Class ;
    rdfs:label "资源参与记录"@zh .

:Resource a owl:Class ;
    rdfs:label "服务资源"@zh .

:MaintenanceTask a owl:Class ;
    rdfs:label "维修任务"@zh .
