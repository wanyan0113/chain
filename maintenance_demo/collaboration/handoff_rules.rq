PREFIX : <https://example.org/maintenance#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# 非武器维修交接：授权、共同报告格式及双方显式可用同时成立。
CONSTRUCT { ?sender :canHandoffTo ?receiver . }
WHERE {
    ?sender rdf:type/rdfs:subClassOf* :Resource ; :available true ;
            :handoffAuthorized ?receiver ; :outputFormat ?format .
    ?receiver rdf:type/rdfs:subClassOf* :Resource ; :available true ; :inputFormat ?format .
    FILTER(?sender != ?receiver)
}
