@prefix : <https://example.org/maintenance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/maintenance/collaboration> a owl:Ontology ;
    rdfs:label "维修流程协同验证"@zh ; owl:versionInfo "1.0" ;
    rdfs:comment "独立非武器例子：验证预先声明的任务、依赖和时间窗口，选择一个可行资源组合，不搜索任务顺序或最优排程。"@zh .

:WorkflowRequest a owl:Class ; rdfs:label "流程请求"@zh .
:Supply a owl:Class ; rdfs:label "维修耗材"@zh .
:Workflow a owl:Class ; rdfs:label "已验证流程"@zh .
:Execution a owl:Class ; rdfs:label "资源参与记录"@zh .
:WorkflowNetwork a owl:Class ; rdfs:label "流程协作网络"@zh .
:WorkflowRelation a owl:Class ; rdfs:label "流程组合关系"@zh .
:SequentialRelation a owl:Class ; rdfs:subClassOf :WorkflowRelation ; rdfs:label "依赖串联"@zh .
:ParallelRelation a owl:Class ; rdfs:subClassOf :WorkflowRelation ; rdfs:label "时间并行"@zh .
:BranchRelation a owl:Class ; rdfs:subClassOf :WorkflowRelation ; rdfs:label "依赖分支"@zh .

:hasTask a owl:ObjectProperty ; rdfs:label "请求包含任务"@zh ; rdfs:domain :WorkflowRequest ; rdfs:range :MaintenanceTask .
:afterWorkflow a owl:ObjectProperty ; rdfs:label "依赖前置流程请求"@zh ; rdfs:domain :WorkflowRequest ; rdfs:range :WorkflowRequest .
:dependsOn a owl:ObjectProperty ; rdfs:label "依赖前置任务"@zh ; rdfs:domain :MaintenanceTask ; rdfs:range :MaintenanceTask .
:handoffAuthorized a owl:ObjectProperty ; rdfs:label "允许交接给"@zh ; rdfs:domain :Resource ; rdfs:range :Resource .
:canHandoffTo a owl:ObjectProperty ; rdfs:label "可交接给（规则结果）"@zh ; rdfs:domain :Resource ; rdfs:range :Resource .
:outputFormat a owl:DatatypeProperty ; rdfs:label "输出报告格式"@zh ; rdfs:domain :Resource ; rdfs:range xsd:string .
:inputFormat a owl:DatatypeProperty ; rdfs:label "接受报告格式"@zh ; rdfs:domain :Resource ; rdfs:range xsd:string .
:capacity a owl:DatatypeProperty ; rdfs:label "同时服务容量"@zh ; rdfs:domain :Resource ; rdfs:range xsd:positiveInteger .
:plannedStartMinutes a owl:DatatypeProperty ; rdfs:label "计划开始（相对分钟）"@zh ; rdfs:domain :MaintenanceTask ; rdfs:range xsd:decimal .
:durationMinutes a owl:DatatypeProperty ; rdfs:label "计划持续时间（分钟）"@zh ; rdfs:domain :MaintenanceTask ; rdfs:range xsd:decimal .
:usesSupply a owl:ObjectProperty ; rdfs:label "任务领用耗材（每条关系一份）"@zh ; rdfs:domain :MaintenanceTask ; rdfs:range :Supply .
:stockCount a owl:DatatypeProperty ; rdfs:label "可领用份数"@zh ; rdfs:domain :Supply ; rdfs:range xsd:nonNegativeInteger .

:hasWorkflow a owl:ObjectProperty ; rdfs:label "网络包含流程"@zh ; rdfs:domain :WorkflowNetwork ; rdfs:range :Workflow .
:hasWorkflowRelation a owl:ObjectProperty ; rdfs:label "网络包含组合关系"@zh ; rdfs:domain :WorkflowNetwork ; rdfs:range :WorkflowRelation .
:sourceRequest a owl:ObjectProperty ; rdfs:label "对应流程请求"@zh ; rdfs:domain :Workflow ; rdfs:range :WorkflowRequest .
:hasExecution a owl:ObjectProperty ; rdfs:label "流程包含参与记录"@zh ; rdfs:domain :Workflow ; rdfs:range :Execution .
:executionTask a owl:ObjectProperty ; rdfs:label "参与记录对应任务"@zh ; rdfs:domain :Execution ; rdfs:range :MaintenanceTask .
:assignedResource a owl:ObjectProperty ; rdfs:label "本次选择的资源"@zh ; rdfs:domain :Execution ; rdfs:range :Resource .
:reservedSupply a owl:ObjectProperty ; rdfs:label "计划领用耗材"@zh ; rdfs:domain :Execution ; rdfs:range :Supply .
:nextExecution a owl:ObjectProperty ; rdfs:label "下一参与记录"@zh ; rdfs:domain :Execution ; rdfs:range :Execution .
:executionOrder a owl:DatatypeProperty ; rdfs:label "参与顺序"@zh ; rdfs:domain :Execution ; rdfs:range xsd:positiveInteger .
:startMinutes a owl:DatatypeProperty ; rdfs:label "参与开始（分钟）"@zh ; rdfs:domain :Execution ; rdfs:range xsd:decimal .
:endMinutes a owl:DatatypeProperty ; rdfs:label "参与结束（分钟）"@zh ; rdfs:domain :Execution ; rdfs:range xsd:decimal .
:fromWorkflow a owl:ObjectProperty ; rdfs:label "起始流程"@zh ; rdfs:domain :WorkflowRelation ; rdfs:range :Workflow .
:toWorkflow a owl:ObjectProperty ; rdfs:label "后续流程"@zh ; rdfs:domain :WorkflowRelation ; rdfs:range :Workflow .
:relatedWorkflow a owl:ObjectProperty ; rdfs:label "参与流程"@zh ; rdfs:domain :WorkflowRelation ; rdfs:range :Workflow .
