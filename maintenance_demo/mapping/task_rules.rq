PREFIX : <https://example.org/maintenance#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# 级一：属性条件合取 -> 所需能力；多条规则可为同一任务增加不同能力。
CONSTRUCT {
    ?task :requiresCapability ?capability ; :matchedTaskRule ?rule .
}
WHERE {
    ?task rdf:type/rdfs:subClassOf* :MaintenanceTask ; :assetKind "pump" .
    {
        ?task :taskKind "inspect" .
        BIND(:detect AS ?capability)
        BIND(:InspectPumpRule AS ?rule)
    } UNION {
        ?task :taskKind "inspect" ; :requiresRecord true .
        BIND(:record AS ?capability)
        BIND(:RecordPumpRule AS ?rule)
    } UNION {
        ?task :taskKind "repair" .
        BIND(:repair AS ?capability)
        BIND(:RepairPumpRule AS ?rule)
    }
}
