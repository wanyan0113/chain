@prefix : <https://example.org/maintenance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/maintenance/mapping> a owl:Ontology ;
    rdfs:label "维修两级映射演示"@zh ; owl:versionInfo "1.0" ;
    rdfs:comment "独立的非武器规则验证；复用维修命名空间，与旧示例分别加载。"@zh .

:MaintenanceTask a owl:Class ; rdfs:label "维修任务"@zh .
:PumpTask a owl:Class ; rdfs:subClassOf :MaintenanceTask ; rdfs:label "泵站任务"@zh .
:Resource a owl:Class ; rdfs:label "服务资源"@zh .
:Sensor a owl:Class ; rdfs:subClassOf :Resource ; rdfs:label "传感器"@zh .
:Capability a owl:Class ; rdfs:label "服务能力"@zh .
:MappingRule a owl:Class ; rdfs:label "演示映射规则"@zh .

:taskKind a owl:DatatypeProperty ; rdfs:label "任务种类"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range xsd:string .
:assetKind a owl:DatatypeProperty ; rdfs:label "设备种类"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range xsd:string .
:requiresRecord a owl:DatatypeProperty ; rdfs:label "是否要求记录"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range xsd:boolean .
:maxWaitMinutes a owl:DatatypeProperty ; rdfs:label "可接受响应上限（分钟）"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range xsd:decimal .
:responseMinutes a owl:DatatypeProperty ; rdfs:label "资源响应时间（分钟）"@zh ;
    rdfs:domain :Resource ; rdfs:range xsd:decimal .
:available a owl:DatatypeProperty ; rdfs:label "当前可用"@zh ;
    rdfs:domain :Resource ; rdfs:range xsd:boolean .
:providesCapability a owl:ObjectProperty ; rdfs:label "提供能力"@zh ;
    rdfs:domain :Resource ; rdfs:range :Capability .
:requiresCapability a owl:ObjectProperty ; rdfs:label "需要能力（规则结果）"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :Capability .
:candidateResource a owl:ObjectProperty ; rdfs:label "候选资源（规则结果）"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :Resource .
:matchedTaskRule a owl:ObjectProperty ; rdfs:label "命中的任务规则"@zh ;
    rdfs:domain :MaintenanceTask ; rdfs:range :MappingRule .

:detect a owl:NamedIndividual, :Capability ; rdfs:label "检测能力"@zh .
:record a owl:NamedIndividual, :Capability ; rdfs:label "记录能力"@zh .
:repair a owl:NamedIndividual, :Capability ; rdfs:label "维修能力"@zh .
:InspectPumpRule a owl:NamedIndividual, :MappingRule ; rdfs:label "泵站检测需要检测能力"@zh .
:RecordPumpRule a owl:NamedIndividual, :MappingRule ; rdfs:label "需要留档的泵站检测需要记录能力"@zh .
:RepairPumpRule a owl:NamedIndividual, :MappingRule ; rdfs:label "泵站维修需要维修能力"@zh .
:AllCapabilitiesAvailableRule a owl:NamedIndividual, :MappingRule ;
    rdfs:label "单个可用资源覆盖全部需求且响应不超限"@zh .
