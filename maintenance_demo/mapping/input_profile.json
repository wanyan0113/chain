{
  "schema_version": 1,
  "rules": [
    {
      "target_class": "https://example.org/maintenance#MaintenanceTask",
      "fields": [
        {"path": "https://example.org/maintenance#taskKind", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#string"},
        {"path": "https://example.org/maintenance#assetKind", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#string"},
        {"path": "https://example.org/maintenance#requiresRecord", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#boolean"},
        {"path": "https://example.org/maintenance#maxWaitMinutes", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#decimal", "min_value": 0}
      ]
    },
    {
      "target_class": "https://example.org/maintenance#Resource",
      "fields": [
        {"path": "https://example.org/maintenance#providesCapability", "min_count": 1, "value_class": "https://example.org/maintenance#Capability"},
        {"path": "https://example.org/maintenance#available", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#boolean"},
        {"path": "https://example.org/maintenance#responseMinutes", "min_count": 1, "max_count": 1, "datatype": "http://www.w3.org/2001/XMLSchema#decimal", "min_value": 0}
      ]
    }
  ]
}
