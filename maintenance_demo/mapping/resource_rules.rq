PREFIX : <https://example.org/maintenance#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# 级二：非空需求 + 单资源全覆盖 + 显式可用 + 响应不超限。
# 存在 required 绑定，防止空需求通过“全部满足”的逻辑而匹配所有资源。
CONSTRUCT { ?task :candidateResource ?resource . }
WHERE {
    ?task rdf:type/rdfs:subClassOf* :MaintenanceTask ;
          :requiresCapability ?required ; :maxWaitMinutes ?limit .
    ?resource rdf:type/rdfs:subClassOf* :Resource ;
              :available true ; :responseMinutes ?response .
    FILTER(?response <= ?limit)
    FILTER NOT EXISTS {
        ?task :requiresCapability ?missing .
        FILTER NOT EXISTS { ?resource :providesCapability ?missing . }
    }
}
