{
  "schema_version": 1,
  "rules": [
    {
      "target_class": "https://example.org/maintenance#MaintenanceTask",
      "require_instances": true,
      "fields": [
        {
          "path": "https://example.org/maintenance#requiresCapability",
          "min_count": 1,
          "value_class": "https://example.org/maintenance#Capability"
        },
        {
          "path": "https://example.org/maintenance#durationMinutes",
          "min_count": 1,
          "max_count": 1,
          "datatype": "http://www.w3.org/2001/XMLSchema#decimal",
          "min_value": 0
        },
        {
          "path": "https://example.org/maintenance#dependsOn",
          "value_class": "https://example.org/maintenance#MaintenanceTask"
        }
      ]
    },
    {
      "target_class": "https://example.org/maintenance#Resource",
      "fields": [
        {
          "path": "https://example.org/maintenance#providesCapability",
          "min_count": 1,
          "value_class": "https://example.org/maintenance#Capability"
        },
        {
          "path": "https://example.org/maintenance#available",
          "min_count": 1,
          "max_count": 1,
          "datatype": "http://www.w3.org/2001/XMLSchema#boolean"
        }
      ]
    },
    {
      "target_class": "https://example.org/maintenance#MaintenanceRequirement",
      "fields": [
        {
          "path": "https://example.org/maintenance#deadlineMinutes",
          "min_count": 1,
          "max_count": 1,
          "datatype": "http://www.w3.org/2001/XMLSchema#decimal",
          "min_value": 0
        }
      ]
    }
  ],
  "acyclic_properties": [
    "https://example.org/maintenance#dependsOn"
  ]
}
