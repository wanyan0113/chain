{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templates",
    "communication_model",
    "evaluation",
    "source_refs"
  ],
  "properties": {
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "steps",
          "allow_nonadjacent_reuse",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/condition"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "activity",
                "role",
                "capabilities",
                "min_level",
                "source_refs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "activity": {
                  "enum": [
                    "observe",
                    "decide",
                    "act",
                    "assess"
                  ]
                },
                "role": {
                  "enum": [
                    "insight",
                    "coordination",
                    "manifestation"
                  ]
                },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
                  }
                },
                "min_level": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "ontology_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
                  }
                },
                "incoming_relation": {
                  "enum": [
                    "communication",
                    "control"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "allow_nonadjacent_reuse": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking_issue_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "communication_model": {
      "enum": [
        "directed",
        "undirected"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source_refs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "feasibility_only",
            "sequential_product"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "required": [
            "ref"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(task|artifact|context)\\.[A-Za-z][A-Za-z0-9_]*$"
        },
        "op": {
          "enum": [
            "eq",
            "contains",
            "lt",
            "le",
            "gt",
            "ge"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "ref": {
          "type": "string",
          "pattern": "^(task|artifact|context)\\.[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/quantity"
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
