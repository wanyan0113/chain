{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "scope", "tasks", "artifacts", "task_rules", "artifact_rules", "links", "weights", "policies"],
  "properties": {
    "format_version": {"const": "1.0"},
    "scope": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "task_rules": {"type": "array", "items": {"$ref": "#/$defs/taskRule"}},
    "artifact_rules": {"type": "array", "items": {"$ref": "#/$defs/artifactRule"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "contexts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task", "artifact", "attributes", "source_refs", "blocking_issue_ids"], "properties": {"task": {"$ref": "#/$defs/id"}, "artifact": {"$ref": "#/$defs/id"}, "attributes": {"$ref": "#/$defs/attributes"}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["before", "after", "gap_s"], "properties": {"before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"}, "gap_s": {"type": "number", "minimum": 0}}}},
    "resource_groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "capacity", "artifacts"], "properties": {"id": {"$ref": "#/$defs/id"}, "capacity": {"type": "integer", "minimum": 1}, "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}},
    "weights": {"type": "object", "additionalProperties": false, "required": ["time", "accuracy", "cost"], "properties": {"time": {"type": "number", "minimum": 0, "maximum": 1}, "accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "cost": {"type": "number", "minimum": 0, "maximum": 1}}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["equal_metric_score", "cost_unit", "max_chain_combinations", "max_network_combinations"], "properties": {"equal_metric_score": {"type": "number", "minimum": 0, "maximum": 1}, "cost_unit": {"$ref": "#/$defs/id"}, "max_chain_combinations": {"type": "integer", "minimum": 1, "maximum": 1000000}, "max_network_combinations": {"type": "integer", "minimum": 1, "maximum": 1000000}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "role": {"enum": ["insight", "coordination", "manifestation"]},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"$ref": "#/$defs/id"}}},
    "value": {"oneOf": [{"type": "string"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, {"$ref": "#/$defs/quantity"}]},
    "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["field", "op"], "oneOf": [{"required": ["value"], "not": {"required": ["ref"]}}, {"required": ["ref"], "not": {"required": ["value"]}}], "properties": {"field": {"type": "string", "pattern": "^(task|artifact|context)\\.[A-Za-z][A-Za-z0-9_]*$"}, "op": {"enum": ["eq", "contains", "lt", "le", "gt", "ge"]}, "value": {"$ref": "#/$defs/value"}, "ref": {"type": "string", "pattern": "^(task|artifact|context)\\.[A-Za-z][A-Za-z0-9_]*$"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "target", "start_s", "attributes", "source_refs", "blocking_issue_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "start_s": {"type": "number", "minimum": 0}, "attributes": {"$ref": "#/$defs/attributes"}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["id", "role", "available", "attributes", "metrics", "capacity", "consumable", "inventory", "cooldown_s", "source_refs", "blocking_issue_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/role"}, "available": {"type": "boolean"}, "attributes": {"$ref": "#/$defs/attributes"}, "metrics": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["duration_s", "accuracy", "cost"], "properties": {"duration_s": {"type": "number", "exclusiveMinimum": 0}, "accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "cost": {"$ref": "#/$defs/quantity"}}}]}, "capacity": {"type": "integer", "minimum": 1}, "consumable": {"type": "boolean"}, "inventory": {"type": "integer", "minimum": 0}, "cooldown_s": {"type": "number", "minimum": 0}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}},
    "taskRule": {"type": "object", "additionalProperties": false, "required": ["id", "role", "capability", "when", "source_refs", "blocking_issue_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/role"}, "capability": {"$ref": "#/$defs/id"}, "when": {"type": "array", "items": {"$ref": "#/$defs/condition"}}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}},
    "artifactRule": {"type": "object", "additionalProperties": false, "required": ["id", "role", "capability", "when", "source_refs", "blocking_issue_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/role"}, "capability": {"$ref": "#/$defs/id"}, "when": {"type": "array", "items": {"$ref": "#/$defs/condition"}}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["from", "to", "communicates", "controls", "distance", "max_distance", "source_refs", "blocking_issue_ids"], "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "communicates": {"type": "boolean"}, "controls": {"type": "boolean"}, "distance": {"$ref": "#/$defs/quantity"}, "max_distance": {"$ref": "#/$defs/quantity"}, "source_refs": {"$ref": "#/$defs/refs"}, "blocking_issue_ids": {"$ref": "#/$defs/refs"}}}
  }
}
