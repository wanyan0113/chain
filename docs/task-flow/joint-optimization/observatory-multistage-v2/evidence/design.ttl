e41f94b95f05\", \"candidate-42de28dff5c3738d6df3984a67d299aa00057ee199ee7e7bfc4e82d86c6b80dc\"], \"artifacts\": [\"R-Analysis-Backup\", \"R-Dispatch\", \"R-Survey\"]}, {\"kind\": \"parallel\", \"chains\": [\"candidate-7462c2193c0e2156cbadb2dcdc884f1629d47c2341e49d6713c81f0ee9793d9f\", \"candidate-42de28dff5c3738d6df3984a67d299aa00057ee199ee7e7bfc4e82d86c6b80dc\"]}, {\"kind\": \"resource_sharing\", \"chains\": [\"candidate-7462c2193c0e2156cbadb2dcdc884f1629d47c2341e49d6713c81f0ee9793d9f\", \"candidate-42de28dff5c3738d6df3984a67d299aa00057ee199ee7e7bfc4e82d86c6b80dc\"], \"artifacts\": [\"O-Safety-Auditor\", \"R-Analysis-Backup\", \"R-Dispatch\", \"R-Survey\"]}], \"makespan_s\": 16, \"cost_per_execution\": 30, \"cost_unit\": \"demo-credit/use\"}, \"network_search\": {\"algorithm\": \"branch_and_bound\", \"candidate_combinations\": 192, \"counts_scope\": \"visited_complete_candidates\", \"evaluated\": 144, \"feasible\": 64, \"nodes\": 200, \"pruned_constraints\": 92, \"pruned_bound\": 0, \"rejections\": [{\"code\": \"CAPACITY\", \"resource\": \"R-Seal-B\", \"count\": 3}, {\"code\": \"CAPACITY\", \"resource\": \"R-Seal-C\", \"count\": 33}, {\"code\": \"CAPACITY\", \"resource\": \"R-Seal-D\", \"count\": 40}, {\"code\": \"INVENTORY\", \"resource\": \"R-Seal-B\", \"count\": 4}, {\"code\": \"INVENTORY\", \"resource\": \"R-Seal-C\", \"count\": 44}, {\"code\": \"INVENTORY\", \"resource\": \"R-Seal-D\", \"count\": 44}, {\"code\": \"TABLE10_FAIL\", \"resource\": \"parallel-groups\", \"count\": 80}], \"optimality\": \"proven\", \"score_bound_enabled\": false, \"pruned_table10\": 0, \"unknown_combinations_seen\": 0, \"audit_scope\": \"visited_complete_combinations; definite-failure prefixes pruned\", \"search_complete\": true, \"termination_reason\": \"search_exhausted\", \"table10_pruning\": []}, \"knowledge\": {\"engine\": \"HermiT + explicit-rules\", \"files\": [{\"path\": \"arcane_ontology.ttl\", \"sha256\": \"70664332810745c0d8640bfb00c65dbbc4040cea0c3720c27a54a7c916804457\", \"encoding\": \"utf-8\", \"content\": \"@prefix : <http://example.org/arcaneweb#> .\\r\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\r\\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\\r\\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\\r\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\r\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\r\\n@base <http://example.org/arcaneweb#> .\\r\\n\\r\\n<http://example.org/arcaneweb> rdf:type owl:Ontology ;\\r\\n                              rdfs:comment \\\"西幻魔法背景，中文显示名称采用奥术网、法术链、法器等术语。\\\"@zh ;\\r\\n                              rdfs:label \\\"奥术网络设计本体\\\"@zh ;\\r\\n                              owl:versionInfo \\\"0.8.1\\\" ;\\r\\n                              rdfs:comment \\\"0.8：撤下自设示例，删除未在本批文章表格中单独定义的十个通用能力字段；保留文章概念、分类、属性、结构与公式说明。未新增实例、游戏机制或执行规则。\\\"@zh .\\r\\n\\r\\n#    Object Properties\\r\\n\\r\\n###  http://example.org/arcaneweb#capabilitySupportsMission\\r\\n# 定义“capabilitySupportsMission（支撑行动任务）”关系，连接ArcaneCapability（法术能力）与ArcaneMission（行动任务）。\\r\\n:capabilitySupportsMission rdf:type owl:ObjectProperty ;\\r\\n                           owl:inverseOf :requiresCapability ;\\r\\n                           rdfs:domain :ArcaneCapability ;\\r\\n                           rdfs:range :ArcaneMission ;\\r\\n                           rdfs:label \\\"支撑行动任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#chainRelation\\r\\n# 定义“chainRelation（参与的法阵组合）”关系，连接SpellChain（法术链）与ChainRelation（法阵组合关系）。\\r\\n:chainRelation rdf:type owl:ObjectProperty ;\\r\\n               owl:inverseOf :relatedChain ;\\r\\n               rdfs:domain :SpellChain ;\\r\\n               rdfs:range :ChainRelation ;\\r\\n               rdfs:comment \\\"法术链指向法阵组合关系实例的反向链接，与 relatedChain 互逆。\\\"@zh ;\\r\\n               rdfs:label \\\"参与的法阵组合\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#chainTarget\\r\\n# 定义“chainTarget（锁定目标）”关系，连接SpellChain（法术链）与Target（交互目标）。\\r\\n:chainTarget rdf:type owl:ObjectProperty ;\\r\\n             rdfs:domain :SpellChain ;\\r\\n             rdfs:range :Target ;\\r\\n             rdfs:label \\\"锁定目标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#coordinationToManifestationCommunication\\r\\n# 定义“coordinationToManifestationCommunication（协调-具现传讯）”关系，连接CoordinationArtifact（协调法器）与ManifestationArtifact（具现法器）。\\r\\n:coordinationToManifestationCommunication rdf:type owl:ObjectProperty ;\\r\\n                              rdfs:subPropertyOf :communicatesWith ;\\r\\n                              rdfs:domain :CoordinationArtifact ;\\r\\n                              rdfs:range :ManifestationArtifact ;\\r\\n                              rdfs:comment \\\"对应论文图 3 中协调法器与具现法器之间的传讯关系。\\\"@zh ;\\r\\n                              rdfs:label \\\"协调-具现传讯\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#orchestrates\\r\\n# 定义“orchestrates（统筹法器）”关系，连接CoordinationArtifact（协调法器）与Artifact（法器）。\\r\\n:orchestrates rdf:type owl:ObjectProperty ;\\r\\n          rdfs:domain :CoordinationArtifact ;\\r\\n          rdfs:range :Artifact ;\\r\\n          rdfs:label \\\"统筹法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#communicatesWith\\r\\n# 定义“communicatesWith（魔法共鸣）”关系，连接Artifact（法器）与Artifact（法器）。\\r\\n:communicatesWith rdf:type owl:ObjectProperty ,\\r\\n                           owl:SymmetricProperty ;\\r\\n                  rdfs:domain :Artifact ;\\r\\n                  rdfs:range :Artifact ;\\r\\n                  rdfs:label \\\"魔法共鸣\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#constrainedBy\\r\\n# 定义“constrainedBy（受元素态势约束）”关系，连接ArcaneCapability（法术能力）与ElementalFieldSituation（元素场域态势）。\\r\\n:constrainedBy rdf:type owl:ObjectProperty ;\\r\\n               owl:inverseOf :situationConstrainsCapability ;\\r\\n               rdfs:domain :ArcaneCapability ;\\r\\n               rdfs:range :ElementalFieldSituation ;\\r\\n               rdfs:comment \\\"图 1 的态势→法术关系；法术能力受当前元素场域态势约束。\\\"@zh ;\\r\\n               rdfs:label \\\"受元素态势约束\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#containsTarget\\r\\n# 定义“containsTarget（态势包含目标）”关系，连接ElementalFieldSituation（元素场域态势）与Target（交互目标）。\\r\\n:containsTarget rdf:type owl:ObjectProperty ;\\r\\n                rdfs:domain :ElementalFieldSituation ;\\r\\n                rdfs:range :Target ;\\r\\n                rdfs:label \\\"态势包含目标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#detects\\r\\n# 定义“detects（感知目标）”关系，连接InsightArtifact（灵视探知法器）与Target（交互目标）。\\r\\n:detects rdf:type owl:ObjectProperty ;\\r\\n         rdfs:domain :InsightArtifact ;\\r\\n         rdfs:range :Target ;\\r\\n         rdfs:label \\\"感知目标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#finishStartPrecedes\\r\\n# 定义“finishStartPrecedes（前置施法完毕）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。\\r\\n:finishStartPrecedes rdf:type owl:ObjectProperty ;\\r\\n                     owl:inverseOf :startsAfterCompletionOf ;\\r\\n                     rdf:type owl:IrreflexiveProperty ;\\r\\n                     rdfs:domain :ArcaneMission ;\\r\\n                     rdfs:range :ArcaneMission ;\\r\\n                     rdfs:comment \\\"对应论文图 5：前一环节完成后，后一环节开始。该属性只表达直接时序，不自动计算持续时间。\\\"@zh ;\\r\\n                     rdfs:label \\\"前置施法完毕\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#fromChain\\r\\n# 定义“fromChain（起始法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。\\r\\n:fromChain rdf:type owl:ObjectProperty ;\\r\\n           rdfs:subPropertyOf :relatedChain ;\\r\\n           rdfs:domain :ChainRelation ;\\r\\n           rdfs:range :SpellChain ;\\r\\n           rdfs:comment \\\"用于串联法阵和分支法阵，表示有向关系的起点。\\\"@zh ;\\r\\n           rdfs:label \\\"起始法术链\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasCapability\\r\\n# 定义“hasCapability（具备法术）”关系，连接Artifact（法器）与ArcaneCapability（法术能力）。\\r\\n:hasCapability rdf:type owl:ObjectProperty ;\\r\\n               owl:inverseOf :realizedBy ;\\r\\n               rdfs:domain :Artifact ;\\r\\n               rdfs:range :ArcaneCapability ;\\r\\n               rdfs:comment \\\"定义域故意设为 Artifact：承载平台和挂载物都可以具备法术。若只想让功能单元具备法术，应另建 FunctionalArtifact 子类，而不是依赖注释。\\\"@zh ;\\r\\n               rdfs:label \\\"具备法术\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasChain\\r\\n# 定义“hasChain（奥术网包含法术链）”关系，连接ArcaneWeb（奥术网）与SpellChain（法术链）。\\r\\n:hasChain rdf:type owl:ObjectProperty ;\\r\\n          rdfs:domain :ArcaneWeb ;\\r\\n          rdfs:range :SpellChain ;\\r\\n          rdfs:label \\\"奥术网包含法术链\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasChainNode\\r\\n# 定义“hasChainNode（包含有序法阵节点）”关系，连接SpellChain（法术链）与ChainNode（法术链节点）。\\r\\n:hasChainNode rdf:type owl:ObjectProperty ;\\r\\n              rdfs:domain :SpellChain ;\\r\\n              rdfs:range :ChainNode ;\\r\\n              rdfs:comment \\\"法术链成员关系的唯一入口；节点顺序由 nodeOrder 和 nextNode 表达。\\\"@zh ;\\r\\n              rdfs:label \\\"包含有序法阵节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasPayload\\r\\n# 定义“hasPayload（挂载魔晶 / 搭载物）”关系，连接ArtifactPlatform（承载平台）与Artifact（法器）。\\r\\n:hasPayload rdf:type owl:ObjectProperty ;\\r\\n            owl:inverseOf :mountedOn ;\\r\\n            rdfs:domain :ArtifactPlatform ;\\r\\n            rdfs:range :Artifact ;\\r\\n            rdfs:comment \\\"扩展关系：mountedOn 的逆关系，仅用于可分离的物理挂载物；常驻协调节点使用 hosts。\\\"@zh ;\\r\\n            rdfs:label \\\"挂载魔晶 / 搭载物\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasRelation\\r\\n# 定义“hasRelation（包含法阵组合）”关系，连接ArcaneWeb（奥术网）与ChainRelation（法阵组合关系）。\\r\\n:hasRelation rdf:type owl:ObjectProperty ;\\r\\n             owl:inverseOf :relationInWeb ;\\r\\n             rdfs:domain :ArcaneWeb ;\\r\\n             rdfs:range :ChainRelation ;\\r\\n             rdfs:label \\\"包含法阵组合\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasSituation\\r\\n# 定义“hasSituation（任务所处环境）”关系，连接ArcaneMission（行动任务）与ElementalFieldSituation（元素场域态势）。\\r\\n:hasSituation rdf:type owl:ObjectProperty ;\\r\\n              rdfs:domain :ArcaneMission ;\\r\\n              rdfs:range :ElementalFieldSituation ;\\r\\n              rdfs:comment \\\"图 1 中行动任务与元素场域态势共同决定所需法术的任务侧入口。\\\"@zh ;\\r\\n              rdfs:label \\\"任务所处环境\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasSubMission\\r\\n# 定义“hasSubMission（包含子任务）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。\\r\\n:hasSubMission rdf:type owl:ObjectProperty ;\\r\\n               rdfs:domain :ArcaneMission ;\\r\\n               rdfs:range :ArcaneMission ;\\r\\n               rdfs:comment \\\"扩展：行动任务分解关系。\\\"@zh ;\\r\\n               rdfs:label \\\"包含子任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hasTarget\\r\\n# 定义“hasTarget（任务目标）”关系，连接ArcaneMission（行动任务）与Target（交互目标）。\\r\\n:hasTarget rdf:type owl:ObjectProperty ;\\r\\n           rdfs:domain :ArcaneMission ;\\r\\n           rdfs:range :Target ;\\r\\n           rdfs:label \\\"任务目标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#hosts\\r\\n# 定义“hosts（承载节点）”关系，连接ArtifactPlatform（承载平台）与Artifact（法器）。\\r\\n:hosts rdf:type owl:ObjectProperty ;\\r\\n       rdfs:domain :ArtifactPlatform ;\\r\\n       rdfs:range :Artifact ;\\r\\n       rdfs:comment \\\"扩展关系：承载平台提供常驻或集成节点（如灵视探知魔像上的联合统筹中枢）；不等同于可分离的物理挂载物。\\\"@zh ;\\r\\n       rdfs:label \\\"承载节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#judgmentToDecisionCommunication\\r\\n# 定义“judgmentToDecisionCommunication（占卜-决断传讯）”关系，连接JudgmentArtifact（占卜法器）与DecisionArtifact（决断法器）。\\r\\n:judgmentToDecisionCommunication rdf:type owl:ObjectProperty ;\\r\\n                                 rdfs:subPropertyOf :communicatesWith ;\\r\\n                                 rdfs:domain :JudgmentArtifact ;\\r\\n                                 rdfs:range :DecisionArtifact ;\\r\\n                                 rdfs:comment \\\"对应论文图 3 中占卜法器与决断法器之间的传讯关系。\\\"@zh ;\\r\\n                                 rdfs:label \\\"占卜-决断传讯\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#mountedOn\\r\\n# 定义“mountedOn（附魔于 / 挂载于）”关系，连接Artifact（法器）与ArtifactPlatform（承载平台）。\\r\\n:mountedOn rdf:type owl:ObjectProperty ;\\r\\n           rdfs:domain :Artifact ;\\r\\n           rdfs:range :ArtifactPlatform ;\\r\\n           rdfs:comment \\\"扩展关系：表示可分离的物理挂载关系，例如探知挂件、魔晶载体支架。标签中的“附魔于”仅为该物理挂载关系的背景化称呼，不另行表示赋予魔法效果的过程。\\\"@zh ;\\r\\n           rdfs:label \\\"附魔于 / 挂载于\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#nextNode\\r\\n# 定义“nextNode（下一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。\\r\\n:nextNode rdf:type owl:ObjectProperty ;\\r\\n          owl:inverseOf :previousNode ;\\r\\n          rdf:type owl:FunctionalProperty ,\\r\\n                   owl:IrreflexiveProperty ;\\r\\n          rdfs:domain :ChainNode ;\\r\\n          rdfs:range :ChainNode ;\\r\\n          rdfs:comment \\\"单后继关系。OWL 不能保证后继属于同一条法术链、无环或与 nodeOrder 一致，这些需由 SHACL 或程序校验。\\\"@zh ;\\r\\n          rdfs:label \\\"下一节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#nodeArtifact\\r\\n# 定义“nodeArtifact（节点法器）”关系，连接ChainNode（法术链节点）与Artifact（法器）。\\r\\n:nodeArtifact rdf:type owl:ObjectProperty ;\\r\\n               rdfs:domain :ChainNode ;\\r\\n               rdfs:range :Artifact ;\\r\\n               rdfs:label \\\"节点法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#previousNode\\r\\n# 定义“previousNode（上一节点）”关系，连接ChainNode（法术链节点）与ChainNode（法术链节点）。\\r\\n:previousNode rdf:type owl:ObjectProperty ;\\r\\n              rdfs:domain :ChainNode ;\\r\\n              rdfs:range :ChainNode ;\\r\\n              rdfs:label \\\"上一节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#realizedBy\\r\\n# 定义“realizedBy（由法器释放）”关系，连接ArcaneCapability（法术能力）与Artifact（法器）。\\r\\n:realizedBy rdf:type owl:ObjectProperty ;\\r\\n            rdfs:domain :ArcaneCapability ;\\r\\n            rdfs:range :Artifact ;\\r\\n            rdfs:label \\\"由法器释放\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#insightToCoordinationCommunication\\r\\n# 定义“insightToCoordinationCommunication（灵视探知-协调传讯）”关系，连接InsightArtifact（灵视探知法器）与CoordinationArtifact（协调法器）。\\r\\n:insightToCoordinationCommunication rdf:type owl:ObjectProperty ;\\r\\n                             rdfs:subPropertyOf :communicatesWith ;\\r\\n                             rdfs:domain :InsightArtifact ;\\r\\n                             rdfs:range :CoordinationArtifact ;\\r\\n                             rdfs:comment \\\"对应论文图 3 中灵视探知法器与协调法器之间的传讯关系。\\\"@zh ;\\r\\n                             rdfs:label \\\"灵视探知-协调传讯\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#relatedChain\\r\\n# 定义“relatedChain（关联法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。\\r\\n:relatedChain rdf:type owl:ObjectProperty ;\\r\\n              rdfs:domain :ChainRelation ;\\r\\n              rdfs:range :SpellChain ;\\r\\n              rdfs:comment \\\"法阵组合关系实例的参与法术链集合。并列法阵用它列出全部参与者。\\\"@zh ;\\r\\n              rdfs:label \\\"关联法术链\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#relationInWeb\\r\\n# 定义“relationInWeb（所属奥术网）”关系，连接ChainRelation（法阵组合关系）与ArcaneWeb（奥术网）。\\r\\n:relationInWeb rdf:type owl:ObjectProperty ;\\r\\n               rdfs:domain :ChainRelation ;\\r\\n               rdfs:range :ArcaneWeb ;\\r\\n               rdfs:label \\\"所属奥术网\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#requirementConstrainsCapability\\r\\n# 定义“requirementConstrainsCapability（需求约束法术）”关系，连接InvocationRequirement（施法需求）与ArcaneCapability（法术能力）。\\r\\n:requirementConstrainsCapability rdf:type owl:ObjectProperty ;\\r\\n                                 rdfs:domain :InvocationRequirement ;\\r\\n                                 rdfs:range :ArcaneCapability ;\\r\\n                                 rdfs:comment \\\"图 1 中施法需求参与决定所需法术。\\\"@zh ;\\r\\n                                 rdfs:label \\\"需求约束法术\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#requirementConstrainsArtifact\\r\\n# 定义“requirementConstrainsArtifact（需求约束法器）”关系，连接InvocationRequirement（施法需求）与Artifact（法器）。\\r\\n:requirementConstrainsArtifact rdf:type owl:ObjectProperty ;\\r\\n                                rdfs:domain :InvocationRequirement ;\\r\\n                                rdfs:range :Artifact ;\\r\\n                                rdfs:comment \\\"图 1 中施法需求参与决定所需法器；协同关系仍由第二章规则处理。\\\"@zh ;\\r\\n                                rdfs:label \\\"需求约束法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#requirementForMission\\r\\n# 定义“requirementForMission（面向行动任务）”关系，连接InvocationRequirement（施法需求）与ArcaneMission（行动任务）。\\r\\n:requirementForMission rdf:type owl:ObjectProperty ;\\r\\n                       rdfs:domain :InvocationRequirement ;\\r\\n                       rdfs:range :ArcaneMission ;\\r\\n                       rdfs:comment \\\"表 1 将施法需求定义为完成可能担负任务的基本要求；该属性把需求挂到行动任务上。\\\"@zh ;\\r\\n                       rdfs:label \\\"面向行动任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#requiresCapability\\r\\n# 定义“requiresCapability（需要法术）”关系，连接ArcaneMission（行动任务）与ArcaneCapability（法术能力）。\\r\\n:requiresCapability rdf:type owl:ObjectProperty ;\\r\\n                    rdfs:domain :ArcaneMission ;\\r\\n                    rdfs:range :ArcaneCapability ;\\r\\n                    rdfs:label \\\"需要法术\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#satisfiesRequirement\\r\\n# 定义“satisfiesRequirement（满足施法需求）”关系，连接ArcaneWeb（奥术网）与InvocationRequirement（施法需求）。\\r\\n:satisfiesRequirement rdf:type owl:ObjectProperty ;\\r\\n                      rdfs:domain :ArcaneWeb ;\\r\\n                      rdfs:range :InvocationRequirement ;\\r\\n                      rdfs:comment \\\"扩展：只表达设计结果与施法需求的关联，不是自动判定满足。\\\"@zh ;\\r\\n                      rdfs:label \\\"满足施法需求\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#situationConstrainsCapability\\r\\n# 定义“situationConstrainsCapability（态势约束法术）”关系，连接ElementalFieldSituation（元素场域态势）与ArcaneCapability（法术能力）。\\r\\n:situationConstrainsCapability rdf:type owl:ObjectProperty ;\\r\\n                               rdfs:domain :ElementalFieldSituation ;\\r\\n                               rdfs:range :ArcaneCapability ;\\r\\n                               rdfs:comment \\\"图 1 的反向读法；与 constrainedBy 互逆。\\\"@zh ;\\r\\n                               rdfs:label \\\"态势约束法术\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#startsAfterCompletionOf\\r\\n# 定义“startsAfterCompletionOf（在上一环节结束后启动）”关系，连接ArcaneMission（行动任务）与ArcaneMission（行动任务）。\\r\\n:startsAfterCompletionOf rdf:type owl:ObjectProperty ;\\r\\n                         rdfs:domain :ArcaneMission ;\\r\\n                         rdfs:range :ArcaneMission ;\\r\\n                         rdfs:label \\\"在上一环节结束后启动\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#supportsMission\\r\\n# 定义“supportsMission（支撑行动任务）”关系，连接ArcaneWeb（奥术网）与ArcaneMission（行动任务）。\\r\\n:supportsMission rdf:type owl:ObjectProperty ;\\r\\n                 rdfs:domain :ArcaneWeb ;\\r\\n                 rdfs:range :ArcaneMission ;\\r\\n                 rdfs:label \\\"支撑行动任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#toChain\\r\\n# 定义“toChain（目标法术链）”关系，连接ChainRelation（法阵组合关系）与SpellChain（法术链）。\\r\\n:toChain rdf:type owl:ObjectProperty ;\\r\\n         rdfs:subPropertyOf :relatedChain ;\\r\\n         rdfs:domain :ChainRelation ;\\r\\n         rdfs:range :SpellChain ;\\r\\n         rdfs:comment \\\"用于串联法阵和分支法阵，表示有向关系的终点。\\\"@zh ;\\r\\n         rdfs:label \\\"目标法术链\\\"@zh .\\r\\n\\r\\n\\r\\n#    Data properties\\r\\n\\r\\n###  http://example.org/arcaneweb#altitudeFt\\r\\n# 定义“altitudeFt（浮空势位（尺））”数据属性，记录Artifact（法器）的浮空势位（尺），值类型为 xsd:decimal。\\r\\n:altitudeFt rdf:type owl:DatatypeProperty ;\\r\\n            rdfs:domain :Artifact ;\\r\\n            rdfs:range xsd:decimal ;\\r\\n            rdfs:comment \\\"沿用原版法器海拔的参照面和英尺单位；“浮空势位”为背景化显示名称，不改为相对地面的离地高度，也不限定法器必须处于悬浮状态。\\\"@zh ;\\r\\n            rdfs:label \\\"浮空势位（尺）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#azimuthCoverageDeg\\r\\n# 定义“azimuthCoverageDeg（方位感知区（度））”数据属性，记录InsightArtifact（灵视探知法器）的方位感知区（度），值类型为 xsd:decimal。\\r\\n:azimuthCoverageDeg rdf:type owl:DatatypeProperty ;\\r\\n                    rdfs:domain :InsightArtifact ;\\r\\n                    rdfs:range xsd:decimal ;\\r\\n                    rdfs:label \\\"方位感知区（度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#azimuthResolutionDeg\\r\\n# 定义“azimuthResolutionDeg（方位角感知误差（度））”数据属性，记录InsightArtifact（灵视探知法器）的方位角感知误差（度），值类型为 xsd:decimal。\\r\\n:azimuthResolutionDeg rdf:type owl:DatatypeProperty ;\\r\\n                      rdfs:domain :InsightArtifact ;\\r\\n                      rdfs:range xsd:decimal ;\\r\\n                      rdfs:label \\\"方位角感知误差（度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#chainId\\r\\n# 定义“chainId（法术链编号）”数据属性，记录SpellChain（法术链）的法术链编号，值类型为 xsd:string。\\r\\n:chainId rdf:type owl:DatatypeProperty ,\\r\\n                  owl:FunctionalProperty ;\\r\\n         rdfs:domain :SpellChain ;\\r\\n         rdfs:range xsd:string ;\\r\\n         rdfs:label \\\"法术链编号\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#climbSpeedKn\\r\\n# 定义“climbSpeedKn（升空速度（迅捷度））”数据属性，记录ManifestationArtifact（具现法器）的升空速度（迅捷度），值类型为 xsd:decimal。\\r\\n:climbSpeedKn rdf:type owl:DatatypeProperty ;\\r\\n              rdfs:domain :ManifestationArtifact ;\\r\\n              rdfs:range xsd:decimal ;\\r\\n              rdfs:label \\\"升空速度（迅捷度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#communicationBandwidthMbps\\r\\n# 定义“communicationBandwidthMbps（传音频段（Mbps））”数据属性，记录CoordinationArtifact（协调法器）的传音频段（Mbps），值类型为 xsd:decimal。\\r\\n:communicationBandwidthMbps rdf:type owl:DatatypeProperty ;\\r\\n                            rdfs:domain :CoordinationArtifact ;\\r\\n                            rdfs:range xsd:decimal ;\\r\\n                            rdfs:label \\\"传音频段（Mbps）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#communicationPowerW\\r\\n# 定义“communicationPowerW（传讯功率（瓦））”数据属性，记录CoordinationArtifact（协调法器）的传讯功率（瓦），值类型为 xsd:decimal。\\r\\n:communicationPowerW rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :CoordinationArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"传讯功率（瓦）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#cost\\r\\n# 定义“cost（附魔造价（使用成本））”数据属性，记录Artifact（法器）的附魔造价（使用成本），值类型为 xsd:decimal。\\r\\n:cost rdf:type owl:DatatypeProperty ;\\r\\n      rdfs:domain :Artifact ;\\r\\n      rdfs:range xsd:decimal ;\\r\\n      rdfs:label \\\"附魔造价（使用成本）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#disturbanceRadiusM\\r\\n# 定义“disturbanceRadiusM（扰动半径（米））”数据属性，记录ManifestationArtifact（具现法器）的扰动半径（米），值类型为 xsd:decimal。\\r\\n:disturbanceRadiusM rdf:type owl:DatatypeProperty ;\\r\\n               rdfs:domain :ManifestationArtifact ;\\r\\n               rdfs:range xsd:decimal ;\\r\\n               rdfs:label \\\"扰动半径（米）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#disturbanceRate\\r\\n# 定义“disturbanceRate（扰动率（0-1））”数据属性，记录ManifestationArtifact（具现法器）的扰动率（0-1），值类型为 xsd:decimal。\\r\\n:disturbanceRate rdf:type owl:DatatypeProperty ;\\r\\n            rdfs:domain :ManifestationArtifact ;\\r\\n            rdfs:range xsd:decimal ;\\r\\n            rdfs:label \\\"扰动率（0-1）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#manifestationPotency\\r\\n# 定义“manifestationPotency（共鸣效值）”数据属性，记录ManifestationArtifact（具现法器）的共鸣效值，值类型为 xsd:decimal。\\r\\n:manifestationPotency rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ManifestationArtifact ;\\r\\n             rdfs:range xsd:decimal ;\\r\\n             rdfs:label \\\"共鸣效值\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#detectionPrecision\\r\\n# 定义“detectionPrecision（灵视探知精度（0-1））”数据属性，记录InsightArtifact（灵视探知法器）的灵视探知精度（0-1），值类型为 xsd:decimal。\\r\\n:detectionPrecision rdf:type owl:DatatypeProperty ;\\r\\n                    rdfs:domain :InsightArtifact ;\\r\\n                    rdfs:range xsd:decimal ;\\r\\n                    rdfs:comment \\\"论文表 3 的灵视探知精度由距离/方位/俯仰感知误差表示；本属性是便于比较的汇总值（扩展）。\\\"@zh ;\\r\\n                    rdfs:label \\\"灵视探知精度（0-1）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#detectionRangeNm\\r\\n# 定义“detectionRangeNm（灵视探知距离（里））”数据属性，记录InsightArtifact（灵视探知法器）的灵视探知距离（里），值类型为 xsd:decimal。\\r\\n:detectionRangeNm rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :InsightArtifact ;\\r\\n                  rdfs:range xsd:decimal ;\\r\\n                  rdfs:label \\\"灵视探知距离（里）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#distanceResolutionM\\r\\n# 定义“distanceResolutionM（距离感知误差（米））”数据属性，记录InsightArtifact（灵视探知法器）的距离感知误差（米），值类型为 xsd:decimal。\\r\\n:distanceResolutionM rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :InsightArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"距离感知误差（米）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#elevationCoverageDeg\\r\\n# 定义“elevationCoverageDeg（俯仰感知区（度））”数据属性，记录InsightArtifact（灵视探知法器）的俯仰感知区（度），值类型为 xsd:decimal。\\r\\n:elevationCoverageDeg rdf:type owl:DatatypeProperty ;\\r\\n                      rdfs:domain :InsightArtifact ;\\r\\n                      rdfs:range xsd:decimal ;\\r\\n                      rdfs:label \\\"俯仰感知区（度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#elevationResolutionDeg\\r\\n# 定义“elevationResolutionDeg（俯仰角感知误差（度））”数据属性，记录InsightArtifact（灵视探知法器）的俯仰角感知误差（度），值类型为 xsd:decimal。\\r\\n:elevationResolutionDeg rdf:type owl:DatatypeProperty ;\\r\\n                        rdfs:domain :InsightArtifact ;\\r\\n                        rdfs:range xsd:decimal ;\\r\\n                        rdfs:label \\\"俯仰角感知误差（度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#artifactCategory\\r\\n# 定义“artifactCategory（法器分类）”数据属性，记录Artifact（法器）的法器分类，值类型为 xsd:string。\\r\\n:artifactCategory rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :Artifact ;\\r\\n                   rdfs:range xsd:string ;\\r\\n                   rdfs:label \\\"法器分类\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#artifactId\\r\\n# 定义“artifactId（法器标识）”数据属性，记录Artifact（法器）的法器标识，值类型为 xsd:string。\\r\\n:artifactId rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :Artifact ;\\r\\n             rdfs:range xsd:string ;\\r\\n             rdfs:label \\\"法器标识\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#artifactName\\r\\n# 定义“artifactName（法器名称）”数据属性，记录Artifact（法器）的法器名称，值类型为 xsd:string。\\r\\n:artifactName rdf:type owl:DatatypeProperty ;\\r\\n               rdfs:domain :Artifact ;\\r\\n               rdfs:range xsd:string ;\\r\\n               rdfs:label \\\"法器名称\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#artifactShortName\\r\\n# 定义“artifactShortName（法器简称）”数据属性，记录Artifact（法器）的法器简称，值类型为 xsd:string。\\r\\n:artifactShortName rdf:type owl:DatatypeProperty ;\\r\\n                    rdfs:domain :Artifact ;\\r\\n                    rdfs:range xsd:string ;\\r\\n                    rdfs:label \\\"法器简称\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#evaluationAreaKm2\\r\\n# 定义“evaluationAreaKm2（解析区域（平方千米））”数据属性，记录CoordinationArtifact（协调法器）的解析区域（平方千米），值类型为 xsd:decimal。\\r\\n:evaluationAreaKm2 rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :CoordinationArtifact ;\\r\\n                   rdfs:range xsd:decimal ;\\r\\n                   rdfs:label \\\"解析区域（平方千米）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#evaluationTimeS\\r\\n# 定义“evaluationTimeS（解析耗时（秒））”数据属性，记录CoordinationArtifact（协调法器）的解析耗时（秒），值类型为 xsd:decimal。\\r\\n:evaluationTimeS rdf:type owl:DatatypeProperty ;\\r\\n                 rdfs:domain :CoordinationArtifact ;\\r\\n                 rdfs:range xsd:decimal ;\\r\\n                 rdfs:label \\\"解析耗时（秒）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#flightAltitudeFt\\r\\n# 定义“flightAltitudeFt（飞行高度（尺））”数据属性，记录ManifestationArtifact（具现法器）的飞行高度（尺），值类型为 xsd:decimal。\\r\\n:flightAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :ManifestationArtifact ;\\r\\n                  rdfs:range xsd:decimal ;\\r\\n                  rdfs:label \\\"飞行高度（尺）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#flightSpeedKn\\r\\n# 定义“flightSpeedKn（飞行极速（迅捷度））”数据属性，记录ManifestationArtifact（具现法器）的飞行极速（迅捷度），值类型为 xsd:decimal。\\r\\n:flightSpeedKn rdf:type owl:DatatypeProperty ;\\r\\n               rdfs:domain :ManifestationArtifact ;\\r\\n               rdfs:range xsd:decimal ;\\r\\n               rdfs:label \\\"飞行极速（迅捷度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#attunementProbability\\r\\n# 定义“attunementProbability（灵性锁定率（0-1））”数据属性，记录ManifestationArtifact（具现法器）的灵性锁定率（0-1），值类型为 xsd:decimal。\\r\\n:attunementProbability rdf:type owl:DatatypeProperty ;\\r\\n                rdfs:domain :ManifestationArtifact ;\\r\\n                rdfs:range xsd:decimal ;\\r\\n                rdfs:label \\\"灵性锁定率（0-1）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#latitudeDeg\\r\\n# 定义“latitudeDeg（星象坐标（纬））”数据属性，记录Artifact（法器）的星象坐标（纬），值类型为 xsd:decimal。\\r\\n:latitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :Artifact ;\\r\\n             rdfs:range xsd:decimal ;\\r\\n             rdfs:label \\\"星象坐标（纬）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#longitudeDeg\\r\\n# 定义“longitudeDeg（星象坐标（经））”数据属性，记录Artifact（法器）的星象坐标（经），值类型为 xsd:decimal。\\r\\n:longitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n              rdfs:domain :Artifact ;\\r\\n              rdfs:range xsd:decimal ;\\r\\n              rdfs:label \\\"星象坐标（经）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxCommDistanceNm\\r\\n# 定义“maxCommDistanceNm（最大传讯距离（里））”数据属性，记录Artifact（法器）的最大传讯距离（里），值类型为 xsd:decimal。\\r\\n:maxCommDistanceNm rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :Artifact ;\\r\\n                   rdfs:range xsd:decimal ;\\r\\n                   rdfs:comment \\\"论文 2.1.2 法器协同规则所需的扩展属性。\\\"@zh ;\\r\\n                   rdfs:label \\\"最大传讯距离（里）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxEvaluationTargets\\r\\n# 定义“maxEvaluationTargets（单次解析目标数）”数据属性，记录CoordinationArtifact（协调法器）的单次解析目标数，值类型为 xsd:integer。\\r\\n:maxEvaluationTargets rdf:type owl:DatatypeProperty ;\\r\\n                      rdfs:domain :CoordinationArtifact ;\\r\\n                      rdfs:range xsd:integer ;\\r\\n                      rdfs:label \\\"单次解析目标数\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxActivationAltitudeFt\\r\\n# 定义“maxActivationAltitudeFt（最大激发基准）”数据属性，记录ManifestationArtifact（具现法器）的最大激发基准，值类型为 xsd:decimal。\\r\\n:maxActivationAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :ManifestationArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"最大激发基准\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxRangeNm\\r\\n# 定义“maxRangeNm（最大魔力触及距离（里））”数据属性，记录ManifestationArtifact（具现法器）的最大魔力触及距离（里），值类型为 xsd:decimal。\\r\\n:maxRangeNm rdf:type owl:DatatypeProperty ;\\r\\n            rdfs:domain :ManifestationArtifact ;\\r\\n            rdfs:range xsd:decimal ;\\r\\n            rdfs:label \\\"最大魔力触及距离（里）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxInsightMarks\\r\\n# 定义“maxInsightMarks（最大神识标记数）”数据属性，记录InsightArtifact（灵视探知法器）的最大神识标记数，值类型为 xsd:integer。\\r\\n:maxInsightMarks rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :InsightArtifact ;\\r\\n                  rdfs:range xsd:integer ;\\r\\n                  rdfs:label \\\"最大神识标记数\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxTargetAltitudeFt\\r\\n# 定义“maxTargetAltitudeFt（目标高位弦长）”数据属性，记录ManifestationArtifact（具现法器）的目标高位弦长，值类型为 xsd:decimal。\\r\\n:maxTargetAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :ManifestationArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"目标高位弦长\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#maxTargetSpeedKn\\r\\n# 定义“maxTargetSpeedKn（目标飞行极速）”数据属性，记录ManifestationArtifact（具现法器）可处理目标的速度上限，值类型为 xsd:decimal；仍沿用节口径。\\r\\n:maxTargetSpeedKn rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :ManifestationArtifact ;\\r\\n                  rdfs:range xsd:decimal ;\\r\\n                  rdfs:label \\\"目标飞行极速\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#minActivationAltitudeFt\\r\\n# 定义“minActivationAltitudeFt（最小激发基准）”数据属性，记录ManifestationArtifact（具现法器）的最小激发基准，值类型为 xsd:decimal。\\r\\n:minActivationAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :ManifestationArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"最小激发基准\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#minRangeNm\\r\\n# 定义“minRangeNm（最小魔力触及距离（里））”数据属性，记录ManifestationArtifact（具现法器）的最小魔力触及距离（里），值类型为 xsd:decimal。\\r\\n:minRangeNm rdf:type owl:DatatypeProperty ;\\r\\n            rdfs:domain :ManifestationArtifact ;\\r\\n            rdfs:range xsd:decimal ;\\r\\n            rdfs:label \\\"最小魔力触及距离（里）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#minTargetAltitudeFt\\r\\n# 定义“minTargetAltitudeFt（目标低位弦长）”数据属性，记录ManifestationArtifact（具现法器）的目标低位弦长，值类型为 xsd:decimal。\\r\\n:minTargetAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :ManifestationArtifact ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:label \\\"目标低位弦长\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionCode\\r\\n# 定义“missionCode（任务代号）”数据属性，记录ArcaneMission（行动任务）的任务代号，值类型为 xsd:string。\\r\\n:missionCode rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ArcaneMission ;\\r\\n             rdfs:range xsd:string ;\\r\\n             rdfs:label \\\"任务代号\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionLocation\\r\\n# 定义“missionLocation（任务地点）”数据属性，记录ArcaneMission（行动任务）的任务地点，值类型为 xsd:string。\\r\\n:missionLocation rdf:type owl:DatatypeProperty ;\\r\\n                 rdfs:domain :ArcaneMission ;\\r\\n                 rdfs:range xsd:string ;\\r\\n                 rdfs:label \\\"任务地点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionMetrics\\r\\n# 定义“missionMetrics（任务指标）”数据属性，记录ArcaneMission（行动任务）的任务指标，值类型为 xsd:string。\\r\\n:missionMetrics rdf:type owl:DatatypeProperty ;\\r\\n                rdfs:domain :ArcaneMission ;\\r\\n                rdfs:range xsd:string ;\\r\\n                rdfs:label \\\"任务指标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionName\\r\\n# 定义“missionName（任务名称）”数据属性，记录ArcaneMission（行动任务）的任务名称，值类型为 xsd:string。\\r\\n:missionName rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ArcaneMission ;\\r\\n             rdfs:range xsd:string ;\\r\\n             rdfs:label \\\"任务名称\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionShortName\\r\\n# 定义“missionShortName（任务简称）”数据属性，记录ArcaneMission（行动任务）的任务简称，值类型为 xsd:string。\\r\\n:missionShortName rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :ArcaneMission ;\\r\\n                  rdfs:range xsd:string ;\\r\\n                  rdfs:label \\\"任务简称\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetAltitudeFt\\r\\n# 定义“missionTargetAltitudeFt（目标高度（尺））”数据属性，记录ArcaneMission（行动任务）的目标高度（尺），值类型为 xsd:decimal。\\r\\n:missionTargetAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                         rdfs:domain :ArcaneMission ;\\r\\n                         rdfs:range xsd:decimal ;\\r\\n                         rdfs:label \\\"目标高度（尺）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetLatitudeDeg\\r\\n# 定义“missionTargetLatitudeDeg（目标星象坐标（纬））”数据属性，记录ArcaneMission（行动任务）的目标星象坐标（纬），值类型为 xsd:decimal。\\r\\n:missionTargetLatitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n                          rdfs:domain :ArcaneMission ;\\r\\n                          rdfs:range xsd:decimal ;\\r\\n                          rdfs:label \\\"目标星象坐标（纬）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetLongitudeDeg\\r\\n# 定义“missionTargetLongitudeDeg（目标星象坐标（经））”数据属性，记录ArcaneMission（行动任务）的目标星象坐标（经），值类型为 xsd:decimal。\\r\\n:missionTargetLongitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n                           rdfs:domain :ArcaneMission ;\\r\\n                           rdfs:range xsd:decimal ;\\r\\n                           rdfs:label \\\"目标星象坐标（经）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetSpeedKn\\r\\n# 定义“missionTargetSpeedKn（目标速度（迅捷度））”数据属性，记录ArcaneMission（行动任务）的目标速度（迅捷度），值类型为 xsd:decimal。\\r\\n:missionTargetSpeedKn rdf:type owl:DatatypeProperty ;\\r\\n                      rdfs:domain :ArcaneMission ;\\r\\n                      rdfs:range xsd:decimal ;\\r\\n                      rdfs:label \\\"目标速度（迅捷度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetImpedanceThreshold\\r\\n# 定义“missionTargetImpedanceThreshold（目标阻抗阈值）”数据属性，记录ArcaneMission（行动任务）的目标阻抗阈值，值类型为 xsd:decimal。\\r\\n:missionTargetImpedanceThreshold rdf:type owl:DatatypeProperty ;\\r\\n                            rdfs:domain :ArcaneMission ;\\r\\n                            rdfs:range xsd:decimal ;\\r\\n                            rdfs:comment \\\"任务侧的目标阻抗指标，沿用原版 missionTargetImpedanceThreshold 的数值尺度和计算口径；“目标阻抗阈值”为背景化显示名称，不额外引入特定元素抗性或新的计算公式。\\\"@zh ;\\r\\n                            rdfs:label \\\"目标阻抗阈值\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTargetType\\r\\n# 定义“missionTargetType（目标类型）”数据属性，记录ArcaneMission（行动任务）的目标类型，值类型为 xsd:string。\\r\\n:missionTargetType rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :ArcaneMission ;\\r\\n                   rdfs:range xsd:string ;\\r\\n                   rdfs:label \\\"目标类型\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionTime\\r\\n# 定义“missionTime（任务时间）”数据属性，记录ArcaneMission（行动任务）的任务时间，值类型为 xsd:dateTime。\\r\\n:missionTime rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ArcaneMission ;\\r\\n             rdfs:range xsd:dateTime ;\\r\\n             rdfs:label \\\"任务时间\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#missionType\\r\\n# 定义“missionType（任务类型）”数据属性，记录ArcaneMission（行动任务）的任务类型，值类型为 xsd:string。\\r\\n:missionType rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ArcaneMission ;\\r\\n             rdfs:range xsd:string ;\\r\\n             rdfs:label \\\"任务类型\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#nodeOrder\\r\\n# 定义“nodeOrder（法阵节点顺序）”数据属性，记录ChainNode（法术链节点）的法阵节点顺序，值类型为 xsd:integer。\\r\\n:nodeOrder rdf:type owl:DatatypeProperty ,\\r\\n                    owl:FunctionalProperty ;\\r\\n           rdfs:domain :ChainNode ;\\r\\n           rdfs:range xsd:integer ;\\r\\n           rdfs:comment \\\"只记录单个法阵节点的序号；同一法术链内序号唯一、连续等约束不适合用 OWL 表达，需由 SHACL 或程序检查。\\\"@zh ;\\r\\n           rdfs:label \\\"法阵节点顺序\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#nodeRole\\r\\n# 定义“nodeRole（节点职能）”数据属性，记录ChainNode（法术链节点）的节点职能，值类型为 xsd:string。\\r\\n:nodeRole rdf:type owl:DatatypeProperty ;\\r\\n          rdfs:domain :ChainNode ;\\r\\n          rdfs:range xsd:string ;\\r\\n          rdfs:label \\\"节点职能\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#artifactStatus\\r\\n# 定义“artifactStatus（法器状态）”数据属性，记录Artifact（法器）的法器状态，值类型为 xsd:string。\\r\\n:artifactStatus rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :Artifact ;\\r\\n                   rdfs:range xsd:string ;\\r\\n                   rdfs:label \\\"法器状态\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#insightIntervalS\\r\\n# 定义“insightIntervalS（灵视探知时间间隔（秒））”数据属性，记录InsightArtifact（灵视探知法器）的灵视探知时间间隔（秒），值类型为 xsd:decimal。\\r\\n:insightIntervalS rdf:type owl:DatatypeProperty ;\\r\\n                rdfs:domain :InsightArtifact ;\\r\\n                rdfs:range xsd:decimal ;\\r\\n                rdfs:label \\\"灵视探知时间间隔（秒）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#insightTargetType\\r\\n# 定义“insightTargetType（灵视探知目标类型）”数据属性，记录InsightArtifact（灵视探知法器）的灵视探知目标类型，值类型为 xsd:string。\\r\\n:insightTargetType rdf:type owl:DatatypeProperty ;\\r\\n                 rdfs:domain :InsightArtifact ;\\r\\n                 rdfs:range xsd:string ;\\r\\n                 rdfs:label \\\"灵视探知目标类型\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#relationEndTime\\r\\n# 定义“relationEndTime（法阵解除时间）”数据属性，记录ChainRelation（法阵组合关系）的法阵解除时间，值类型为 xsd:dateTime。\\r\\n:relationEndTime rdf:type owl:DatatypeProperty ;\\r\\n                 rdfs:domain :ChainRelation ;\\r\\n                 rdfs:range xsd:dateTime ;\\r\\n                 rdfs:label \\\"法阵解除时间\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#relationStartTime\\r\\n# 定义“relationStartTime（法阵生效时间）”数据属性，记录ChainRelation（法阵组合关系）的法阵生效时间，值类型为 xsd:dateTime。\\r\\n:relationStartTime rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :ChainRelation ;\\r\\n                   rdfs:range xsd:dateTime ;\\r\\n                   rdfs:label \\\"法阵生效时间\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#relayDelayMs\\r\\n# 定义“relayDelayMs（魔力共鸣延迟（毫秒））”数据属性，记录CoordinationArtifact（协调法器）的魔力共鸣延迟（毫秒），值类型为 xsd:decimal。\\r\\n:relayDelayMs rdf:type owl:DatatypeProperty ;\\r\\n              rdfs:domain :CoordinationArtifact ;\\r\\n              rdfs:range xsd:decimal ;\\r\\n              rdfs:label \\\"魔力共鸣延迟（毫秒）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#manaRechargeTimeS\\r\\n# 定义“manaRechargeTimeS（魔力回充耗时（秒））”数据属性，记录ManifestationArtifact（具现法器）的魔力回充耗时（秒），值类型为 xsd:decimal。\\r\\n:manaRechargeTimeS rdf:type owl:DatatypeProperty ;\\r\\n             rdfs:domain :ManifestationArtifact ;\\r\\n             rdfs:range xsd:decimal ;\\r\\n             rdfs:label \\\"魔力回充耗时（秒）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#responseTimeS\\r\\n# 定义“responseTimeS（吟唱耗时（秒））”数据属性，记录ManifestationArtifact（具现法器）的吟唱耗时（秒），值类型为 xsd:decimal。\\r\\n:responseTimeS rdf:type owl:DatatypeProperty ;\\r\\n               rdfs:domain :ManifestationArtifact ;\\r\\n               rdfs:range xsd:decimal ;\\r\\n               rdfs:label \\\"吟唱耗时（秒）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#multiCastCount\\r\\n# 定义“multiCastCount（多重施法连发数）”数据属性，记录ManifestationArtifact（具现法器）的多重施法连发数，值类型为 xsd:integer。\\r\\n:multiCastCount rdf:type owl:DatatypeProperty ;\\r\\n           rdfs:domain :ManifestationArtifact ;\\r\\n           rdfs:range xsd:integer ;\\r\\n           rdfs:label \\\"多重施法连发数\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#speedKn\\r\\n# 定义“speedKn（飞行极速（迅捷度））”数据属性，记录Artifact（法器）的飞行极速（迅捷度），值类型为 xsd:decimal。\\r\\n:speedKn rdf:type owl:DatatypeProperty ;\\r\\n         rdfs:domain :Artifact ;\\r\\n         rdfs:range xsd:decimal ;\\r\\n         rdfs:label \\\"飞行极速（迅捷度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#manifestationTargetType\\r\\n# 定义“manifestationTargetType（具现目标类型）”数据属性，记录ManifestationArtifact（具现法器）的具现目标类型，值类型为 xsd:string。\\r\\n:manifestationTargetType rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :ManifestationArtifact ;\\r\\n                  rdfs:range xsd:string ;\\r\\n                  rdfs:label \\\"具现目标类型\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetAltitudeFt\\r\\n# 定义“targetAltitudeFt（目标高度（尺））”数据属性，记录Target（交互目标）的目标高度（尺），值类型为 xsd:decimal。\\r\\n:targetAltitudeFt rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :Target ;\\r\\n                  rdfs:range xsd:decimal ;\\r\\n                  rdfs:label \\\"目标高度（尺）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetDistanceNm\\r\\n# 定义“targetDistanceNm（目标距离（里））”数据属性，记录ArcaneMission（行动任务）的目标距离（里），值类型为 xsd:decimal。\\r\\n:targetDistanceNm rdf:type owl:DatatypeProperty ;\\r\\n                  rdfs:domain :ArcaneMission ;\\r\\n                  rdfs:range xsd:decimal ;\\r\\n                  rdfs:comment \\\"扩展：表 5 之外补充的目标距离字段。\\\"@zh ;\\r\\n                  rdfs:label \\\"目标距离（里）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetLatitudeDeg\\r\\n# 定义“targetLatitudeDeg（目标星象坐标（纬））”数据属性，记录Target（交互目标）的目标星象坐标（纬），值类型为 xsd:decimal。\\r\\n:targetLatitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n                   rdfs:domain :Target ;\\r\\n                   rdfs:range xsd:decimal ;\\r\\n                   rdfs:label \\\"目标星象坐标（纬）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetLongitudeDeg\\r\\n# 定义“targetLongitudeDeg（目标星象坐标（经））”数据属性，记录Target（交互目标）的目标星象坐标（经），值类型为 xsd:decimal。\\r\\n:targetLongitudeDeg rdf:type owl:DatatypeProperty ;\\r\\n                    rdfs:domain :Target ;\\r\\n                    rdfs:range xsd:decimal ;\\r\\n                    rdfs:label \\\"目标星象坐标（经）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetSpeedKn\\r\\n# 定义“targetSpeedKn（目标速度（迅捷度））”数据属性，记录Target（交互目标）的目标速度（迅捷度），值类型为 xsd:decimal。\\r\\n:targetSpeedKn rdf:type owl:DatatypeProperty ;\\r\\n               rdfs:domain :Target ;\\r\\n               rdfs:range xsd:decimal ;\\r\\n               rdfs:label \\\"目标速度（迅捷度）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetImpedanceThreshold\\r\\n# 定义“targetImpedanceThreshold（目标阻抗阈值）”数据属性，记录Target（交互目标）的目标阻抗阈值，值类型为 xsd:decimal。\\r\\n:targetImpedanceThreshold rdf:type owl:DatatypeProperty ;\\r\\n                     rdfs:domain :Target ;\\r\\n                     rdfs:range xsd:decimal ;\\r\\n                     rdfs:comment \\\"目标侧的阻抗指标，沿用原版 targetImpedanceThreshold 的数值尺度和计算口径；“目标阻抗阈值”为背景化显示名称，不额外引入特定元素抗性或新的计算公式。\\\"@zh ;\\r\\n                     rdfs:label \\\"目标阻抗阈值\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#targetType\\r\\n# 定义“targetType（目标类型）”数据属性，记录Target（交互目标）的目标类型，值类型为 xsd:string。\\r\\n:targetType rdf:type owl:DatatypeProperty ;\\r\\n            rdfs:domain :Target ;\\r\\n            rdfs:range xsd:string ;\\r\\n            rdfs:label \\\"目标类型\\\"@zh .\\r\\n\\r\\n\\r\\n#    Classes\\r\\n\\r\\n###  http://example.org/arcaneweb#ElementalFieldSituation\\r\\n# 构建“ElementalFieldSituation（元素场域态势）”类，定义该概念的相关信息和约束。\\r\\n:ElementalFieldSituation rdf:type owl:Class ;\\r\\n                      rdfs:comment \\\"元素场域中魔力分布及元素环境的当前状态和发展变化趋势。\\\"@zh ;\\r\\n                      rdfs:label \\\"元素场域态势\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#BranchRelation\\r\\n# 构建“BranchRelation（分支法阵）”类，归属于“ChainRelation（法阵组合关系）”类。\\r\\n:BranchRelation rdf:type owl:Class ;\\r\\n                rdfs:subClassOf :ChainRelation ;\\r\\n                rdfs:label \\\"分支法阵\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ChainNode\\r\\n# 构建“ChainNode（法术链节点）”类，定义该概念的相关信息和约束。\\r\\n:ChainNode rdf:type owl:Class ;\\r\\n           rdfs:comment \\\"1.6 扩展：用于表达节点顺序、职能和法器关联；本文件中它是法术链结构的唯一权威表示。\\\"@zh ;\\r\\n           rdfs:label \\\"法术链节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ChainRelation\\r\\n# 构建“ChainRelation（法阵组合关系）”类，定义该概念的相关信息和约束。\\r\\n:ChainRelation rdf:type owl:Class ;\\r\\n               rdfs:subClassOf [ rdf:type owl:Restriction ;\\r\\n                                 owl:onProperty :relatedChain ;\\r\\n                                 owl:minQualifiedCardinality \\\"2\\\"^^xsd:nonNegativeInteger ;\\r\\n                                 owl:onClass :SpellChain\\r\\n                               ] ;\\r\\n               rdfs:comment \\\"2.1.3 扩展：以具体关系实例表达并列、串联、分支等法阵组合。并列法阵用 relatedChain 列出参与者，有向法阵用 fromChain/toChain 表示方向；不再使用法术链到法术链的直接属性。\\\"@zh ;\\r\\n               rdfs:label \\\"法阵组合关系\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ArcaneCapability\\r\\n# 构建“ArcaneCapability（法术能力）”类，定义该概念的相关信息和约束。\\r\\n:ArcaneCapability rdf:type owl:Class ;\\r\\n                  rdfs:comment \\\"法器执行行动任务的本领，是法器体系的固有属性，与型号、法术参数等有关。\\\"@zh ;\\r\\n                  rdfs:label \\\"法术能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ArcaneMission\\r\\n# 构建“ArcaneMission（行动任务）”类，定义该概念的相关信息和约束。\\r\\n:ArcaneMission rdf:type owl:Class ;\\r\\n               rdfs:comment \\\"奥术网为实现行动目标需要完成的各种任务的统称，包括探知、研判、决断、施法等。\\\"@zh ;\\r\\n               rdfs:label \\\"行动任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#OrchestrationCapability\\r\\n# 构建“OrchestrationCapability（统筹能力）”类，归属于“CoordinationCapability（协调能力）”类。\\r\\n:OrchestrationCapability rdf:type owl:Class ;\\r\\n                   rdfs:subClassOf :CoordinationCapability ;\\r\\n                   rdfs:label \\\"统筹能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CoordinationChainNode\\r\\n# 构建“CoordinationChainNode（协调链节点）”类，归属于“ChainNode（法术链节点）”类。\\r\\n:CoordinationChainNode rdf:type owl:Class ;\\r\\n                  rdfs:subClassOf :ChainNode ,\\r\\n                                  [ rdf:type owl:Restriction ;\\r\\n                                    owl:onProperty :nodeArtifact ;\\r\\n                                    owl:someValuesFrom :CoordinationArtifact\\r\\n                                  ] ;\\r\\n                  rdfs:label \\\"协调链节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CoordinationCapability\\r\\n# 构建“CoordinationCapability（协调能力）”类，归属于“ArcaneCapability（法术能力）”类。\\r\\n:CoordinationCapability rdf:type owl:Class ;\\r\\n                          rdfs:subClassOf :ArcaneCapability ;\\r\\n                          rdfs:label \\\"协调能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CoordinationArtifact\\r\\n# 构建“CoordinationArtifact（协调法器）”类，归属于“Artifact（法器）”类。\\r\\n:CoordinationArtifact rdf:type owl:Class ;\\r\\n                         rdfs:subClassOf :Artifact ,\\r\\n                                         [ rdf:type owl:Restriction ;\\r\\n                                           owl:onProperty :hasCapability ;\\r\\n                                           owl:someValuesFrom :CoordinationCapability\\r\\n                                         ] ;\\r\\n                         rdfs:comment \\\"各类协调机构，是奥术网的核心，对一切魔法活动执行决断；包括联合统筹中枢、浮空艇群组协调中枢等。\\\"@zh ;\\r\\n                         rdfs:label \\\"协调法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CoordinationMission\\r\\n# 构建“CoordinationMission（协调任务）”类，归属于“ArcaneMission（行动任务）”类。\\r\\n:CoordinationMission rdf:type owl:Class ;\\r\\n                       rdfs:subClassOf :ArcaneMission ,\\r\\n                                       [ rdf:type owl:Restriction ;\\r\\n                                         owl:onProperty :requiresCapability ;\\r\\n                                         owl:someValuesFrom :CoordinationCapability\\r\\n                                       ] ;\\r\\n                       rdfs:label \\\"协调任务\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CoordinationPlatform\\r\\n# 构建“CoordinationPlatform（协调平台）”类，归属于“CoordinationArtifact（协调法器）”类。\\r\\n:CoordinationPlatform rdf:type owl:Class ;\\r\\n                        rdfs:subClassOf :CoordinationArtifact ,\\r\\n                                        :ArtifactPlatform ;\\r\\n                        rdfs:comment \\\"扩展子类：浮空艇群组协调中枢等承载协调节点的平台。论文表 2 把这类协调机构也归入协调法器。\\\"@zh ;\\r\\n                        rdfs:label \\\"协调平台\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CommunicationCapability\\r\\n# 构建“CommunicationCapability（传讯能力）”类，归属于“CoordinationCapability（协调能力）”类。\\r\\n:CommunicationCapability rdf:type owl:Class ;\\r\\n                         rdfs:subClassOf :CoordinationCapability ;\\r\\n                         rdfs:label \\\"传讯能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#DecisionCapability\\r\\n# 构建“DecisionCapability（决断能力）”类，归属于“CoordinationCapability（协调能力）”类。\\r\\n:DecisionCapability rdf:type owl:Class ;\\r\\n                    rdfs:subClassOf :CoordinationCapability ;\\r\\n                    rdfs:label \\\"决断能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#DecisionArtifact\\r\\n# 构建“DecisionArtifact（决断法器）”类，归属于“CoordinationArtifact（协调法器）”类。\\r\\n:DecisionArtifact rdf:type owl:Class ;\\r\\n                   rdfs:subClassOf :CoordinationArtifact ,\\r\\n                                   [ rdf:type owl:Restriction ;\\r\\n                                     owl:onProperty :hasCapability ;\\r\\n                                     owl:someValuesFrom :DecisionCapability\\r\\n                                   ] ;\\r\\n                   rdfs:label \\\"决断法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#DecisionMission\\r\\n# 构建“DecisionMission（决断任务（D 决断））”类，归属于“CoordinationMission（协调任务）”类。\\r\\n:DecisionMission rdf:type owl:Class ;\\r\\n                 rdfs:subClassOf :CoordinationMission ,\\r\\n                                 [ rdf:type owl:Restriction ;\\r\\n                                   owl:onProperty :requiresCapability ;\\r\\n                                   owl:someValuesFrom :DecisionCapability\\r\\n                                 ] ;\\r\\n                 rdfs:label \\\"决断任务（D 决断）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ArtifactPlatform\\r\\n# 构建“ArtifactPlatform（承载平台）”类，归属于“Artifact（法器）”类。\\r\\n:ArtifactPlatform rdf:type owl:Class ;\\r\\n                   rdfs:subClassOf :Artifact ;\\r\\n                   rdfs:comment \\\"扩展类：承载感知装置、协调节点或魔晶载体的云翼灵兽、浮空艇、符文载具、施法台等平台。\\\"@zh ;\\r\\n                   rdfs:label \\\"承载平台\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#EvaluationCapability\\r\\n# 构建“EvaluationCapability（解析能力）”类，归属于“CoordinationCapability（协调能力）”类。\\r\\n:EvaluationCapability rdf:type owl:Class ;\\r\\n                      rdfs:subClassOf :CoordinationCapability ;\\r\\n                      rdfs:label \\\"解析能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#JudgmentCapability\\r\\n# 构建“JudgmentCapability（占卜能力）”类，归属于“CoordinationCapability（协调能力）”类。\\r\\n:JudgmentCapability rdf:type owl:Class ;\\r\\n                    rdfs:subClassOf :CoordinationCapability ;\\r\\n                    rdfs:label \\\"占卜能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#JudgmentArtifact\\r\\n# 构建“JudgmentArtifact（占卜法器）”类，归属于“CoordinationArtifact（协调法器）”类。\\r\\n:JudgmentArtifact rdf:type owl:Class ;\\r\\n                   rdfs:subClassOf :CoordinationArtifact ,\\r\\n                                   [ rdf:type owl:Restriction ;\\r\\n                                     owl:onProperty :hasCapability ;\\r\\n                                     owl:someValuesFrom :JudgmentCapability\\r\\n                                   ] ;\\r\\n                   rdfs:label \\\"占卜法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#JudgmentMission\\r\\n# 构建“JudgmentMission（占卜任务（O2 研判））”类，归属于“CoordinationMission（协调任务）”类。\\r\\n:JudgmentMission rdf:type owl:Class ;\\r\\n                 rdfs:subClassOf :CoordinationMission ,\\r\\n                                 [ rdf:type owl:Restriction ;\\r\\n                                   owl:onProperty :requiresCapability ;\\r\\n                                   owl:someValuesFrom :JudgmentCapability\\r\\n                                 ] ;\\r\\n                 rdfs:label \\\"占卜任务（O2 研判）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#SpellChain\\r\\n# 构建“SpellChain（法术链）”类，定义该概念的相关信息和约束。\\r\\n:SpellChain rdf:type owl:Class ;\\r\\n           rdfs:subClassOf [ rdf:type owl:Restriction ;\\r\\n                             owl:onProperty :chainTarget ;\\r\\n                             owl:someValuesFrom :Target\\r\\n                           ] ,\\r\\n                           [ rdf:type owl:Restriction ;\\r\\n                             owl:onProperty :hasChainNode ;\\r\\n                             owl:someValuesFrom :CoordinationChainNode\\r\\n                           ] ,\\r\\n                           [ rdf:type owl:Restriction ;\\r\\n                             owl:onProperty :hasChainNode ;\\r\\n                             owl:someValuesFrom :InsightChainNode\\r\\n                           ] ,\\r\\n                           [ rdf:type owl:Restriction ;\\r\\n                             owl:onProperty :hasChainNode ;\\r\\n                             owl:someValuesFrom :ManifestationChainNode\\r\\n                           ] ;\\r\\n           rdfs:comment \\\"1.6/2.x 扩展：由交互目标、灵视探知、协调、具现节点构成的闭合施法链路。第 6 节的 someValuesFrom 公理只要求存在相应角色节点和目标，不校验节点顺序、连通性、闭环和资源冲突。\\\"@zh ;\\r\\n           rdfs:label \\\"法术链\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ArcaneWeb\\r\\n# 构建“ArcaneWeb（奥术网）”类，定义该概念的相关信息和约束。\\r\\n:ArcaneWeb rdf:type owl:Class ;\\r\\n         rdfs:subClassOf [ rdf:type owl:Restriction ;\\r\\n                           owl:onProperty :hasChain ;\\r\\n                           owl:someValuesFrom :SpellChain\\r\\n                         ] ;\\r\\n         rdfs:comment \\\"1.6/2.x 扩展：多条法术链通过共享节点和法阵组合关系形成的分布式施法网络。\\\"@zh ;\\r\\n         rdfs:label \\\"奥术网\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InvocationRequirement\\r\\n# 构建“InvocationRequirement（施法需求）”类，定义该概念的相关信息和约束。\\r\\n:InvocationRequirement rdf:type owl:Class ;\\r\\n                        rdfs:comment \\\"在一定的时期，为完成可能担负的行动任务，对魔法力量建设的基本要求。暂时只建立需求与行动任务、法术、法器的关系。\\\"@zh ;\\r\\n                        rdfs:label \\\"施法需求\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ParallelRelation\\r\\n# 构建“ParallelRelation（并列法阵）”类，归属于“ChainRelation（法阵组合关系）”类。\\r\\n:ParallelRelation rdf:type owl:Class ;\\r\\n                  rdfs:subClassOf :ChainRelation ;\\r\\n                  rdfs:label \\\"并列法阵\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightCapability\\r\\n# 构建“InsightCapability（灵视探知能力）”类，归属于“ArcaneCapability（法术能力）”类。\\r\\n:InsightCapability rdf:type owl:Class ;\\r\\n                 rdfs:subClassOf :ArcaneCapability ;\\r\\n                 rdfs:label \\\"灵视探知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightChainNode\\r\\n# 构建“InsightChainNode（灵视探知链节点）”类，归属于“ChainNode（法术链节点）”类。\\r\\n:InsightChainNode rdf:type owl:Class ;\\r\\n                rdfs:subClassOf :ChainNode ,\\r\\n                                [ rdf:type owl:Restriction ;\\r\\n                                  owl:onProperty :nodeArtifact ;\\r\\n                                  owl:someValuesFrom :InsightArtifact\\r\\n                                ] ;\\r\\n                rdfs:label \\\"灵视探知链节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightArtifact\\r\\n# 构建“InsightArtifact（灵视探知法器）”类，归属于“Artifact（法器）”类。\\r\\n:InsightArtifact rdf:type owl:Class ;\\r\\n                rdfs:subClassOf :Artifact ,\\r\\n                                [ rdf:type owl:Restriction ;\\r\\n                                  owl:onProperty :hasCapability ;\\r\\n                                  owl:someValuesFrom :InsightCapability\\r\\n                                ] ;\\r\\n                rdfs:comment \\\"灵视探知类单元平台，承担发现、搜集共鸣空间信息参数并回传的任务；包括感知魔像、探知魔像、探知法阵、星界探知镜等。感知挂载和灵视探知平台都归入此类。\\\"@zh ;\\r\\n                rdfs:label \\\"灵视探知法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightMission\\r\\n# 构建“InsightMission（灵视探知任务（O1 探知））”类，归属于“ArcaneMission（行动任务）”类。\\r\\n:InsightMission rdf:type owl:Class ;\\r\\n              rdfs:subClassOf :ArcaneMission ,\\r\\n                              [ rdf:type owl:Restriction ;\\r\\n                                owl:onProperty :requiresCapability ;\\r\\n                                owl:someValuesFrom :InsightCapability\\r\\n                              ] ;\\r\\n              rdfs:label \\\"灵视探知任务（O1 探知）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightPlatform\\r\\n# 构建“InsightPlatform（灵视探知平台）”类，归属于“ArtifactPlatform（承载平台）”类。\\r\\n:InsightPlatform rdf:type owl:Class ;\\r\\n               rdfs:subClassOf :ArtifactPlatform ,\\r\\n                               :InsightArtifact ;\\r\\n               rdfs:comment \\\"扩展子类：感知魔像、探知魔像、星界探知镜等承载灵视探知挂载的平台。论文表 2 把这类单元平台也归入灵视探知法器。\\\"@zh ;\\r\\n               rdfs:label \\\"灵视探知平台\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightRangeCapability\\r\\n# 构建“InsightRangeCapability（感知距离能力）”类，归属于“InsightCapability（灵视探知能力）”类。\\r\\n:InsightRangeCapability rdf:type owl:Class ;\\r\\n                      rdfs:subClassOf :InsightCapability ;\\r\\n                      rdfs:label \\\"感知距离能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InsightTargetTypeCapability\\r\\n# 构建“InsightTargetTypeCapability（灵视探知目标类型能力）”类，归属于“InsightCapability（灵视探知能力）”类。\\r\\n:InsightTargetTypeCapability rdf:type owl:Class ;\\r\\n                           rdfs:subClassOf :InsightCapability ;\\r\\n                           rdfs:label \\\"灵视探知目标类型能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#SerialRelation\\r\\n# 构建“SerialRelation（串联法阵）”类，归属于“ChainRelation（法阵组合关系）”类。\\r\\n:SerialRelation rdf:type owl:Class ;\\r\\n                rdfs:subClassOf :ChainRelation ;\\r\\n                rdfs:label \\\"串联法阵\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationAltitudeCapability\\r\\n# 构建“ManifestationAltitudeCapability（具现高度能力）”类，归属于“ManifestationCapability（具现能力）”类。\\r\\n:ManifestationAltitudeCapability rdf:type owl:Class ;\\r\\n                          rdfs:subClassOf :ManifestationCapability ;\\r\\n                          rdfs:label \\\"具现高度能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#CrystalVessel\\r\\n# 构建“CrystalVessel（魔晶载体）”类，归属于“ManifestationArtifact（具现法器）”类。\\r\\n:CrystalVessel rdf:type owl:Class ;\\r\\n                  rdfs:subClassOf :ManifestationArtifact ;\\r\\n                  rdfs:comment \\\"扩展类：魔晶载体、辉光载体等一次性或可消耗的具现挂载。魔晶载体可以通过 mountedOn 关联承载平台，但本类不强制所有实例都已挂载。\\\"@zh ;\\r\\n                  rdfs:label \\\"魔晶载体\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationCapability\\r\\n# 构建“ManifestationCapability（具现能力）”类，归属于“ArcaneCapability（法术能力）”类。\\r\\n:ManifestationCapability rdf:type owl:Class ;\\r\\n                  rdfs:subClassOf :ArcaneCapability ;\\r\\n                  rdfs:label \\\"具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationChainNode\\r\\n# 构建“ManifestationChainNode（具现链节点）”类，归属于“ChainNode（法术链节点）”类。\\r\\n:ManifestationChainNode rdf:type owl:Class ;\\r\\n                 rdfs:subClassOf :ChainNode ,\\r\\n                                 [ rdf:type owl:Restriction ;\\r\\n                                   owl:onProperty :nodeArtifact ;\\r\\n                                   owl:someValuesFrom :ManifestationArtifact\\r\\n                                 ] ;\\r\\n                 rdfs:comment \\\"节点法器取具现法器，既可以是释放平台，也可以是魔晶载体。\\\"@zh ;\\r\\n                 rdfs:label \\\"具现链节点\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationArtifact\\r\\n# 构建“ManifestationArtifact（具现法器）”类，归属于“Artifact（法器）”类。\\r\\n:ManifestationArtifact rdf:type owl:Class ;\\r\\n                 rdfs:subClassOf :Artifact ,\\r\\n                                 [ rdf:type owl:Restriction ;\\r\\n                                   owl:onProperty :hasCapability ;\\r\\n                                   owl:someValuesFrom :ManifestationCapability\\r\\n                                 ] ;\\r\\n                 rdfs:comment \\\"功能角色类：表示可执行魔法抵消和魔力消解任务的功能单元，在协调节点的协调安排和灵视探知节点的信息传输下，对交互目标进行扰动或具现。既包括具现平台，也包括魔晶载体，不限定为承载平台。原版表 3 的具现属性以本类为定义域；CrystalVessel 作为子类继承相关属性的适用范围。\\\"@zh ;\\r\\n                 rdfs:label \\\"具现法器\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationMission\\r\\n# 构建“ManifestationMission（具现任务（A 施法））”类，归属于“ArcaneMission（行动任务）”类。\\r\\n:ManifestationMission rdf:type owl:Class ;\\r\\n               rdfs:subClassOf :ArcaneMission ,\\r\\n                               [ rdf:type owl:Restriction ;\\r\\n                                 owl:onProperty :requiresCapability ;\\r\\n                                 owl:someValuesFrom :ManifestationCapability\\r\\n                               ] ;\\r\\n               rdfs:label \\\"具现任务（A 施法）\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationPlatform\\r\\n# 构建“ManifestationPlatform（具现平台）”类，归属于“ArtifactPlatform（承载平台）”类。\\r\\n:ManifestationPlatform rdf:type owl:Class ;\\r\\n                rdfs:subClassOf :ArtifactPlatform ,\\r\\n                                :ManifestationArtifact ;\\r\\n                rdfs:comment \\\"扩展子类：御风灵舟、守护法阵、浮空艇等可释放或投掷魔晶载体的平台。平台归入具现法器是论文的建模方式；魔晶载体是消耗性挂载。\\\"@zh ;\\r\\n                rdfs:label \\\"具现平台\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationRangeCapability\\r\\n# 构建“ManifestationRangeCapability（具现距离能力）”类，归属于“ManifestationCapability（具现能力）”类。\\r\\n:ManifestationRangeCapability rdf:type owl:Class ;\\r\\n                       rdfs:subClassOf :ManifestationCapability ;\\r\\n                       rdfs:label \\\"具现距离能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationTargetQuantityCapability\\r\\n# 构建“ManifestationTargetQuantityCapability（具现目标数量能力）”类，归属于“ManifestationCapability（具现能力）”类。\\r\\n:ManifestationTargetQuantityCapability rdf:type owl:Class ;\\r\\n                                rdfs:subClassOf :ManifestationCapability ;\\r\\n                                rdfs:label \\\"具现目标数量能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ManifestationTargetTypeCapability\\r\\n# 构建“ManifestationTargetTypeCapability（具现目标类型能力）”类，归属于“ManifestationCapability（具现能力）”类。\\r\\n:ManifestationTargetTypeCapability rdf:type owl:Class ;\\r\\n                            rdfs:subClassOf :ManifestationCapability ;\\r\\n                            rdfs:label \\\"具现目标类型能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#Target\\r\\n# 构建“Target（交互目标）”类，定义该概念的相关信息和约束。\\r\\n:Target rdf:type owl:Class ;\\r\\n        rdfs:comment \\\"1.6/2.x 扩展：行动任务需要感知、跟踪、具现或解析的对方对象。\\\"@zh ;\\r\\n        rdfs:label \\\"交互目标\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#Artifact\\r\\n# 构建“Artifact（法器）”类，定义该概念的相关信息和约束。\\r\\n:Artifact rdf:type owl:Class ;\\r\\n                 rdfs:comment \\\"为遂行一定的行动任务、具有一定魔法功能的法器系统，是奥术网的最小组成功能要素。\\\"@zh ;\\r\\n                 rdfs:label \\\"法器\\\"@zh .\\r\\n\\r\\n\\r\\n#    Individuals\\r\\n\\r\\n###  http://example.org/arcaneweb#AirInsightCapability\\r\\n# 定义“AirInsightCapability（空中灵视探知能力）”规范能力个体，属于“InsightTargetTypeCapability（灵视探知目标类型能力）”类。\\r\\n:AirInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                             :InsightTargetTypeCapability ;\\r\\n                    rdfs:label \\\"空中灵视探知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#AirManifestationCapability\\r\\n# 定义“AirManifestationCapability（对空具现能力）”规范能力个体，属于“ManifestationTargetTypeCapability（具现目标类型能力）”类。\\r\\n:AirManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                              :ManifestationTargetTypeCapability ;\\r\\n                     rdfs:label \\\"对空具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InterferenceResistantTransmissionCapability\\r\\n# 定义“InterferenceResistantTransmissionCapability（抗共鸣扰动传讯能力）”规范能力个体，属于“CommunicationCapability（传讯能力）”类。\\r\\n:InterferenceResistantTransmissionCapability rdf:type owl:NamedIndividual ,\\r\\n                                            :CommunicationCapability ;\\r\\n                                   rdfs:label \\\"抗共鸣扰动传讯能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#AreaManifestationCapability\\r\\n# 定义“AreaManifestationCapability（范围具现能力）”规范能力个体，属于“ManifestationTargetQuantityCapability（具现目标数量能力）”类。\\r\\n:AreaManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                               :ManifestationTargetQuantityCapability ;\\r\\n                      rdfs:label \\\"范围具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#GroundInsightCapability\\r\\n# 定义“GroundInsightCapability（地面灵视探知能力）”规范能力个体，属于“InsightTargetTypeCapability（灵视探知目标类型能力）”类。\\r\\n:GroundInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                                :InsightTargetTypeCapability ;\\r\\n                       rdfs:label \\\"地面灵视探知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#GroundManifestationCapability\\r\\n# 定义“GroundManifestationCapability（对地具现能力）”规范能力个体，属于“ManifestationTargetTypeCapability（具现目标类型能力）”类。\\r\\n:GroundManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                 :ManifestationTargetTypeCapability ;\\r\\n                        rdfs:label \\\"对地具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#HighAltitudeManifestationCapability\\r\\n# 定义“HighAltitudeManifestationCapability（高空具现能力）”规范能力个体，属于“ManifestationAltitudeCapability（具现高度能力）”类。\\r\\n:HighAltitudeManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                       :ManifestationAltitudeCapability ;\\r\\n                              rdfs:label \\\"高空具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#InformationRelayCapability\\r\\n# 定义“InformationRelayCapability（魔法信息中继能力）”规范能力个体，属于“CommunicationCapability（传讯能力）”类。\\r\\n:InformationRelayCapability rdf:type owl:NamedIndividual ,\\r\\n                                     :CommunicationCapability ;\\r\\n                            rdfs:label \\\"魔法信息中继能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#LongRangeInsightCapability\\r\\n# 定义“LongRangeInsightCapability（远程感知能力）”规范能力个体，属于“InsightRangeCapability（感知距离能力）”类。\\r\\n:LongRangeInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                                   :InsightRangeCapability ;\\r\\n                          rdfs:label \\\"远程感知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#LongRangeManifestationCapability\\r\\n# 定义“LongRangeManifestationCapability（远程具现能力）”规范能力个体，属于“ManifestationRangeCapability（具现距离能力）”类。\\r\\n:LongRangeManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                    :ManifestationRangeCapability ;\\r\\n                           rdfs:label \\\"远程具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#LowAltitudeManifestationCapability\\r\\n# 定义“LowAltitudeManifestationCapability（低空具现能力）”规范能力个体，属于“ManifestationAltitudeCapability（具现高度能力）”类。\\r\\n:LowAltitudeManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                      :ManifestationAltitudeCapability ;\\r\\n                             rdfs:label \\\"低空具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#MediumRangeInsightCapability\\r\\n# 定义“MediumRangeInsightCapability（中程感知能力）”规范能力个体，属于“InsightRangeCapability（感知距离能力）”类。\\r\\n:MediumRangeInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                                     :InsightRangeCapability ;\\r\\n                            rdfs:label \\\"中程感知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#MediumRangeManifestationCapability\\r\\n# 定义“MediumRangeManifestationCapability（中程具现能力）”规范能力个体，属于“ManifestationRangeCapability（具现距离能力）”类。\\r\\n:MediumRangeManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                      :ManifestationRangeCapability ;\\r\\n                             rdfs:label \\\"中程具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#MultiArtifactOrchestrationCapability\\r\\n# 定义“MultiArtifactOrchestrationCapability（多法器协同统筹能力）”规范能力个体，属于“OrchestrationCapability（统筹能力）”类。\\r\\n:MultiArtifactOrchestrationCapability rdf:type owl:NamedIndividual ,\\r\\n                                          :OrchestrationCapability ;\\r\\n                                 rdfs:label \\\"多法器协同统筹能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#MultiTargetEvaluationCapability\\r\\n# 定义“MultiTargetEvaluationCapability（多目标解析能力）”规范能力个体，属于“EvaluationCapability（解析能力）”类。\\r\\n:MultiTargetEvaluationCapability rdf:type owl:NamedIndividual ,\\r\\n                                          :EvaluationCapability ;\\r\\n                                 rdfs:label \\\"多目标解析能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#RapidEvaluationCapability\\r\\n# 定义“RapidEvaluationCapability（快速解析能力）”规范能力个体，属于“EvaluationCapability（解析能力）”类。\\r\\n:RapidEvaluationCapability rdf:type owl:NamedIndividual ,\\r\\n                                    :EvaluationCapability ;\\r\\n                           rdfs:label \\\"快速解析能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#RapidResponseCoordinationCapability\\r\\n# 定义“RapidResponseCoordinationCapability（快速响应能力）”规范能力个体，属于“OrchestrationCapability（统筹能力）”类。\\r\\n:RapidResponseCoordinationCapability rdf:type owl:NamedIndividual ,\\r\\n                                         :OrchestrationCapability ;\\r\\n                                rdfs:label \\\"快速响应能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#BeastManifestationCapability\\r\\n# 定义“BeastManifestationCapability（对大型灵兽具现能力）”规范能力个体，属于“ManifestationTargetTypeCapability（具现目标类型能力）”类。\\r\\n:BeastManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                               :ManifestationTargetTypeCapability ;\\r\\n                      rdfs:label \\\"对大型灵兽具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ShortRangeInsightCapability\\r\\n# 定义“ShortRangeInsightCapability（近程感知能力）”规范能力个体，属于“InsightRangeCapability（感知距离能力）”类。\\r\\n:ShortRangeInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                                    :InsightRangeCapability ;\\r\\n                           rdfs:label \\\"近程感知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#ShortRangeManifestationCapability\\r\\n# 定义“ShortRangeManifestationCapability（近程具现能力）”规范能力个体，属于“ManifestationRangeCapability（具现距离能力）”类。\\r\\n:ShortRangeManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                     :ManifestationRangeCapability ;\\r\\n                            rdfs:label \\\"近程具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#SinglePointManifestationCapability\\r\\n# 定义“SinglePointManifestationCapability（单体具现能力）”规范能力个体，属于“ManifestationTargetQuantityCapability（具现目标数量能力）”类。\\r\\n:SinglePointManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                      :ManifestationTargetQuantityCapability ;\\r\\n                             rdfs:label \\\"单体具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#AstralInsightCapability\\r\\n# 定义“AstralInsightCapability（星界灵视探知能力）”规范能力个体，属于“InsightTargetTypeCapability（灵视探知目标类型能力）”类。\\r\\n:AstralInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                               :InsightTargetTypeCapability ;\\r\\n                      rdfs:label \\\"星界灵视探知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#AstralManifestationCapability\\r\\n# 定义“AstralManifestationCapability（星界具现能力）”规范能力个体，属于“ManifestationAltitudeCapability（具现高度能力）”类。\\r\\n:AstralManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                :ManifestationAltitudeCapability ;\\r\\n                       rdfs:label \\\"星界具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#DeepCreatureManifestationCapability\\r\\n# 定义“DeepCreatureManifestationCapability（对深水灵兽具现能力）”规范能力个体，属于“ManifestationTargetTypeCapability（具现目标类型能力）”类。\\r\\n:DeepCreatureManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                    :ManifestationTargetTypeCapability ;\\r\\n                           rdfs:label \\\"对深水灵兽具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#UnderwaterInsightCapability\\r\\n# 定义“UnderwaterInsightCapability（水下灵视探知能力）”规范能力个体，属于“InsightTargetTypeCapability（灵视探知目标类型能力）”类。\\r\\n:UnderwaterInsightCapability rdf:type owl:NamedIndividual ,\\r\\n                                    :InsightTargetTypeCapability ;\\r\\n                           rdfs:label \\\"水下灵视探知能力\\\"@zh .\\r\\n\\r\\n\\r\\n###  http://example.org/arcaneweb#UnderwaterManifestationCapability\\r\\n# 定义“UnderwaterManifestationCapability（水下具现能力）”规范能力个体，属于“ManifestationAltitudeCapability（具现高度能力）”类。\\r\\n:UnderwaterManifestationCapability rdf:type owl:NamedIndividual ,\\r\\n                                     :ManifestationAltitudeCapability ;\\r\\n                            rdfs:label \\\"水下具现能力\\\"@zh .\\r\\n\\r\\n\\r\\n#    0.7 文献对照与说明目录\\r\\n# 以下 AnnotationProperty 用于描述术语，不参与 domain/range 或业务关系推理。\\r\\n\\r\\n:sourceSection a owl:AnnotationProperty ;\\r\\n    rdfs:label \\\"参考章节\\\"@zh ;\\r\\n    rdfs:comment \\\"用户提供的截图中的章节或表号；属于来源定位，不表示逐字转录。\\\"@zh .\\r\\n:correspondsToPhase a owl:AnnotationProperty ;\\r\\n    rdfs:label \\\"对应 OODA 阶段\\\"@zh ;\\r\\n    rdfs:comment \\\"类或术语的阶段标注；不是实例执行顺序，也不自动传播到实例。\\\"@zh .\\r\\n:unitSymbol a owl:AnnotationProperty ;\\r\\n    rdfs:label \\\"单位符号\\\"@zh ;\\r\\n    rdfs:comment \\\"描述数据属性的单位；不执行单位换算。1 表示无量纲。\\\"@zh .\\r\\n:semanticNote a owl:AnnotationProperty ;\\r\\n    rdfs:label \\\"建模口径说明\\\"@zh .\\r\\n:formulaText a owl:AnnotationProperty ;\\r\\n    rdfs:label \\\"公式文本\\\"@zh ;\\r\\n    rdfs:comment \\\"来源中的数学表达式的文本记录；不是 SWRL、SPARQL 或可执行代码。\\\"@zh .\\r\\n\\r\\n:OODAPhase a owl:Class ;\\r\\n    rdfs:label \\\"OODA 阶段\\\"@zh ;\\r\\n    :sourceSection \\\"第一部分 OODA 扩展说明\\\" ;\\r\\n    rdfs:comment \\\"用于文献阶段对照的词表。阶段循环与一次任务执行的依赖图分开表达。\\\"@zh .\\r\\n:ObservePhase a owl:NamedIndividual, :OODAPhase ;\\r\\n    rdfs:label \\\"O1 探知（Observe）\\\"@zh .\\r\\n:OrientPhase a owl:NamedIndividual, :OODAPhase ;\\r\\n    rdfs:label \\\"O2 研判（Orient）\\\"@zh .\\r\\n:DecidePhase a owl:NamedIndividual, :OODAPhase ;\\r\\n    rdfs:label \\\"D 决断（Decide）\\\"@zh .\\r\\n:ActPhase a owl:NamedIndividual, :OODAPhase ;\\r\\n    rdfs:label \\\"A 施法（Act）\\\"@zh .\\r\\n\\r\\n:ArcaneMission :sourceSection \\\"1.1 表 1；1.4 表 5\\\" .\\r\\n:ArcaneCapability :sourceSection \\\"1.1 表 1；1.3 表 4\\\" .\\r\\n:Artifact :sourceSection \\\"1.1 表 1；1.2 表 2、表 3\\\" ;\\r\\n    :semanticNote \\\"灵视探知、协调、具现是功能角色，可由同一实体兼任，不设为两两互斥；平台/挂载物是另一分类维度。\\\"@zh .\\r\\n:ElementalFieldSituation :sourceSection \\\"1.1 表 1\\\" ;\\r\\n    :semanticNote \\\"目前只表达态势与任务、能力和目标的关联，未提供元素种类、魔力场或环境数值模型。\\\"@zh .\\r\\n:InvocationRequirement :sourceSection \\\"1.1 表 1\\\" ;\\r\\n    :semanticNote \\\"需求关系的存在不代表已通过满足性判定；截图未定义结构化阈值字段，本轮不自行编造阈值。\\\"@zh .\\r\\n\\r\\n:InsightArtifact :sourceSection \\\"1.2 表 2、表 3\\\" ; :correspondsToPhase :ObservePhase .\\r\\n:JudgmentArtifact :sourceSection \\\"1.2 OODA 细分\\\" ; :correspondsToPhase :OrientPhase ;\\r\\n    rdfs:altLabel \\\"研判法器\\\"@zh .\\r\\n:DecisionArtifact :sourceSection \\\"1.2 OODA 细分\\\" ; :correspondsToPhase :DecidePhase .\\r\\n:ManifestationArtifact :sourceSection \\\"1.2 表 2、表 3\\\" ; :correspondsToPhase :ActPhase .\\r\\n:CoordinationArtifact :sourceSection \\\"1.2 表 2、表 3\\\" ;\\r\\n    :semanticNote \\\"协调层覆盖研判和决断两个阶段；父类本身不绑定单一阶段。\\\"@zh .\\r\\n\\r\\n:InsightCapability :sourceSection \\\"1.3 表 4\\\" ; :correspondsToPhase :ObservePhase .\\r\\n:JudgmentCapability :sourceSection \\\"1.3 OODA 细分\\\" ; :correspondsToPhase :OrientPhase ;\\r\\n    rdfs:altLabel \\\"研判能力\\\"@zh .\\r\\n:DecisionCapability :sourceSection \\\"1.3 OODA 细分\\\" ; :correspondsToPhase :DecidePhase .\\r\\n:ManifestationCapability :sourceSection \\\"1.3 表 4\\\" ; :correspondsToPhase :ActPhase .\\r\\n:CoordinationCapability :sourceSection \\\"1.3 表 4\\\" .\\r\\n:CommunicationCapability :sourceSection \\\"1.3 表 4\\\" .\\r\\n:OrchestrationCapability :sourceSection \\\"1.3 表 4\\\" .\\r\\n:EvaluationCapability :sourceSection \\\"1.3 表 4\\\" ;\\r\\n    :semanticNote \\\"解析能力按表 4 保留在协调能力下。与 JudgmentCapability 相关，但截图未给出等价或包含公理，故不自动合并。\\\"@zh .\\r\\n\\r\\n:InsightMission :sourceSection \\\"1.4\\\" ; :correspondsToPhase :ObservePhase .\\r\\n:JudgmentMission :sourceSection \\\"1.4\\\" ; :correspondsToPhase :OrientPhase ;\\r\\n    rdfs:altLabel \\\"研判任务\\\"@zh .\\r\\n:DecisionMission :sourceSection \\\"1.4\\\" ; :correspondsToPhase :DecidePhase .\\r\\n:ManifestationMission :sourceSection \\\"1.4\\\" ; :correspondsToPhase :ActPhase .\\r\\n:CoordinationMission :sourceSection \\\"1.4\\\" ;\\r\\n    :semanticNote \\\"0.7 将具体任务的后继关系从类的存在性限制中移出。类型表示任务职责，不强制每个任务都有后续具现任务。\\\"@zh .\\r\\n:finishStartPrecedes :sourceSection \\\"1.4 时序表达（项目扩展属性）\\\" ;\\r\\n    :semanticNote \\\"用于具体任务实例的完成—开始依赖。OODA 阶段循环不等于 nextNode 或依赖图必须成环；截图中引用的图 5 图形本轮未提供。\\\"@zh .\\r\\n\\r\\n:hasCapability :sourceSection \\\"1.1；2.1.1\\\" ;\\r\\n    :semanticNote \\\"表示法器具有某项能力，不自动推导其数值性能满足某个任务。\\\"@zh .\\r\\n:requiresCapability :sourceSection \\\"1.1；2.1.1\\\" ;\\r\\n    :semanticNote \\\"表示任务所需能力；声明该关系与由规则计算该关系是两个步骤。\\\"@zh .\\r\\n:ChainNode :sourceSection \\\"项目扩展：链内参与节点\\\" ;\\r\\n    :semanticNote \\\"同一法器参与不同链时，应分别建立节点，再通过 nodeArtifact 指向同一法器；避免共享节点导致顺序混淆。\\\"@zh .\\r\\n:SpellChain :sourceSection \\\"2.1 步骤 2（项目结构化扩展）\\\" .\\r\\n:ArcaneWeb :sourceSection \\\"2.1 步骤 3（项目结构化扩展）\\\" .\\r\\n:ChainRelation :sourceSection \\\"2.1.3（项目结构化扩展）\\\" .\\r\\n:ArtifactPlatform :sourceSection \\\"项目扩展：承载平台\\\" .\\r\\n:CrystalVessel :sourceSection \\\"项目扩展：可消耗挂载物\\\" .\\r\\n\\r\\n# 单位采用现有 IRI 的单位约定，不因魔法化显示名称而改变。\\r\\n:latitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:longitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:altitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:speedKn :unitSymbol \\\"kn\\\" .\\r\\n:detectionRangeNm :unitSymbol \\\"nmi\\\" .\\r\\n:distanceResolutionM :unitSymbol \\\"m\\\" .\\r\\n:azimuthCoverageDeg :unitSymbol \\\"deg\\\" .\\r\\n:elevationCoverageDeg :unitSymbol \\\"deg\\\" .\\r\\n:azimuthResolutionDeg :unitSymbol \\\"deg\\\" .\\r\\n:elevationResolutionDeg :unitSymbol \\\"deg\\\" .\\r\\n:insightIntervalS :unitSymbol \\\"s\\\" ;\\r\\n    :semanticNote \\\"采样或灵视探知间隔不自动等于式（4）的阶段总耗时。\\\"@zh .\\r\\n:evaluationTimeS :unitSymbol \\\"s\\\" .\\r\\n:evaluationAreaKm2 :unitSymbol \\\"km2\\\" .\\r\\n:communicationBandwidthMbps :unitSymbol \\\"Mbps\\\" .\\r\\n:communicationPowerW :unitSymbol \\\"W\\\" .\\r\\n:relayDelayMs :unitSymbol \\\"ms\\\" .\\r\\n:responseTimeS :unitSymbol \\\"s\\\" ;\\r\\n    :semanticNote \\\"响应时间是单项参数，不自动等于式（4）的完整施法阶段耗时。\\\"@zh .\\r\\n:manaRechargeTimeS :unitSymbol \\\"s\\\" .\\r\\n:minRangeNm :unitSymbol \\\"nmi\\\" .\\r\\n:maxRangeNm :unitSymbol \\\"nmi\\\" .\\r\\n:disturbanceRadiusM :unitSymbol \\\"m\\\" .\\r\\n:flightSpeedKn :unitSymbol \\\"kn\\\" .\\r\\n:climbSpeedKn :unitSymbol \\\"kn\\\" .\\r\\n:maxTargetSpeedKn :unitSymbol \\\"kn\\\" .\\r\\n:flightAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:minActivationAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:maxActivationAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:minTargetAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:maxTargetAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:maxCommDistanceNm :unitSymbol \\\"nmi\\\" .\\r\\n:missionTargetAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:missionTargetSpeedKn :unitSymbol \\\"kn\\\" .\\r\\n:missionTargetLatitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:missionTargetLongitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:targetAltitudeFt :unitSymbol \\\"ft\\\" .\\r\\n:targetSpeedKn :unitSymbol \\\"kn\\\" .\\r\\n:targetLatitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:targetLongitudeDeg :unitSymbol \\\"deg\\\" .\\r\\n:targetDistanceNm :unitSymbol \\\"nmi\\\" .\\r\\n:detectionPrecision :unitSymbol \\\"1\\\" ;\\r\\n    :semanticNote \\\"项目扩展的 0—1 汇总指标；表 3 的距离/角度误差不能未经定义就直接转换为此指标。标注本身不约束数值范围。\\\"@zh .\\r\\n:attunementProbability :unitSymbol \\\"1\\\" ;\\r\\n    :semanticNote \\\"灵性锁定概率与式（5）的阶段精度不是已声明的同一指标。\\\"@zh .\\r\\n:disturbanceRate :unitSymbol \\\"1\\\" .\\r\\n:cost :semanticNote \\\"使用成本。表 3 在具现法器行列出附魔造价，本项目将成本提升到法器父类以统一描述。币种和计价基准须由实例数据明确，不能默认是采购价。\\\"@zh .\\r\\n:missionTargetType :semanticNote \\\"来源类别编码与显示名称分开；背景化显示名不自动改变来源类别编码。\\\"@zh .\\r\\n:missionTime :semanticNote \\\"任务时间使用 xsd:dateTime；它是时间点，不是持续时间。\\\"@zh .\\r\\n:nodeOrder :semanticNote \\\"序号为整数不代表唯一、从 1 开始或连续；这些是实例数据校验要求。\\\"@zh .\\r\\n\\r\\n# 规则描述目录：只记录来源、类别和语义，不产生候选法器或链网。\\r\\n:DesignRuleDescription a owl:Class ; rdfs:label \\\"设计规则说明\\\"@zh .\\r\\n:TaskCapabilityRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;\\r\\n    rdfs:label \\\"任务—能力映射规则说明\\\"@zh ; :sourceSection \\\"2.1.1；式（1）\\\" ;\\r\\n    rdfs:comment \\\"描述任务属性条件与所需能力之间的条件关系；条件阈值未在截图中完整给出。\\\"@zh ;\\r\\n    :semanticNote \\\"用户于2026-10-27更正2.1.1示例的笔误：目标距离近时，需要近程具现能力；不采用原文的远程表述。近程的数值阈值仍须显式配置。可执行规则由独立design模块加载，本条注释本身不执行推理。\\\"@zh .\\r\\n:CapabilityArtifactRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;\\r\\n    rdfs:label \\\"能力—法器映射规则说明\\\"@zh ; :sourceSection \\\"2.1.1；式（2）\\\" ;\\r\\n    rdfs:comment \\\"描述能力需求与法器属性条件的映射；本目录不进行法器筛选。\\\"@zh .\\r\\n:ArtifactCooperationRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;\\r\\n    rdfs:label \\\"法器协同规则说明\\\"@zh ; :sourceSection \\\"2.1.2；式（3）\\\" ;\\r\\n    rdfs:comment \\\"描述协同条件的合取；成对条件成立不自动证明整条链有序、连通或不存在资源冲突。\\\"@zh .\\r\\n:ChainCooperationRuleDescription a owl:NamedIndividual, :DesignRuleDescription ;\\r\\n    rdfs:label \\\"法术链协同规则说明\\\"@zh ; :sourceSection \\\"2.1.3\\\" ;\\r\\n    rdfs:comment \\\"来源描述并行、串行、分支和资源共享。本体中的关系实例只记录组合，不自动验证容量、占用时间或消耗性资源约束。\\\"@zh .\\r\\n\\r\\n# 数学式文本目录：编号沿用截图；不给未出现的时间/精度分项补造定义。\\r\\n:FormulaDescription a owl:Class ; rdfs:label \\\"公式说明\\\"@zh .\\r\\n:Formula01 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（1）条件—能力表达\\\"@zh ; :sourceSection \\\"2.1.1；式（1）\\\" ;\\r\\n    :formulaText \\\"(t_i^1 AND t_i^2 AND ... AND t_i^n) -> c_i\\\" ;\\r\\n    :semanticNote \\\"按截图合取含义记录。截图中的交集符号用于条件同时成立；并非完整的一阶逻辑或可执行 OWL 规则语法。\\\"@zh .\\r\\n:Formula02 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（2）条件—资源表达\\\"@zh ; :sourceSection \\\"2.1.1；式（2）\\\" ;\\r\\n    :formulaText \\\"(c_i^1 AND c_i^2 AND ... AND c_i^n) -> w_i\\\" .\\r\\n:Formula03 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（3）协同条件表达\\\"@zh ; :sourceSection \\\"2.1.2；式（3）\\\" ;\\r\\n    :formulaText \\\"(w_ij^1 AND w_ij^2 AND ... AND w_ij^n) -> l_k\\\" ;\\r\\n    :semanticNote \\\"截图写法省略了整条链的参与者量化和全局条件；不能把任意一对资源满足条件等同于链构造完成。\\\"@zh .\\r\\n:Formula04 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（4）总时间\\\"@zh ; :sourceSection \\\"评估指标；式（4）\\\" ;\\r\\n    :formulaText \\\"T = T_o + T_d + T_a\\\" ;\\r\\n    :semanticNote \\\"三个阶段耗时相加；来源暂不考虑传讯类法器。只在阶段不重叠且计量口径一致时按该式解释。\\\"@zh .\\r\\n:Formula05 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（5）总精度\\\"@zh ; :sourceSection \\\"评估指标；式（5）\\\" ;\\r\\n    :formulaText \\\"A = A_o * A_d * A_a\\\" ;\\r\\n    :semanticNote \\\"来源采用阶段精度乘积。阶段指标的标度、获取方式和合成适用性须另行定义，不能自动解释为经过验证的联合概率。\\\"@zh .\\r\\n:Formula06 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（6）总成本\\\"@zh ; :sourceSection \\\"评估指标；式（6）\\\" ;\\r\\n    :formulaText \\\"C = C_o + C_d + C_a\\\" ;\\r\\n    :semanticNote \\\"按一致币种和使用成本口径求和；多条链共享资源时，截图没有给出网络级成本去重规则。\\\"@zh .\\r\\n:Formula07 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（7）时间归一化\\\"@zh ; :sourceSection \\\"评估指标；式（7）\\\" ;\\r\\n    :formulaText \\\"T_prime = 1 - (T - min(T)) / (max(T) - min(T))\\\" .\\r\\n:Formula08 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（8）精度归一化\\\"@zh ; :sourceSection \\\"评估指标；式（8）\\\" ;\\r\\n    :formulaText \\\"A_prime = (A - min(A)) / (max(A) - min(A))\\\" .\\r\\n:Formula09 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（9）成本归一化\\\"@zh ; :sourceSection \\\"评估指标；式（9）\\\" ;\\r\\n    :formulaText \\\"C_prime = 1 - (C - min(C)) / (max(C) - min(C))\\\" .\\r\\n:Formula10 a owl:NamedIndividual, :FormulaDescription ;\\r\\n    rdfs:label \\\"式（10）加权评分\\\"@zh ; :sourceSection \\\"评估指标；式（10）\\\" ;\\r\\n    :formulaText \\\"P = w_1 * T_prime + w_2 * A_prime + w_3 * C_prime\\\" ;\\r\\n    :semanticNote \\\"来源要求每个权重属于 [0,1] 且权重和为 1；三个归一化值须使用同一比较集合。截图未规定 max=min 时的处理，本体不自行设定得分。\\\"@zh .\\r\\n\\r\\n# 截图逐项来源补充（0.8.1）：仅添加注释，不增加规则或场景。\\r\\n:artifactId :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:artifactCategory :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:artifactName :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:artifactShortName :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:longitudeDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:latitudeDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:altitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:speedKn :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:artifactStatus :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:insightTargetType :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:detectionRangeNm :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:azimuthCoverageDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:elevationCoverageDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxInsightMarks :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:distanceResolutionM :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:azimuthResolutionDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:elevationResolutionDeg :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:insightIntervalS :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:evaluationTimeS :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxEvaluationTargets :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:evaluationAreaKm2 :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:communicationBandwidthMbps :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:communicationPowerW :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:relayDelayMs :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:manifestationTargetType :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxRangeNm :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:minRangeNm :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:manifestationPotency :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:disturbanceRadiusM :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:responseTimeS :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:multiCastCount :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:manaRechargeTimeS :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxTargetSpeedKn :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:flightSpeedKn :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:climbSpeedKn :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:minTargetAltitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxTargetAltitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:minActivationAltitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:maxActivationAltitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:flightAltitudeFt :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:attunementProbability :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:disturbanceRate :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:cost :sourceSection \\\"1.2 表 3；截图 20261023222313\\\" .\\r\\n:missionName :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionShortName :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionCode :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionType :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionLocation :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTime :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionMetrics :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetType :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetSpeedKn :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetAltitudeFt :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetLongitudeDeg :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetLatitudeDeg :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:missionTargetImpedanceThreshold :sourceSection \\\"1.4 表 5；截图 20261023222331\\\" .\\r\\n:ManifestationRangeCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：具现距离。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:ManifestationAltitudeCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：具现高度。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:ManifestationTargetTypeCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：目标类型。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:ManifestationTargetQuantityCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：目标数量。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:CommunicationCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：传讯能力。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:OrchestrationCapability :sourceSection \\\"1.3 表 4；截图 20261023222320\\\" ; :semanticNote \\\"表 4 分类维度：统筹能力。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:EvaluationCapability :sourceSection \\\"1.3 表 4；截图 20261023222326\\\" ; :semanticNote \\\"表 4 分类维度：解析能力。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:InsightRangeCapability :sourceSection \\\"1.3 表 4；截图 20261023222326\\\" ; :semanticNote \\\"表 4 分类维度：感知距离。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:InsightTargetTypeCapability :sourceSection \\\"1.3 表 4；截图 20261023222326\\\" ; :semanticNote \\\"表 4 分类维度：目标类型。当前以能力类别及具名分类词项表达，不由类别名称推导数值阈值。\\\"@zh .\\r\\n:InsightArtifact rdfs:comment \\\"表示灵视探知监视类单元平台，承担发现、搜集共鸣空间信息参数并回传的任务。\\\"@zh .\\r\\n:CoordinationArtifact rdfs:comment \\\"表示各类协调机构，是奥术网的核心，对魔法活动执行决断。\\\"@zh .\\r\\n:ManifestationArtifact rdfs:comment \\\"表示可执行魔法抵消和魔力消解任务的功能单元，在协调节点的协调安排和灵视探知节点的信息传输下，对交互目标进行扰动或具现。\\\"@zh .\\r\\n:FormulaDescription :semanticNote \\\"本批截图只提供式（1）至式（10），未定义 SE、α/β 或状态更新方程；这些不列入本批资料的实现范围。\\\"@zh .\\r\\n\\r\\n###  Initial serialization generated by the OWL API; subsequent edits maintained in this project.\\r\\n\\r\\n# Project extension: ordered mission steps, not simultaneous coalitions.\\r\\n:SequentialStepMission a owl:Class ; rdfs:subClassOf :ArcaneMission ;\\r\\n    rdfs:label \\\"顺序任务环节\\\"@zh ;\\r\\n    rdfs:comment \\\"在探知、协调、具现主线上按配置建立顺序环节，同一角色可重复出现；每个环节分配一个执行实例，不强制评估，不声明联合效果公式。\\\"@zh .\\r\\n:hasSequentialStep a owl:ObjectProperty ;\\r\\n    rdfs:label \\\"包含顺序任务环节\\\"@zh ; rdfs:domain :ArcaneMission ; rdfs:range :SequentialStepMission .\\r\\n:stepActivity a owl:DatatypeProperty ;\\r\\n    rdfs:label \\\"环节活动\\\"@zh ; rdfs:domain :SequentialStepMission ; rdfs:range xsd:string .\\r\\n:stepIndex a owl:DatatypeProperty ;\\r\\n    rdfs:label \\\"模板内环节次序\\\"@zh ; rdfs:domain :SequentialStepMission ; rdfs:range xsd:integer .\\r\\n:stepTarget a owl:ObjectProperty ;\\r\\n    rdfs:label \\\"顺序环节目标\\\"@zh ; rdfs:domain :SequentialStepMission ; rdfs:range :Target ;\\r\\n    rdfs:comment \\\"独立于整体任务hasTarget，避免把整体任务的全部角色能力要求施加到每一个环节。\\\"@zh .\\r\\n\\r\\n# 2026-10-27 显示名迁移：尺=原英尺(ft)，里=原海里(nmi)，迅捷度=原节(kn)。\\r\\n# 仅更换显示名，不改数值、换算、参照面、原始类型编码或OWL公理。\\r\\n# 共鸣效值沿用manifestationPotency；传音频段沿用带宽Mbps口径，不改成频率；飞行极速沿用原速度测量口径，不新增最大值约束。\\r\\n\"}, {\"path\": \"knowledge/rift-multistep.ttl\", \"sha256\": \"b543f88bde2d7c32b0c5b27a0ff676a80801f79c6fe0263cabff1ac217088d09\", \"encoding\": \"utf-8\", \"content\": \"@prefix r: <urn:arcane-rift-demo:> .\\r\\n\\r\\n@prefix b: <http://example.org/arcaneweb#> .\\r\\n\\r\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\r\\n\\r\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\r\\n\\r\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\r\\n\\r\\nr:Ontology a owl:Ontology ; owl:versionInfo \\\"1.0\\\" ; rdfs:label \\\"迷雾裂隙稳定实验\\\"@zh .\\r\\n\\r\\nr:WideSurvey a owl:NamedIndividual, b:InsightCapability ; rdfs:label \\\"广域探知\\\"@zh .\\r\\n\\r\\nr:SurveyUnit a owl:Class ; rdfs:label \\\"广域探知法器类\\\"@zh ; rdfs:subClassOf b:InsightArtifact,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:hasCapability ; owl:hasValue r:WideSurvey ] .\\r\\n\\r\\nr:WideSurveyStep a owl:Class ; rdfs:label \\\"广域探知环节类\\\"@zh ; rdfs:subClassOf b:SequentialStepMission,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:requiresCapability ; owl:hasValue r:WideSurvey ] .\\r\\n\\r\\nr:FineScan a owl:NamedIndividual, b:InsightCapability ; rdfs:label \\\"精细复核\\\"@zh .\\r\\n\\r\\nr:ReviewUnit a owl:Class ; rdfs:label \\\"精细复核法器类\\\"@zh ; rdfs:subClassOf b:InsightArtifact,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:hasCapability ; owl:hasValue r:FineScan ] .\\r\\n\\r\\nr:FineScanStep a owl:Class ; rdfs:label \\\"精细复核环节类\\\"@zh ; rdfs:subClassOf b:SequentialStepMission,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:requiresCapability ; owl:hasValue r:FineScan ] .\\r\\n\\r\\nr:ResonanceAnalysis a owl:NamedIndividual, b:CoordinationCapability ; rdfs:label \\\"共振解析\\\"@zh .\\r\\n\\r\\nr:AnalysisUnit a owl:Class ; rdfs:label \\\"共振解析法器类\\\"@zh ; rdfs:subClassOf b:CoordinationArtifact,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:hasCapability ; owl:hasValue r:ResonanceAnalysis ] .\\r\\n\\r\\nr:ResonanceAnalysisStep a owl:Class ; rdfs:label \\\"共振解析环节类\\\"@zh ; rdfs:subClassOf b:SequentialStepMission,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:requiresCapability ; owl:hasValue r:ResonanceAnalysis ] .\\r\\n\\r\\nr:Dispatch a owl:NamedIndividual, b:CoordinationCapability ; rdfs:label \\\"稳定术协调\\\"@zh .\\r\\n\\r\\nr:DispatchUnit a owl:Class ; rdfs:label \\\"稳定术协调法器类\\\"@zh ; rdfs:subClassOf b:CoordinationArtifact,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:hasCapability ; owl:hasValue r:Dispatch ] .\\r\\n\\r\\nr:DispatchStep a owl:Class ; rdfs:label \\\"稳定术协调环节类\\\"@zh ; rdfs:subClassOf b:SequentialStepMission,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:requiresCapability ; owl:hasValue r:Dispatch ] .\\r\\n\\r\\nr:Stabilize a owl:NamedIndividual, b:ManifestationCapability ; rdfs:label \\\"裂隙稳定\\\"@zh .\\r\\n\\r\\nr:StabilizerUnit a owl:Class ; rdfs:label \\\"裂隙稳定法器类\\\"@zh ; rdfs:subClassOf b:ManifestationArtifact,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:hasCapability ; owl:hasValue r:Stabilize ] .\\r\\n\\r\\nr:StabilizeStep a owl:Class ; rdfs:label \\\"裂隙稳定环节类\\\"@zh ; rdfs:subClassOf b:SequentialStepMission,\\r\\n\\r\\n  [ a owl:Restriction ; owl:onProperty b:requiresCapability ; owl:hasValue r:Stabilize ] .\\r\\n\\r\\nr:Target1 a owl:Class ; rdfs:label \\\"普通裂隙目标类\\\"@zh ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (\\r\\n\\r\\n b:Target [ a owl:Restriction ; owl:onProperty b:targetType ; owl:hasValue \\\"普通裂隙\\\"