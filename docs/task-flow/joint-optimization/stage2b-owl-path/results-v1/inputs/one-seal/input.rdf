  <rdf:Description rdf:about="http://example.org/arcaneweb#insightIntervalS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <b:sourceSection>1.2 表 3；截图 20261023222313</b:sourceSection>
