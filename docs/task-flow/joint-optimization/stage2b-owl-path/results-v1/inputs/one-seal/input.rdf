    <rdf:type rdf:resource="http://example.org/arcaneweb#FormulaDescription"/>
    <b:sourceSection>2.1.1；式（1）</b:sourceSection>
    <b:semanticNote xml:lang="zh">按截图合取含义记录。截图中的交集符号用于条件同时成立；并非完整的一阶逻辑或可执行 OWL 规则语法。</b:semanticNote>
    <b:formulaText>(t_i^1 AND t_i^2 AND ... AND t_i^n) -&gt; c_i</b:formulaText>
    <rdfs:label xml:lang="zh">式（1）条件—能力表达</rdfs:label>
  </rdf:Description>
