  <rdf:Description rdf:about="http://example.org/arcaneweb#ManifestationPlatform">
    <rdfs:subClassOf rdf:resource="http://example.org/arcaneweb#ManifestationArtifact"/>
    <rdfs:subClassOf rdf:resource="http://example.org/arcaneweb#ArtifactPlatform"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">具现平台</rdfs:label>
    <rdfs:comment xml:lang="zh">扩展子类：御风灵舟、守护法阵、浮空艇等可释放或投掷魔晶载体的平台。平台归入具现法器是论文的建模方式；魔晶载体是消耗性挂载。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/arcaneweb#Artifact">
    <b:sourceSection>1.1 表 1；1.2 表 2、表 3</b:sourceSection>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="zh">为遂行一定的行动任务、具有一定魔法功能的法器系统，是奥术网的最小组成功能要素。</rdfs:comment>
    <rdfs:label xml:lang="zh">法器</rdfs:label>
    <b:semanticNote xml:lang="zh">灵视探知、协调、具现是功能角色，可由同一实体兼任，不设为两两互斥；平台/挂载物是另一分类维度。</b:semanticNote>
  </rdf:Description>
