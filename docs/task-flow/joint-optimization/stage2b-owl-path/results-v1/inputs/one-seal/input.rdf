    <rdfs:comment xml:lang="zh">1.6/2.x 扩展：由交互目标、灵视探知、协调、具现节点构成的闭合施法链路。第 6 节的 someValuesFrom 公理只要求存在相应角色节点和目标，不校验节点顺序、连通性、闭环和资源冲突。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nc87e294b1d3b4c1b9725d74970c26482b11"/>
    <rdfs:subClassOf rdf:nodeID="nc87e294b1d3b4c1b9725d74970c26482b10"/>
    <rdfs:subClassOf rdf:nodeID="nc87e294b1d3b4c1b9725d74970c26482b12"/>
    <rdfs:subClassOf rdf:nodeID="nc87e294b1d3b4c1b9725d74970c26482b9"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <b:sourceSection>2.1 步骤 2（项目结构化扩展）</b:sourceSection>
    <rdfs:label xml:lang="zh">法术链</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/arcaneweb#CrystalVessel">
    <rdfs:label xml:lang="zh">魔晶载体</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/arcaneweb#ManifestationArtifact"/>
    <b:sourceSection>项目扩展：可消耗挂载物</b:sourceSection>
    <rdfs:comment xml:lang="zh">扩展类：魔晶载体、辉光载体等一次性或可消耗的具现挂载。魔晶载体可以通过 mountedOn 关联承载平台，但本类不强制所有实例都已挂载。</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/arcaneweb#satisfiesRequirement">
