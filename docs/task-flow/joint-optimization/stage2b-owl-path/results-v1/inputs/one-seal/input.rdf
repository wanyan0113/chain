  <rdf:Description rdf:about="http://example.org/arcaneweb#Formula07">
    <rdfs:label xml:lang="zh">式（7）时间归一化</rdfs:label>
    <rdf:type rdf:resource="http://example.org/arcaneweb#FormulaDescription"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <b:formulaText>T_prime = 1 - (T - min(T)) / (max(T) - min(T))</b:formulaText>
    <b:sourceSection>评估指标；式（7）</b:sourceSection>
  </rdf:Description>
