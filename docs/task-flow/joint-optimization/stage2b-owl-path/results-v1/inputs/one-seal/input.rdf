  <rdf:Description rdf:about="http://example.org/arcaneweb#detectionPrecision">
    <b:semanticNote xml:lang="zh">项目扩展的 0—1 汇总指标；表 3 的距离/角度误差不能未经定义就直接转换为此指标。标注本身不约束数值范围。</b:semanticNote>
    <b:unitSymbol>1</b:unitSymbol>
    <rdfs:domain rdf:resource="http://example.org/arcaneweb#InsightArtifact"/>
    <rdfs:label xml:lang="zh">灵视探知精度（0-1）</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="zh">论文表 3 的灵视探知精度由距离/方位/俯仰感知误差表示；本属性是便于比较的汇总值（扩展）。</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/arcaneweb#hasSubMission">
    <rdfs:comment xml:lang="zh">扩展：行动任务分解关系。</rdfs:comment>
    <rdfs:label xml:lang="zh">包含子任务</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/arcaneweb#ArcaneMission"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/arcaneweb#ArcaneMission"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/arcaneweb#Formula10">
    <rdfs:label xml:lang="zh">式（10）加权评分</rdfs:label>
    <b:semanticNote xml:lang="zh">来源要求每个权重属于 [0,1] 且权重和为 1；三个归一化值须使用同一比较集合。截图未规定 max=min 时的处理，本体不自行设定得分。</b:semanticNote>
    <rdf:type rdf:resource="http://example.org/arcaneweb#FormulaDescription"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <b:formulaText>P = w_1 * T_prime + w_2 * A_prime + w_3 * C_prime</b:formulaText>
    <b:sourceSection>评估指标；式（10）</b:sourceSection>
  </rdf:Description>
