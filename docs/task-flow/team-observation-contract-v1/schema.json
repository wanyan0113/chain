        "execution_input_reference": {
          "type": "string",
          "minLength": 1
        },
        "reset_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_stage_instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "registered_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "stage_attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "candidate_id",
        "stage_instance_id",
        "attempt_id",
        "registered_at",
        "started_at",
        "ended_at",
        "execution_status",
        "reason",
        "reason_detail"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1
        },
        "registered_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "execution_status": {
          "enum": [
            "planned",
            "not_reached",
            "not_executed",
            "failed",
            "completed"
          ]
        },
        "reason": {
          "enum": [
            null,
            "not_reached",
            "planned_not_executed",
            "execution_failure",
            "output_lost",
            "truth_missing",
            "cannot_evaluate"
          ]
        },
        "reason_detail": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "enum": [
                  "not_reached",
                  "not_executed",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "not_reached",
                  "planned_not_executed",
                  "execution_failure",
                  "output_lost",
                  "truth_missing",
                  "cannot_evaluate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_status": {
                "enum": [
                  "failed",
                  "completed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "ended_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
