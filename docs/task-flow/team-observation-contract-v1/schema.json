        "observation_status": {
          "enum": [
            "recorded",
            "missing"
          ]
        },
        "reference_status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "missing_reason": {
          "enum": [
            null,
            "not_reached",
            "planned_not_executed",
            "execution_failure",
            "output_lost",
            "truth_missing",
            "cannot_evaluate"
          ]
        },
        "missing_reason_detail": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "input_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "input_group_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "actual_label": {
                "type": "string",
                "minLength": 1
              },
              "output_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "reference_label": {
                "type": "string",
                "minLength": 1
              },
              "independent_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "actual_label": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "reference_label": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "recorded"
              },
              "reference_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "missing_reason": {
                "enum": [
                  "not_reached",
                  "planned_not_executed",
                  "execution_failure",
                  "output_lost",
                  "truth_missing",
                  "cannot_evaluate"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observation_status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_version": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "const": "UNASSIGNED"
                }
              }
            }
          }
        }
      ]
    },
