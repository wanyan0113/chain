{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:team-observation-contract:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "study_id",
    "protocol_revision_hash",
    "data_origin",
    "samples",
    "executions",
    "stage_attempts",
    "member_observations",
    "group_outputs",
    "task_endpoints"
  ],
  "properties": {
    "contract_version": {
      "const": "team-observation-contract-1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_revision_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_origin": {
      "enum": [
        "uncollected",
        "synthetic_simulation",
        "real_observational"
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/samples"
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executions"
      }
    },
    "stage_attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage_attempts"
      }
    },
    "member_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member_observations"
      }
    },
    "group_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group_outputs"
      }
    },
    "task_endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_endpoints"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_origin": {
            "const": "uncollected"
          }
        }
      },
      "then": {
        "properties": {
          "samples": {
            "maxItems": 0
          },
          "executions": {
            "maxItems": 0
          },
          "stage_attempts": {
            "maxItems": 0
          },
          "member_observations": {
            "maxItems": 0
          },
          "group_outputs": {
            "maxItems": 0
          },
          "task_endpoints": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "study_id": {
            "not": {
              "const": "UNASSIGNED"
            }
          },
          "protocol_revision_hash": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "pair_id",
        "task_id",
        "population",
        "cluster_id",
        "split",
        "stratum",
        "eligible",
        "exclusion_reason",
        "baseline_input_reference",
        "registered_at"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "calibration",
            "evaluation"
          ]
        },
        "stratum": {
          "type": "string",
          "minLength": 1
        },
        "eligible": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "baseline_input_reference": {
          "type": "string",
          "minLength": 1
        },
        "registered_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "exclusion_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "exclusion_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "executions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "sample_id",
        "arm_id",
        "task_id",
        "source_report_id",
        "candidate_id",
        "environment_reference",
        "environment_stratum",
        "assigned_order",
        "execution_repeat_id",
        "actual_order",
        "order_deviation_reason",
        "execution_input_reference",
        "reset_reference",
        "expected_stage_instance_ids",
        "registered_at",
        "started_at",
        "ended_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "source_report_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_reference": {
          "type": "string",
          "minLength": 1
        },
        "environment_stratum": {
          "type": "string",
          "minLength": 1
        },
        "assigned_order": {
          "type": "integer",
          "minimum": 1
        },
        "execution_repeat_id": {
          "type": "integer",
          "minimum": 1
        },
        "actual_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "order_deviation_reason": {
          "type": [
            "string",
